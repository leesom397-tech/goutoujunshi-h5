{
  "id": "/",
  "name": "成子关系决策智能体",
  "short_name": "成子",
  "description": "截图快判、逐句分析和关系档案",
  "start_url": "/workspace",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fffaf5",
  "theme_color": "#fffaf5",
  "icons": [
    {"src":"/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"}
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files":[{"name":"image","accept":["image/png","image/jpeg"]}]}
  }
}

