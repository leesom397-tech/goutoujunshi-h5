@import "../../components/analysis-status.wxss";
@import "../../components/disclosure.wxss";

.screen { min-height: 100vh; box-sizing: border-box; padding: 32rpx 32rpx 88rpx; background: #f0f8fc; color: #203249; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; overflow-wrap: break-word; }
.hero { position: relative; padding: 24rpx 66rpx 36rpx 0; border-bottom: 1rpx solid #cddfea; }
.hero-icon { position: absolute; top: 26rpx; right: 0; width: 42rpx; height: 42rpx; opacity: .65; }
.eyebrow, .step { display: block; color: #176b89; font-size: 24rpx; font-weight: 650; letter-spacing: 1rpx; }
.title { display: block; margin-top: 18rpx; max-width: 580rpx; font-size: 44rpx; line-height: 1.45; font-weight: 750; letter-spacing: 1rpx; }
.sub { display: block; margin-top: 14rpx; color: #176b89; font-size: 25rpx; line-height: 1.6; }
.panel { margin-top: 28rpx; padding: 30rpx 28rpx; border: 0; border-radius: 20rpx; background: #ffffff; }
.center { color: #176b89; font-size: 25rpx; }
.panel-title { display: block; margin: 12rpx 0 26rpx; font-size: 34rpx; font-weight: 700; line-height: 1.45; }
.helper, .hint, .rank-note, .reply-note, .reply-original, .elapsed { display: block; color: #176b89; font-size: 24rpx; line-height: 1.65; }
.helper { margin: 15rpx 0; }
.hint { margin-top: 7rpx; font-size: 24rpx; font-weight: 400; }
.picker { display: flex; align-items: center; gap: 22rpx; width: 100%; box-sizing: border-box; margin: 0; padding: 30rpx 24rpx; border: 1rpx solid #8db9ce; border-radius: 16rpx; background: #f0f8fc; text-align: left; line-height: 1.5; color: #203249; }
.picker::after, .primary::after, .secondary::after, .reset::after, .reply-copy::after, .reply-more::after, .new-person-link::after { border: 0; }
.picker image { flex: none; width: 78rpx; height: 78rpx; border-radius: 7rpx; }
.picker .picker-icon { width: 46rpx; height: 46rpx; }
.picker-copy { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 700; }
.related-entry { font-size: 24rpx; }
.upload-section { margin-top: 28rpx; padding-top: 26rpx; border-top: 1rpx solid #cddfea; }
.field { margin-top: 19rpx; }
.field-label, .archive-choice-title, .new-person-title { display: block; font-size: 27rpx; font-weight: 650; }
.select { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; margin-top: 13rpx; min-height: 88rpx; box-sizing: border-box; padding: 19rpx; border: 1rpx solid #cddfea; border-radius: 9rpx; background: #ffffff; color: #203249; font-size: 26rpx; line-height: 1.5; }
.select-action { flex: none; color: #176b89; font-size: 24rpx; font-weight: 400; }
.archive-choice { padding-top: 8rpx; }
.archive-choice-optional { margin-left: 8rpx; font-size: 24rpx; font-weight: 400; color: #176b89; }
.archive-choice-hint { display: block; margin-top: 9rpx; color: #176b89; font-size: 24rpx; line-height: 1.6; }
.new-person-link, .reset { display: flex; align-items: center; justify-content: flex-start; margin: 5rpx 0 0; min-height: 88rpx; padding: 12rpx 0; box-sizing: border-box; background: transparent; color: #176b89; text-align: left; font-size: 25rpx; line-height: 1.5; }
.new-person { margin-top: 14rpx; padding: 22rpx; border: 1rpx solid #cddfea; border-radius: 9rpx; background: #f0f8fc; }
.new-person input { margin-top: 16rpx; padding: 20rpx 16rpx; border: 1rpx solid #cddfea; border-radius: 7rpx; background: #ffffff; font-size: 26rpx; }
.consent { display: flex; align-items: flex-start; gap: 10rpx; margin: 22rpx 0; color: #176b89; font-size: 24rpx; line-height: 1.7; }
.consent checkbox { flex: none; transform: scale(.85); transform-origin: top left; }
.privacy-summary { display: block; margin-top: 18rpx; color: #176b89; font-size: 24rpx; line-height: 1.65; }
.privacy-details { display: flex; flex-direction: column; gap: 16rpx; padding: 20rpx; border-radius: 8rpx; background: #f0f8fc; color: #176b89; font-size: 24rpx; line-height: 1.7; }
.primary, .secondary { display: flex; align-items: center; justify-content: center; margin-top: 20rpx; min-height: 92rpx; box-sizing: border-box; padding: 18rpx; border-radius: 10rpx; background: #203249; color: #ffffff; font-size: 27rpx; font-weight: 650; line-height: 1.5; }
.secondary { border: 1rpx solid #cddfea; background: #f0f8fc; color: #203249; font-size: 25rpx; }
.primary[disabled], .reply-more[disabled], .new-person-link[disabled] { opacity: .55; }
.error, .reply-error { display: block; margin-top: 15rpx; padding: 15rpx 18rpx; border-radius: 8rpx; background: #f0f8fc; color: #176b89; font-size: 24rpx; line-height: 1.65; }
.cost-note { display: block; padding: 14rpx 17rpx; border-left: 4rpx solid #62758a; background: #f0f8fc; color: #203249; font-size: 24rpx; line-height: 1.6; }
.ordered-image { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; padding: 10rpx; border: 1rpx solid #cddfea; border-radius: 9rpx; background: #ffffff; }
.ordered-image image { flex: none; width: 64rpx; height: 78rpx; border-radius: 5rpx; }
.ordered-image text { flex: 1; min-width: 0; color: #176b89; font-size: 24rpx; line-height: 1.5; }
.ordered-image button { flex: none; display: flex; align-items: center; margin: 0; padding: 12rpx; min-height: 88rpx; box-sizing: border-box; border-radius: 7rpx; background: #f0f8fc; color: #203249; font-size: 24rpx; line-height: 1.5; }
.ordered-image button::after { border: 0; }
.ordered-image button[disabled] { opacity: .35; }
.report-shortcuts { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap; gap: 10rpx; margin: 0; padding: 18rpx 0; background: #f0f8fc; border-bottom: 1rpx solid #cddfea; }
.report-shortcuts button { display: flex; flex: 1 0 20%; justify-content: center; align-items: center; min-height: 44px; min-width: 0; box-sizing: border-box; margin: 0; padding: 12rpx 8rpx; border: 1rpx solid #cddfea; border-radius: 12rpx; background: #ffffff; color: #203249; font-size: 24rpx; line-height: 1.4; }
.report-shortcuts button::after { border: 0; }
.verdict { display: flex; flex-direction: column; gap: 20rpx; font-size: 26rpx; line-height: 1.8; }
.verdict-block { display: flex; flex-direction: column; gap: 12rpx; padding: 24rpx; border: 0; border-radius: 14rpx; background: #f0f8fc; }
.verdict-label { display: block; color: #176b89; font-size: 24rpx; font-weight: 650; }
.judgment, .advice { color: #203249; font-size: 29rpx; font-weight: 650; line-height: 1.65; }
.intent-highlight { background: #f0f8fc; border-left: 3rpx solid #62758a; }
.verdict-evidence { border-color: #cddfea; background: #f0f8fc; }
.evidence { color: #176b89; }
.verdict-action { border-color: #62758a; background: #f0f8fc; }
.elapsed { margin-top: 19rpx; font-size: 24rpx; }
.reply, .line { display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; padding: 28rpx; border: 0; border-radius: 18rpx; background: #ffffff; }
.reply-heading, .who { color: #203249; font-size: 24rpx; font-weight: 650; }
.reply-text { color: #203249; font-size: 32rpx; line-height: 1.8; font-weight: 600; word-break: break-word; }
.reply-reason, .reply-details { color: #176b89; font-size: 24rpx; line-height: 1.7; }
.reply-details { padding: 16rpx; border-radius: 7rpx; background: #f0f8fc; }
.reply-copy { display: flex; align-items: center; justify-content: center; align-self: flex-start; min-width: 200rpx; min-height: 88rpx; box-sizing: border-box; margin: 4rpx 0; padding: 15rpx 28rpx; border-radius: 8rpx; background: #203249; color: #ffffff; font-size: 26rpx; font-weight: 650; line-height: 1.4; }
.reply-more { align-self: flex-start; display: flex; align-items: center; margin: 0; min-height: 88rpx; box-sizing: border-box; padding: 14rpx 23rpx; border: 1rpx solid #cddfea; border-radius: 8rpx; background: #ffffff; color: #176b89; font-size: 25rpx; line-height: 1.4; }
.reply-note, .reply-original { font-size: 24rpx; }
.reply-empty { display: block; color: #176b89; font-size: 26rpx; line-height: 1.75; }
.review { display: flex; flex-direction: column; gap: 13rpx; margin-top: 24rpx; padding: 23rpx; border-top: 2rpx solid #62758a; background: #f0f8fc; color: #176b89; font-size: 25rpx; line-height: 1.7; }
.review text:first-child, .section-title { display: block; color: #203249; font-size: 27rpx; font-weight: 650; line-height: 1.6; }
.lines { margin-top: 6rpx; }
.quote { display: block; box-sizing: border-box; max-width: 100%; padding: 22rpx 24rpx; border-radius: 4rpx 18rpx 18rpx; background: #ffffff; color: #203249; font-size: 29rpx; font-weight: 500; line-height: 1.8; word-break: break-word; }
.affection-card { padding: 26rpx; border: 0; border-radius: 16rpx; background: #f0f8fc; }
.affection-scope, .affection-note { display: block; color: #176b89; font-size: 24rpx; line-height: 1.7; }
.affection-score { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10rpx; margin: 14rpx 0 20rpx; color: #203249; font-size: 54rpx; font-weight: 700; line-height: 1.4; }
.affection-unit { font-size: 25rpx; font-weight: 400; }
.score-track { height: 13rpx; overflow: hidden; border-radius: 8rpx; background: #cddfea; }
.score-fill { height: 100%; background: #62758a; }
.affection-trend { display: block; margin: 20rpx 0 8rpx; color: #203249; font-size: 27rpx; font-weight: 650; }
.affection-note { margin-top: 10rpx; }
.affection-boundary { display: block; margin-top: 16rpx; padding: 14rpx; border-radius: 7rpx; background: #f0f8fc; color: #176b89; font-size: 25rpx; line-height: 1.65; }
.relationship-metrics { margin-top: 26rpx; }
.metric-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 13rpx; margin-top: 17rpx; }
.metric-grid > view { min-width: 0; padding: 20rpx; border: 0; border-radius: 12rpx; background: #f0f8fc; color: #176b89; font-size: 24rpx; line-height: 1.65; }
.metric-value { display: block; margin: 6rpx 0; color: #203249; font-size: 26rpx; font-weight: 650; }
.metric-callout { display: block; margin-top: 16rpx; padding: 17rpx; border-radius: 8rpx; font-size: 24rpx; line-height: 1.7; }
.metric-callout.red { background: #f0f8fc; color: #176b89; }
.metric-callout.green { background: #f0f8fc; color: #176b89; }
.metric-stop, .metric-issues { display: block; margin-top: 17rpx; color: #176b89; font-size: 24rpx; line-height: 1.7; }
.metric-issues text { display: block; margin-top: 6rpx; }
.report-actions { margin-top: 25rpx; }
.followup-button { display: flex; align-items: center; justify-content: center; min-height: 92rpx; box-sizing: border-box; margin: 24rpx 0 0; padding: 18rpx; border-radius: 10rpx; background: #203249; color: #ffffff; font-size: 27rpx; font-weight: 650; line-height: 1.5; }
.followup-button::after { border: 0; }
.followup-button[disabled] { opacity: .55; }
.followup-note { display: block; margin-top: 12rpx; color: #176b89; font-size: 24rpx; line-height: 1.6; }
.report-actions .reset { justify-content: center; }
.disclosure-button { width: 100%; min-height: 88rpx; box-sizing: border-box; margin: 0; border-color: #cddfea; border-radius: 8rpx; background: #f0f8fc; color: #176b89; font-size: 24rpx; line-height: 1.6; }
.disclosure-button:active { background: #f0f8fc; }
.disclosure-chevron { border-color: #62758a; }
button:active { opacity: .78; }
.affection-highlight { margin-top: 28rpx; padding: 28rpx; border-radius: 20rpx; background: #203249; color: #ffffff; }
.affection-highlight-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10rpx; }
.affection-highlight-title { font-size: 30rpx; font-weight: 650; line-height: 1.5; }
.affection-highlight-scope { color: #176b89; font-size: 24rpx; line-height: 1.5; }
.affection-highlight-score { display: flex; align-items: baseline; gap: 12rpx; margin: 12rpx 0; font-size: 84rpx; font-weight: 700; line-height: 1.15; }
.affection-highlight-unit { color: #176b89; font-size: 28rpx; font-weight: 400; }
.affection-highlight-trend { display: block; margin-top: 18rpx; color: #176b89; font-size: 26rpx; font-weight: 600; line-height: 1.6; }
.affection-highlight-basis { display: block; margin-top: 12rpx; color: #f0f8fc; font-size: 25rpx; line-height: 1.75; word-break: break-word; }
.affection-highlight-note { display: block; margin-top: 12rpx; color: #176b89; font-size: 24rpx; line-height: 1.65; }
.affection-highlight-boundary { display: block; margin-top: 14rpx; padding: 14rpx 16rpx; border-radius: 8rpx; background: #f0f8fc; color: #203249; font-size: 25rpx; line-height: 1.65; }
.affection-highlight-link { display: flex; align-items: center; justify-content: space-between; min-height: 44px; width: 100%; box-sizing: border-box; margin: 22rpx 0 0; padding: 14rpx 20rpx; border: 1rpx solid #8db9ce; border-radius: 10rpx; background: #203249; color: #ffffff; font-size: 25rpx; line-height: 1.5; text-align: left; }
.affection-highlight-link::after { border: 0; }
.affection-overview { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 22rpx 0 8rpx; }
.affection-overview > view { flex: 1 1 26%; min-width: 0; color: #176b89; font-size: 24rpx; line-height: 1.65; }
.affection-overview-value { display: block; margin-bottom: 6rpx; color: #ffffff; font-size: 42rpx; font-weight: 650; line-height: 1.3; }
/* Editorial report rhythm: one strong judgment, lighter evidence and readable quotes. */
#report-judgment { border-top: 5rpx solid #203249; }
#report-replies, #report-lines { padding: 28rpx 0 0; background: transparent; border-radius: 0; }
.verdict-intent { padding: 0 0 12rpx; border-radius: 0; background: transparent; }
.verdict-intent .judgment, .verdict-intent .lead { font-size: 35rpx; font-weight: 650; line-height: 1.8; }
.intent-highlight .judgment, .intent-highlight .lead { font-size: 28rpx; font-weight: 500; line-height: 1.8; }
.verdict-action { background: #f0f8fc; }
.verdict-action .advice, .verdict-action .lead { font-size: 28rpx; font-weight: 600; }
.reply-first { border-top: 4rpx solid #62758a; }
.reply-heading, .reply > .label { align-self: flex-start; padding: 6rpx 12rpx; border-radius: 6rpx; background: #f0f8fc; color: #176b89; font-size: 24rpx; }
.reply-first .reply-heading, .reply-first > .label { background: #f0f8fc; color: #203249; }
.reply-reason { padding-top: 16rpx; border-top: 1rpx solid #f0f8fc; }
.reply-copy, .primary, .followup-button, .retry { min-height: 44px; border-radius: 12rpx; }
.reply-copy { min-width: 190rpx; margin-top: 6rpx; }
.screen button.disclosure-button { min-height: 44px; border: 1rpx solid #cddfea; border-radius: 12rpx; background: #f0f8fc; color: #203249; font-size: 24rpx; font-weight: 500; }
.screen .reply button.disclosure-button, .screen .reply button.reply-more { align-self: flex-start; width: auto; max-width: 100%; min-height: 44px; margin: 0; padding: 14rpx 20rpx; border: 1rpx solid #cddfea; border-radius: 10rpx; background: transparent; font-size: 24rpx; font-weight: 500; }
.line { gap: 14rpx; padding: 26rpx 0 30rpx; border-radius: 0; border-bottom: 1rpx solid #cddfea; background: transparent; }
.line:last-child { border-bottom: 0; }
.line > .who, .line > .label { align-self: flex-start; margin-left: 2rpx; color: #176b89; font-size: 24rpx; font-weight: 500; }
.line-self > .who, .line-self > .label { align-self: flex-end; margin-left: 0; margin-right: 2rpx; }
.line-self > .quote { margin-left: 34rpx; border-radius: 18rpx 4rpx 18rpx 18rpx; background: #f0f8fc; }
.line-other > .quote { margin-right: 34rpx; }
.line-unknown > .quote { border: 1rpx dashed #cddfea; background: #f0f8fc; }
.followup-note, .elapsed, .foot { color: #176b89; }
.followup-button { margin-top: 24rpx; }
.photo-clues { margin-top: 28rpx; padding: 28rpx; border: 0; border-radius: 18rpx; background: #f0f8fc; }
.photo-clues-heading { font-size: 30rpx; line-height: 1.5; }
@media (max-width: 350px) {
  .screen { padding-left: 24rpx; padding-right: 24rpx; }
  .hero { padding-right: 54rpx; }
  .title { font-size: 41rpx; }
  .panel { padding-left: 24rpx; padding-right: 24rpx; }
  #report-replies, #report-lines { padding-left: 0; padding-right: 0; }
  .reply { padding: 24rpx; }
  .report-shortcuts { gap: 8rpx; }
  .report-shortcuts button { font-size: 24rpx; padding-left: 4rpx; padding-right: 4rpx; }
  .line-self > .quote { margin-left: 20rpx; }
  .line-other > .quote { margin-right: 20rpx; }
}
.partial-results{margin:28rpx 0}.partial-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:32rpx;font-weight:600;color:#203249}.partial-count{font-size:24rpx;padding:8rpx 16rpx;background:#f0f8fc;border-radius:12rpx;color:#203249;flex:none}.partial-note{display:block;font-size:24rpx;line-height:1.65;color:#176b89;margin:14rpx 0 22rpx}.partial-report-title{display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:28rpx;color:#203249}.partial-report-title>text:last-child{font-size:24rpx;font-weight:400;color:#176b89}.partial-observation{display:block;margin-top:18rpx;font-size:28rpx;line-height:1.7}.partial-inference{margin-top:20rpx;padding:20rpx;background:#f0f8fc;border-radius:12rpx;font-size:27rpx;line-height:1.7}.partial-label{display:block;margin-bottom:8rpx;font-size:24rpx;color:#176b89;font-weight:600}.partial-line{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #f0f8fc}.partial-speaker{display:inline-block;margin-bottom:8rpx;font-size:24rpx;padding:3rpx 12rpx;border-radius:8rpx;color:#203249;background:#f0f8fc}.partial-self{background:#f0f8fc;color:#176b89}.partial-quote{display:block;font-size:29rpx;line-height:1.7;color:#203249}.partial-line-note{display:block;margin-top:10rpx;font-size:25rpx;line-height:1.7;color:#176b89}



/* Same daylight glass language as the web workspace. Existing event/condition contracts are retained. */
