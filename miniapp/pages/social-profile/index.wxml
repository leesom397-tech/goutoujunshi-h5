<import src="../../components/analysis-status.wxml"/>
<import src="../../components/moments-report.wxml"/>
<view class="screen">
  <view class="hero page-scene-hero"><view class="glass-stamp page-scene-stamp"><image class="glass-stamp-art" src="/assets/page-scenes/social.png" mode="aspectFit"/><image class="glass-stamp-symbol" src="/assets/ui-users.png" mode="aspectFit"/><text>FROM SIGNALS TO CLARITY</text></view><text class="eyebrow">从真实材料开始</text><text class="title">{{targetSelf ? '看见资料里的自己' : '看懂互动，'}}<text wx:if="{{!targetSelf}}" class="title-line">再决定下一步</text></text><text class="sub">{{result ? '核对材料，理解可能性，再选择适合自己的回应。' : '朋友圈里的线索、彼此的适配，分别说清楚。'}}</text></view>
  <view wx:if="{{phase === 'loading'}}" class="panel"><busy-indicator label="接入微信身份"/></view>
  <view wx:elif="{{phase === 'error'}}" class="panel"><text class="error">{{error}}</text><button class="primary" bindtap="onShow">重试连接</button></view>
  <block wx:else>
    <view wx:if="{{priceError}}" class="panel"><text class="error">{{priceError}}</text><button class="secondary" bindtap="loadPrices">重试读取价格</button></view>
    <template wx:if="{{busy || backgroundPending}}" is="analysisStatus" data="{{busy, backgroundPending, taskStage, uploadProgress, error}}"/>
    <view wx:if="{{analysisPreview && !result}}" class="panel"><text class="step">已识别内容 · 非最终结论</text><text class="summary">{{analysisPreview.summary}}</text><view wx:for="{{analysisPreview.posts}}" wx:key="index"><text class="helper">{{item.date}} · {{item.content}}</text></view><text class="helper">这里只展示部分截图内容，完整人物评价在全部材料整理后生成。</text></view>
    <block wx:if="{{!result && !busy && !backgroundPending}}">
    <view class="input-intro">
      <text class="step">01 · 选一种资料</text>
      <view class="target-switch"><button data-type="profile" class="{{materialType !== 'moments' ? 'active' : ''}}" bindtap="materialChange">社交主页</button><button data-type="moments" class="{{materialType === 'moments' ? 'active' : ''}}" bindtap="materialChange">朋友圈</button></view>
      <text class="helper">{{materialType === 'moments' ? '整条动态截图即可，文案和九宫格一起看。' : '简介、兴趣与择偶条件，可以放在同一批。'}}</text>
      <view class="target-switch target-choice"><button class="{{!targetSelf ? 'active' : ''}}" data-target="other" bindtap="targetChange">看 TA 的资料</button><button class="{{targetSelf ? 'active' : ''}}" data-target="self" bindtap="targetChange">看我的资料</button></view>
    </view>
    <view class="panel input-panel">
      <view class="section-heading"><text class="step">02 · 添加截图</text><text class="image-count">{{imageCount}} / 9 张</text></view>
      <text wx:if="{{completedCount}}" class="helper">已分析 {{completedCount}} 张；继续补充同一人的资料。</text>
      <button wx:if="{{canAdd}}" class="picker" bindtap="choose"><image class="picker-daylight-art" src="/assets/page-scenes/social.png" mode="aspectFit"/><view><text>{{imageCount ? '继续添加截图' : '选择图片或拍照上传'}}</text><text class="hint">同一人的资料 · 最多 9 张</text></view></button>
      <view wx:for="{{images}}" wx:for-index="imageIndex" wx:key="path" class="selected-image"><image src="{{item.path}}" mode="aspectFill" data-index="{{imageIndex}}" bindtap="previewImage" aria-label="查看第 {{imageIndex + 1}} 张截图"></image><text data-index="{{imageIndex}}" bindtap="previewImage">{{item.display}}</text><button data-index="{{imageIndex}}" bindtap="removeImage" aria-label="移除第 {{imageIndex + 1}} 张截图">移除</button></view>
      <button class="text-button" bindtap="toggleUploadHelp" aria-expanded="{{showUploadHelp}}">{{showUploadHelp ? '收起截图建议' : '怎样选图更清楚？'}}</button>
      <view wx:if="{{showUploadHelp}}" class="help-details"><text>按希望阅读的顺序选择，同一批只放同一个人的资料。</text><text>{{materialType === 'moments' ? '保留配文、日期与可见范围提示；不必逐张保存九宫格照片。' : '简介、兴趣、择偶条件等页面可一起选。'}}</text><text>大图会自动压缩。点缩略图核对文字，建议先遮盖联系方式。</text></view>
      <block wx:if="{{!targetSelf}}">
        <text class="field-label">关联哪位人物</text>
        <picker range="{{people}}" range-key="label" value="{{personIndex}}" bindchange="personChange"><view class="archive-select">{{people[personIndex].label}}<text>选择</text></view></picker>
        <checkbox-group bindchange="compareChange"><label class="consent"><checkbox value="yes" checked="{{compareSelf}}" color="#965a42"/><text>参考我的资料，看看你们的交集</text></label></checkbox-group>
        <text class="privacy-summary">基础资料只在成子服务端使用；已填写的关系偏好会随本次图片交由阿里云百炼处理。</text>
      </block>
      <view class="upload-consent">
        <checkbox-group bindchange="agree"><label class="consent"><checkbox value="yes" checked="{{agreed}}" color="#965a42"/><text>{{targetSelf ? '我确认这些是自己的社交资料截图' : '我有权提供这些资料'}}，同意本次经成子服务端发送至阿里云百炼识图。</text></label></checkbox-group>
        <text class="privacy-summary">为断点续传，本机会保存临时图片副本；服务端图片仅用于本次后台处理。</text>
        <button class="text-button" bindtap="togglePrivacyDetails" aria-expanded="{{showPrivacyDetails}}">{{showPrivacyDetails ? '收起临时图片说明' : '临时图片何时清理？'}}</button>
        <view wx:if="{{showPrivacyDetails}}" class="help-details"><text>取回结果或取消上传时清理本机临时副本，清理失败会在下次进入时重试。未完成上传的本机副本在任务过期后再次处理时清理。</text></view>
      </view>
      <text wx:if="{{imageCount}}" class="cost-note">本批 {{imageCount}} 张 · {{pricesReady ? prices.profile + ' 积分' : '价格读取中'}}；分析成功后使用，失败退回。</text>
      <button class="primary" disabled="{{busy || !imageCount || !agreed || !pricesReady}}" bindtap="analyze">{{busy ? '正在整理资料…' : materialType === 'moments' ? '分析朋友圈' : '分析这份资料'}}</button>
      <text wx:if="{{error}}" class="error">{{error}}</text>
    </view>
    <view wx:if="{{!targetSelf}}" class="link-alternative">
      <button class="text-button" bindtap="toggleLinkImport" disabled="{{linkBusy}}" aria-expanded="{{showLinkImport}}">{{showLinkImport ? '收起链接建档' : '没有截图？用公开主页链接建档'}}</button>
      <view wx:if="{{showLinkImport}}" class="panel link-import"><text class="step">公开主页 · 快捷建档</text><text class="helper">支持小红书、抖音。标题和简介会进入待确认线索。</text><input value="{{profileUrl}}" maxlength="500" placeholder="粘贴小红书或抖音公开主页链接" bindinput="profileUrlInput"/><checkbox-group bindchange="linkAgree"><label class="consent"><checkbox value="yes" checked="{{linkConsent}}" color="#965a42"/><text>我确认这是公开主页链接，同意读取公开可见文字并建立人物档案。</text></label></checkbox-group><button class="secondary" disabled="{{linkBusy || !pricesReady}}" bindtap="analyzeProfileLink">{{linkBusy ? '正在读取…' : '读取主页并建档 · ' + (pricesReady ? prices.profile + ' 积分' : '价格读取中')}}</button><text wx:if="{{linkMessage}}" class="success">{{linkMessage}}</text></view>
    </view>
    </block>
    <view wx:if="{{result}}" class="panel result"><text class="step">资料解读 · 共 {{totalCount}} 张</text>
      <view class="report-nav"><button wx:if="{{result.hasHypotheses || result.moments.hasHypotheses}}" data-section="findings" bindtap="jumpToSection">深层推测</button><button wx:if="{{result.approach || result.hasHypothesisActions || (result.isProfile && !targetSelf) || result.moments.approach || result.moments.hasHypotheses || result.moments.hasStarters}}" data-section="actions" bindtap="jumpToSection">怎么相处</button><button data-section="evidence" bindtap="jumpToSection">资料与依据</button></view>
      <view wx:if="{{!result.moments}}" class="profile-verdict"><text class="verdict-label">{{targetSelf ? '你的资料印象' : '人物总评'}}</text><text class="summary">{{result.summary}}</text></view><text wx:if="{{!result.moments && result.coverage}}" class="coverage">{{result.coverage}}</text><button wx:if="{{result.isChat}}" class="secondary" bindtap="openChatScreenshot">去聊天截图分析 →</button><button wx:if="{{canContinue}}" class="secondary" bindtap="nextBatch">继续补图 · {{pricesReady ? prices.profile + ' 积分 / 新批次' : '价格读取中'}}</button>
      <view wx:if="{{!result.moments}}" class="report-followup"><button class="primary" bindtap="continueDiscussion" disabled="{{busy || followupBusy}}">{{followupBusy ? '正在打开…' : '继续追问这份分析'}}</button><text class="helper">带上当前报告继续聊，不必重新描述。</text></view>
      <personal-connection value="{{result.personalConnection}}" target-self="{{targetSelf}}"/>
      <template wx:if="{{result.moments}}" is="momentsReport" data="{{report:result.moments,showDetails:showMomentsDetails,showTimeline:showMomentsTimeline,allowFollowup:true,followupBusy:followupBusy || busy}}"/>
      <view wx:if="{{result.hasHypotheses && !result.moments}}" class="group hypotheses featured" id="profile-findings">
        <view class="hypothesis-heading"><text class="group-title">{{targetSelf ? '你的资料传递出什么' : '值得留意的深层推测'}}</text><text class="hypothesis-tag">待验证</text></view>
        <view wx:for="{{result.hypotheses}}" wx:for-index="hypothesisIndex" wx:key="title" class="hypothesis-card">
          <text class="hypothesis-title">{{item.title}}</text><text class="hypothesis-reading">{{item.possibility}}</text>
          <button class="disclosure-button" data-index="{{hypothesisIndex}}" bindtap="toggleHypothesis" aria-expanded="{{item.expanded}}"><text>{{item.expanded ? '收起依据与其他解释' : '查看依据与其他解释'}}</text><view class="disclosure-chevron {{item.expanded ? 'expanded' : ''}}"></view></button>
          <view wx:if="{{item.expanded}}" class="hypothesis-detail"><text class="detail-label">推测依据</text><text>{{item.evidence}}</text><text wx:if="{{item.alternative}}" class="detail-label">另一种可能</text><text wx:if="{{item.alternative}}">{{item.alternative}}</text></view>
        </view>
      </view>
      <view wx:if="{{!result.moments}}" id="profile-actions">
        <view wx:if="{{result.approach}}" class="moments-report"><template is="communicationApproach" data="{{approach:result.approach}}"/></view>
        <view wx:if="{{result.hasHypothesisActions}}" class="group next-actions"><text class="group-title">可以这样试试</text><block wx:for="{{result.hypotheses}}" wx:key="title"><view wx:if="{{item.verify}}" class="item"><text class="item-title">{{item.title}}</text><text class="meaning">{{item.verify}}</text></view></block></view>
        <view wx:if="{{result.isProfile && !targetSelf && !result.approach && !result.hasHypothesisActions}}" class="decision-brief"><view wx:for="{{result.brief}}" wx:key="label" class="brief-item {{item.tone}}"><text class="brief-label">{{item.label}}</text><text class="brief-text">{{item.text}}</text></view></view>
      </view>
      <view id="social-evidence" class="evidence-heading"><text class="step">继续了解 · 资料与依据</text><text class="helper">回到具体材料，看交集、适配与待核实线索。</text></view>
      <view wx:if="{{result.isProfile && !targetSelf}}" class="group risk"><text class="group-title">需要核实的信号 · {{result.riskCount}} 条</text><text class="hint">{{result.riskCount ? '先核实具体情况，再决定下一步。' : '本组资料未发现具体信号，相处中仍可继续观察。'}}</text><view wx:for="{{result.riskSignals}}" wx:key="category" class="risk-row"><text class="risk-level">{{item.level}} · {{item.category}}</text><text class="evidence">截图依据 · {{item.evidence}}</text><text class="meaning">怎么核实 / 保护自己 · {{item.check}}</text></view></view>
      <view wx:if="{{!targetSelf && result.hasCommonPoints}}" class="group common-points"><text class="group-title">你们的交集</text><view wx:for="{{result.commonPoints}}" wx:key="title" class="item"><text class="item-title">{{item.title}}</text><text class="meaning">{{item.meaning}}</text><text wx:if="{{item.evidence}}" class="evidence">{{item.evidence}}</text></view></view>
      <view wx:if="{{compareSelf && result.fitCoverage > 0}}" class="group fit"><text class="group-title">已有资料的适配线索</text><view wx:if="{{result.fitScore !== null}}" class="fit-score"><text>适配参考分</text><text>{{result.fitScore}} / 100</text></view><text class="fit-summary">{{result.fitSummary}}</text><text class="hint">已知 {{result.fitCoverage}} / 6 项 · 资料适配参考</text><canvas wx:if="{{result.fitCoverage > 0}}" canvas-id="fitRadar" style="width:300px;height:270px" width="300" height="270"></canvas><button class="report-toggle" bindtap="toggleFitDetails">{{showFitDetails ? '收起六项解读' : '查看六项适配解读'}}</button><block wx:if="{{showFitDetails}}"><view wx:for="{{result.fit}}" wx:key="dimension" class="fit-row"><text class="fit-status {{item.status === '待了解' ? 'unknown' : ''}}">{{item.status}}</text><text class="item-title">{{item.dimension}}</text><text class="line">我的信息 · {{item.selfNeed}}</text><text class="meaning">{{item.conclusion}} · {{item.evidence || '暂无截图依据'}}</text></view></block><text wx:if="{{!result.hasFit}}" class="hint">目前还没有可用的双方资料，先补充我的基础资料或 TA 的资料文字。</text></view>
      <view wx:if="{{result.hasPhotoClues && (!result.moments || showMomentsDetails)}}" class="group photo-clues"><text class="group-title">照片里的可聊线索</text><view wx:for="{{result.photoClues}}" wx:key="item" class="item"><text class="photo-category">{{item.category}}</text><text class="item-title">{{item.item}}</text><text wx:if="{{item.style}}" class="meaning">{{item.style}}</text><text class="evidence">{{item.evidence}}</text><text wx:if="{{item.valueHint}}" class="hint">{{item.valueHint}}</text></view></view>
      <view wx:if="{{result.hasProfileBasics}}" class="group basics"><text class="group-title">识别到的基础资料</text><view class="basic-tiles"><view wx:for="{{result.profileBasics}}" wx:key="field" class="basic-tile"><text class="hint">{{item.label}}</text><text class="item-title">{{item.value}}</text></view></view></view>
      <button class="disclosure-button" bindtap="toggleReportDetails" aria-expanded="{{showReportDetails}}"><text>{{showReportDetails ? '收起事实与更多线索' : '查看事实、积极线索与待核实问题'}}</text><view class="disclosure-chevron {{showReportDetails ? 'expanded' : ''}}"></view></button>
      <block wx:if="{{showReportDetails}}">
      <view class="group facts"><text class="group-title">资料中看到了什么</text><view wx:for="{{result.visibleFacts}}" wx:key="title" class="item"><text class="item-title">{{item.title}}</text><text class="evidence">截图依据 · {{item.evidence}}</text><text wx:if="{{item.meaning}}" class="meaning">这说明 · {{item.meaning}}</text></view><text wx:if="{{!result.hasVisibleFacts}}" class="hint">还没有足够清晰的可核对资料。</text></view>
      <view class="group positives"><text class="group-title">积极线索</text><view wx:for="{{result.positives}}" wx:key="title" class="item"><text class="item-title">{{item.title}}</text><text class="evidence">依据 · {{item.evidence}}</text><text class="meaning">{{item.meaning}}</text></view><text wx:if="{{!result.hasPositives}}" class="hint">补充兴趣、日常生活或互动截图，可以进一步了解。</text></view>
      <view class="group cautions"><text class="group-title">需要留意</text><view wx:for="{{result.cautions}}" wx:key="title" class="item"><text class="item-title">{{item.title}}</text><text class="evidence">依据 · {{item.evidence}}</text><text class="meaning">{{item.meaning}}</text></view><text wx:if="{{!result.hasCautions}}" class="hint">未见有截图依据的具体预警。</text></view>
      <view class="group unknowns"><text class="group-title">还可以了解什么</text><text wx:for="{{result.unknowns}}" wx:key="*this" class="line">· {{item}}</text><text wx:for="{{result.questions}}" wx:key="*this" class="line">可以问 · {{item}}</text></view>
      <view wx:if="{{result.hasNextMaterials}}" class="group materials"><text class="group-title">想看得更完整，可以补充</text><text wx:for="{{result.nextMaterials}}" wx:key="*this" class="line">· {{item}}</text></view>
      <text class="disclaimer">{{result.note}}</text>
      </block>
      <view wx:if="{{result.hasKnowledgeSources}}" class="knowledge-used"><text class="group-title">本次参考的方法</text><text wx:for="{{result.knowledgeSources}}" wx:key="anchor" class="knowledge-chip">{{item.label}}</text><text class="hint">结合本次资料选取的关系主题笔记</text></view>
      <text wx:if="{{result.moments}}" class="helper">归档后可在人物档案查看完整报告；再次归档会更新最新报告，推测不作为已确认事实。</text>
      <button class="secondary" bindtap="startNewProfile">分析另一份资料</button>
    </view>
    <view wx:if="{{result && targetSelf}}" class="panel"><text class="step">保存到我的档案</text><text class="helper">可见文字和基础信息先进入待核对区；你一键核对后才补进档案，已有手填资料不会被覆盖。原图不长期保存。</text><checkbox-group bindchange="archiveAgree"><label class="consent"><checkbox value="yes" checked="{{archiveConsent}}" color="#965a42"/><text>我确认这些资料属于我，同意启用我的档案，并把可见线索与基础信息存入待核对区。</text></label></checkbox-group><button class="primary" disabled="{{archiveBusy || archiveMessage === '已建立我的档案，基础信息和截图线索待逐条确认；原图未长期保存。'}}" bindtap="saveClues">{{archiveBusy ? '正在归档…' : '建立并核对我的档案 →'}}</button><text wx:if="{{archiveMessage}}" class="success">{{archiveMessage}}</text><button class="secondary" bindtap="openArchive">核对我的档案</button></view>
    <view wx:if="{{result && !targetSelf}}" class="panel"><text class="step">保存到人物档案</text><text class="helper">已有人物可把截图中的可见线索存入待核对区；原图不长期保存，也不把资料自述当成已核实事实。</text><block wx:if="{{personIndex > 0}}"><text class="helper">当前人物：{{people[personIndex].label}}</text><checkbox-group bindchange="archiveAgree"><label class="consent"><checkbox value="yes" checked="{{archiveConsent}}" color="#965a42"/><text>我确认这组截图属于该人物，同意保存可见文字线索与出处，之后可一键核对或删除。</text></label></checkbox-group><button class="primary" disabled="{{archiveBusy || archiveMessage === '已把可见线索放入该人物的待核对区；原图未长期保存。'}}" bindtap="saveClues">{{archiveBusy ? '正在归档…' : '归到这位人物 →'}}</button></block><block wx:else><text class="helper">没有人物档案？可以只建档，也可以一次建立档案并归档这组截图。</text><input maxlength="60" placeholder="例如：小林 / 约会软件认识的人" value="{{label}}" bindinput="labelInput"/><checkbox-group bindchange="archiveAgree"><label class="consent"><checkbox value="yes" checked="{{archiveConsent}}" color="#965a42"/><text>我同意启用人物档案并保存这个称呼，可在档案页删除。</text></label></checkbox-group><checkbox-group bindchange="archiveTogetherChange"><label class="consent"><checkbox value="yes" checked="{{archiveTogether}}" color="#965a42"/><text>同时把本组截图的可见线索归入新档案</text></label></checkbox-group><button class="primary" disabled="{{archiveBusy || archiveMessage}}" bindtap="createArchive">{{archiveBusy ? '正在处理…' : archiveMessage ? '已完成' : archiveTogether ? '同时建档并归档 →' : '只建立人物档案 →'}}</button></block><text wx:if="{{archiveMessage}}" class="success">{{archiveMessage}}</text><button class="secondary" bindtap="openArchive">查看人物档案</button></view>
    <avatar-picker wx:if="{{result}}" sources="{{images}}" candidates="{{result.avatarCandidates}}" self="{{targetSelf}}" subject-id="{{people[personIndex].id}}" current="{{people[personIndex].avatar}}"/>
    <text wx:if="{{result && error}}" class="error">{{error}}</text>
  </block>
  <main-navigation selected="analysis"/>
</view>
