.screen{box-sizing:border-box;min-height:100vh;padding:32rpx 30rpx 80rpx;background:radial-gradient(ellipse at 100% 0%,#e0f1f8,transparent 55%),#f6f9fc;color:#203249;font-family:"PingFang SC","Microsoft YaHei","Noto Sans SC",sans-serif}
.new-person-hero{position:relative;box-sizing:border-box;min-height:330rpx;overflow:hidden;padding:42rpx 36rpx;border:1rpx solid #d0e4ef;border-radius:32rpx;background:linear-gradient(125deg,#fff,#e8f4f9);box-shadow:inset 0 2rpx 0 #fff,0 18rpx 48rpx rgba(71,118,148,.06)}.new-person-scene{position:absolute;inset:0;width:100%;height:100%;opacity:.52;animation:person-scene-float 14s ease-in-out infinite alternate;pointer-events:none}.new-person-copy{position:relative;z-index:1}.eyebrow{display:block;font-size:24rpx;letter-spacing:2rpx;color:#526579}.eyebrow:before{content:'';display:inline-block;width:8rpx;height:8rpx;margin-right:12rpx;border-radius:50%;background:#359bbb;box-shadow:0 0 0 5rpx rgba(97,188,216,.13);vertical-align:middle}.title{display:block;margin-top:21rpx;font-size:49rpx;font-weight:700;line-height:1.45;letter-spacing:-1rpx}.title-next{display:block}.sub{display:block;margin:19rpx 0 0;font-size:24rpx;line-height:1.8;color:#176b89}
.wizard-steps{display:flex;align-items:center;gap:10rpx;margin:37rpx 5rpx;color:#176b89;font-size:24rpx}.wizard-steps>view{height:1rpx;flex:1;background:#bddde9}.wizard-steps .current{color:#526579}.panel{margin-bottom:26rpx;padding:32rpx;background:rgba(255,255,255,.86);border:1rpx solid #d7e6ee;border-radius:28rpx;box-shadow:inset 0 2rpx 0 #fff,0 12rpx 34rpx rgba(60,100,126,.04);backdrop-filter:blur(16px);animation:person-form-enter .35s ease-out both}.section-heading{display:flex;align-items:flex-start;gap:21rpx;margin-bottom:26rpx}.section-number{display:flex;align-items:center;justify-content:center;flex:none;width:70rpx;height:73rpx;border:1rpx solid #cbe4ee;border-radius:19rpx;background:linear-gradient(135deg,#e6f6fb,#f8fdff);color:#526579;font-size:25rpx}.section-heading>view{flex:1;min-width:0}.heading{display:block;font-size:30rpx;font-weight:650;line-height:1.6}.section-caption{display:block;font-size:24rpx;line-height:1.8;color:#176b89;margin-top:6rpx}.label{display:block;font-size:24rpx;font-weight:500;line-height:1.7;color:#537086;margin:26rpx 0 15rpx}.select-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;box-sizing:border-box;min-height:88rpx;padding:18rpx 20rpx;margin:17rpx 0;border:1rpx solid #cbdfea;border-radius:17rpx;font-size:25rpx;background:#fff;color:#456b80;line-height:1.8}.value{color:#356c85;text-align:right;max-width:70%}
input{box-sizing:border-box;width:100%;height:92rpx;padding:0 21rpx;border:1rpx solid #c9dfea;border-radius:17rpx;font-size:26rpx;background:#fff;color:#29475e}textarea{box-sizing:border-box;width:100%;height:190rpx;padding:20rpx 21rpx;border:1rpx solid #c9dfea;border-radius:17rpx;font-size:26rpx;line-height:1.8;background:#fff;color:#29475e}.input-placeholder,.textarea-placeholder{color:#176b89}.clear-city{display:inline-flex;min-height:64rpx;margin:0;padding:10rpx 16rpx;background:#eef7fb;border:1rpx solid #d0e4ee;border-radius:12rpx;font-size:24rpx;color:#526579;line-height:1.8}.consent{display:flex;align-items:flex-start;gap:10rpx;font-size:24rpx;line-height:1.85;color:#176b89;padding:4rpx}.consent checkbox{margin-top:5rpx;flex:none;transform:scale(.85);transform-origin:top left}.primary{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-height:94rpx;margin-top:26rpx;padding:20rpx;background:linear-gradient(135deg,#2585a2,#176f8e);border:1rpx solid #237d98;color:#fff;font-size:28rpx;font-weight:550;line-height:1.8;border-radius:18rpx;box-shadow:0 9rpx 25rpx rgba(43,127,156,.15)}button::after{border:0}button[disabled]{opacity:.45}button:active{transform:scale(.99)}.error{display:block;margin-top:20rpx;padding:18rpx 22rpx;background:#fff3ed;border:1rpx solid #efd3c6;border-radius:16rpx;color:#a64e38;font-size:25rpx;line-height:1.8}
@keyframes person-form-enter{from{opacity:0;transform:translateY(12rpx)}to{opacity:1;transform:translateY(0)}}@keyframes person-scene-float{from{transform:scale(1)}to{transform:scale(1.035)}}@media(prefers-reduced-motion:reduce){.panel,.new-person-scene{animation:none;transition:none}}@media(max-width:360px){.screen{padding-left:24rpx;padding-right:24rpx}.panel{padding:28rpx}.new-person-hero{padding:36rpx 29rpx}.title{font-size:47rpx}.wizard-steps{font-size:24rpx;gap:8rpx}.section-number{width:63rpx;height:68rpx}.section-heading{gap:17rpx}.heading{font-size:29rpx}}

/* Readable daylight type: distinct headings, body, and supporting text. */
.eyebrow{font-size:24rpx;color:#176b89}.title{font-size:49rpx;line-height:1.45;color:#203249;font-weight:700}.sub{font-size:26rpx;color:#425a6f;line-height:1.85}.wizard-steps{font-size:24rpx;color:#526579;line-height:1.65;gap:10rpx}.wizard-steps .current{color:#155e7a;font-weight:600}.heading{font-size:33rpx;line-height:1.55;font-weight:650}.section-caption{font-size:25rpx;color:#526579;line-height:1.85}.section-number{font-size:27rpx;color:#176b89}.label{font-size:27rpx;font-weight:550;color:#36566e}.select-row{font-size:27rpx;color:#36566e}.value{color:#244f67}input,textarea{font-size:28rpx;color:#203249}textarea{line-height:1.85}.consent{font-size:25rpx;line-height:1.85;color:#425a6f}.clear-city{font-size:25rpx;color:#155e7a}.primary{background:linear-gradient(135deg,#176f8c,#155d78);color:#fff;font-size:29rpx}.error{font-size:25rpx;color:#98472f}.input-placeholder,.textarea-placeholder{color:#526579}

/* Final shared phone contrast layer. */
@import "../../styles/phone-contrast.wxss";
