.screen{min-height:100vh;box-sizing:border-box;padding:24rpx 38rpx 20rpx;background:radial-gradient(ellipse at 0 18%,#e5f4fc 0,transparent 40%),radial-gradient(ellipse at 100% 0,#fff8ec 0,transparent 30%),#f6f9fc;color:#203249;font-family:"PingFang SC","Microsoft YaHei",sans-serif}
.brand{display:flex;align-items:center;gap:18rpx;padding:8rpx 0 28rpx;border-bottom:1rpx solid #cbdce68a}.brand-icon{width:72rpx;height:72rpx;flex:none}.brand-copy{flex:1}.brand-name{display:block;font-size:39rpx;font-weight:750;letter-spacing:2rpx}.brand-aside{display:block;margin-top:5rpx;color:#176b89;font-size:20rpx;letter-spacing:1rpx}.brand-account{display:flex;align-items:center;gap:12rpx;margin:0;padding:16rpx 20rpx;border:1rpx solid #c1d8e5;border-radius:15rpx;background:#ffffffa8;font-size:24rpx;line-height:1.5;color:#416e87}.brand-account image{width:24rpx;height:24rpx}
.hero{position:relative;margin-top:46rpx}.hero-content{position:relative;z-index:2}.eyebrow{display:inline-flex;align-items:center;gap:10rpx;padding:12rpx 19rpx;border:1rpx solid #cce2ed;border-radius:40rpx;background:#ffffff9c;color:#526579;font-size:24rpx}.eyebrow image{width:24rpx;height:24rpx}.headline{margin-top:32rpx;font-size:59rpx;line-height:1.36;font-weight:750;letter-spacing:-2rpx}.headline text{display:block}.headline text+text{color:#526579}.hero-sub{display:block;margin-top:27rpx;color:#176b89;font-size:25rpx;line-height:1.95}.hero-sub text{display:block}.hero-primary{display:inline-flex;align-items:center;gap:34rpx;margin:32rpx 0 0;padding:22rpx 29rpx;min-height:84rpx;border:1rpx solid #368ca5;border-radius:16rpx;background:linear-gradient(145deg,#4396af,#247991);box-shadow:inset 0 2rpx 0 #ffffff66,0 12rpx 28rpx #4e9db326;color:#fff;font-size:25rpx;font-weight:650;line-height:1.6}.hero-primary>text{font-size:31rpx}.privacy-note{display:flex;align-items:center;gap:10rpx;margin-top:28rpx;color:#176b89;font-size:24rpx;line-height:1.6}.privacy-note image{width:25rpx;height:25rpx}
.hero-scene{position:relative;height:420rpx;margin:0 -38rpx;overflow:hidden;background:#edf6fc}.hero-scene:before,.hero-scene:after{content:"";position:absolute;z-index:2;left:0;right:0;height:70rpx;pointer-events:none}.hero-scene:before{top:0;background:linear-gradient(#f2f8fc,transparent)}.hero-scene:after{bottom:0;background:linear-gradient(transparent,#f6f9fc)}.hero-art{position:absolute;left:-2%;top:-3%;width:104%;height:106%;animation:glass-float 7s ease-in-out infinite}.sunlight{position:absolute;top:-40%;bottom:-40%;left:-80%;right:-80%;transform:translateX(-25%) rotate(-18deg);background:linear-gradient(90deg,transparent 37%,#ffffff00 42%,#ffffff70 50%,transparent 60%);animation:sunlight-pass 8s ease-in-out infinite;pointer-events:none}.glass-label{position:absolute;z-index:3;display:flex;align-items:center;gap:10rpx;padding:15rpx 19rpx;border:1rpx solid #fff;border-radius:12rpx;background:#ffffffc2;color:#176b89;font-size:24rpx;box-shadow:0 9rpx 24rpx #3b728d12;backdrop-filter:blur(14px)}.glass-label>view{width:7rpx;height:7rpx;border-radius:50%;background:#76bcd2}.glass-label-one{top:105rpx;right:49rpx}.glass-label-two{bottom:68rpx;left:47rpx}.glass-label-two>view{background:#d7b26c}.motion-toggle{position:absolute;right:38rpx;bottom:35rpx;z-index:4;display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:72rpx;height:72rpx;margin:0;padding:0;border:1rpx solid #e2edf5;border-radius:50%;background:#ffffffc9}.motion-toggle image{width:29rpx;height:29rpx}.motion-paused .hero-art,.motion-paused .sunlight{animation-play-state:paused}
.capability-strip{display:flex;flex-wrap:wrap;gap:20rpx;justify-content:space-between;padding:25rpx 0;border-top:1rpx solid #cadfeb80;border-bottom:1rpx solid #cadfeb80}.capability-strip>view{display:flex;align-items:center;gap:9rpx;color:#176b89;font-size:24rpx}.capability-strip image{width:25rpx;height:25rpx}.identity-note{margin-top:20rpx;color:#176b89;font-size:24rpx}.identity-error{padding:20rpx;border:1rpx solid #e7bcab;border-radius:15rpx;background:#fff4ed;text-align:left;color:#a25a41;line-height:1.6}.identity-error text{display:block;font-size:24rpx}
.section-head{margin:48rpx 0 25rpx}.section-kicker{display:block;font-size:22rpx;letter-spacing:2rpx;line-height:1.5;color:#176b89}.section-title{display:block;margin-top:14rpx;font-size:35rpx;font-weight:650}.entry-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.entry-card{box-sizing:border-box;display:flex;flex-direction:column;align-items:stretch;min-width:0;margin:0;padding:23rpx;border:1rpx solid #bdd5e371;border-radius:27rpx;background:linear-gradient(140deg,#ffffffed,#f7fcffbb);box-shadow:inset 0 2rpx #fff,0 14rpx 33rpx #42748d0a;text-align:left;line-height:1.5;color:#203249;animation:home-appear .5s ease-out both}.entry-art{position:relative;display:flex;align-items:center;justify-content:center;height:127rpx;overflow:hidden;background:radial-gradient(ellipse,#dceef7,transparent 72%)}.entry-art image{position:relative;z-index:1;width:62rpx;height:62rpx}.entry-ring{position:absolute;width:122rpx;height:79rpx;border:1rpx solid #abcdda7d;border-radius:50%;transform:rotate(-24deg)}.entry-warm .entry-art{background:radial-gradient(ellipse,#faf0dd,transparent 72%)}.entry-title{display:block;margin-top:15rpx;font-size:27rpx;font-weight:650;line-height:1.5}.entry-description{flex:1;display:block;margin-top:12rpx;color:#176b89;font-size:24rpx;line-height:1.8}.entry-action{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:24rpx;color:#526579;font-size:24rpx;font-weight:600}.entry-action>text{font-size:30rpx}.entry-card:active,.hero-primary:active{transform:translateY(2rpx);opacity:.9}
.relationship-card{display:flex;align-items:center;box-sizing:border-box;gap:15rpx;width:100%;margin:28rpx 0 0;padding:32rpx;border:1rpx solid #c0dce777;border-radius:27rpx;background:linear-gradient(135deg,#ffffffdd,#e8f5f9bf);box-shadow:inset 0 2rpx #fff;text-align:left;line-height:1.6;color:#203249}.relationship-card>view{flex:1}.relationship-card>image{width:104rpx;height:104rpx;opacity:.68}.relationship-title{display:block;margin-top:17rpx;font-size:36rpx;font-weight:650}.relationship-title text{display:block}.relationship-description{display:block;margin-top:17rpx;color:#176b89;font-size:24rpx}.self-entry{display:flex;align-items:center;gap:20rpx;width:100%;box-sizing:border-box;margin:24rpx 0 0;padding:24rpx;border:1rpx solid #c9dde67a;border-radius:20rpx;background:#ffffffa8;color:#426981;font-size:27rpx;line-height:1.5;text-align:left}.self-entry image{width:41rpx;height:41rpx}.self-entry>view{flex:1}.self-entry>view>text{display:block}.self-entry>view>text+text{font-size:24rpx;color:#176b89;margin-top:5rpx}
.knowledge-card{margin-top:24rpx;padding:28rpx;border:1rpx solid #c5d9e577;border-radius:24rpx;background:#ffffffc4}.knowledge-heading{display:flex;align-items:center;gap:15rpx;font-size:27rpx;font-weight:650}.knowledge-heading image{width:36rpx;height:36rpx}.knowledge-amount{display:flex;align-items:baseline;gap:10rpx;margin-top:25rpx;color:#526579}.knowledge-amount>text:first-child{font-size:57rpx;font-weight:550;line-height:1.2}.knowledge-amount>text+text{font-size:24rpx}.knowledge-caption{display:block;margin-top:10rpx;font-size:24rpx;color:#176b89}.knowledge-toggle{display:flex;align-items:center;justify-content:space-between;gap:18rpx;width:100%;margin:24rpx 0 0;padding:22rpx 0 0;border:0;border-top:1rpx solid #d2e1e980;border-radius:0;background:transparent;color:#176b89;font-size:24rpx;line-height:1.6;text-align:left}.knowledge-detail{display:flex;flex-direction:column;gap:15rpx;padding-top:20rpx;color:#176b89;font-size:24rpx;line-height:1.85}.bottom-note{display:block;margin:35rpx 0 0;font-size:24rpx;line-height:1.8;color:#176b89}.resume-panel{margin:22rpx 0 0;padding:23rpx;border:1rpx solid #c5dce4;border-radius:22rpx;background:#f8fdffcc}.resume-title{display:block;color:#526579;font-size:25rpx;font-weight:650}.resume-panel button{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin:15rpx 0 0;padding:0;border:0;background:transparent;font-size:24rpx;text-align:left;line-height:1.6;color:#365c75}.resume-name,.resume-state{display:block}.resume-state{margin-top:5rpx;color:#176b89;font-size:24rpx}.resume-action{flex:none;color:#526579;font-size:24rpx}
@keyframes home-appear{from{opacity:0;transform:translateY(15rpx)}to{opacity:1;transform:translateY(0)}}@keyframes glass-float{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-12rpx) scale(1.025)}}@keyframes sunlight-pass{0%,100%{transform:translateX(-20%) rotate(-18deg);opacity:.15}50%{transform:translateX(20%) rotate(-18deg);opacity:.65}}@media(prefers-reduced-motion:reduce){.hero-art,.sunlight,.entry-card{animation:none}}

/* Readable daylight type: distinct headings, body, and supporting text. */
.brand{flex-wrap:wrap;row-gap:16rpx}.brand-copy{min-width:0}.brand-name{font-size:39rpx;line-height:1.45}.brand-aside{font-size:20rpx;color:#526579;line-height:1.5;letter-spacing:1rpx}.brand-account{font-size:24rpx;color:#244f67}.eyebrow{font-size:24rpx;color:#176b89}
.headline{font-size:59rpx;font-weight:700;line-height:1.4}.headline text+text{color:#176b89}.hero-sub{font-size:28rpx;color:#425a6f;line-height:1.85}.hero-primary{background:linear-gradient(135deg,#176f8c,#155d78);font-size:28rpx;color:#fff}
.privacy-note,.bottom-note{font-size:24rpx;color:#526579;line-height:1.8}.glass-label{font-size:24rpx;color:#36566e;background:#ffffffed}.capability-strip{gap:16rpx}.capability-strip>view{font-size:24rpx;color:#425a6f}.section-kicker{font-size:22rpx;color:#526579;letter-spacing:1.6rpx}.section-title{font-size:36rpx;font-weight:650;line-height:1.5}
.entry-card{padding:24rpx}.entry-title{font-size:30rpx;font-weight:650;line-height:1.5}.entry-description,.relationship-description,.self-entry>view>text+text{font-size:25rpx;line-height:1.8;color:#526579}.entry-action{font-size:25rpx;color:#176b89}.relationship-title{font-size:36rpx;font-weight:650}.knowledge-heading{font-size:30rpx}.knowledge-caption,.knowledge-detail{font-size:25rpx;color:#526579;line-height:1.85}.knowledge-toggle{font-size:26rpx;color:#244f67}.resume-title{font-size:27rpx}.resume-panel button{font-size:26rpx}.resume-state,.resume-action{font-size:24rpx;line-height:1.65}.resume-name{font-weight:600}

/* Final shared phone contrast layer. */
@import "../../styles/phone-contrast.wxss";

/* Same dense, straight glass texture as the web homepage. Slow material drift,
   with changing ambient brightness, replaces the old diagonal sweep. */
.aurora-scene{height:350rpx;margin:28rpx -38rpx 0;background:#fffaf4}.aurora-scene .hero-art{left:-3%;top:-2%;width:106%;height:104%;animation:aurora-material-drift 25s ease-in-out infinite}.aurora-scene .sunlight{inset:0;background:radial-gradient(ellipse at 30% 55%,#fff5db7a,transparent 65%);transform:none;animation:aurora-material-light 25s ease-in-out infinite;mix-blend-mode:screen}.aurora-scene:before{height:85rpx;background:linear-gradient(#fffaf4,transparent)}.aurora-scene:after{height:60rpx;background:linear-gradient(transparent,#fffaf4)}.aurora-scene .glass-label{font-size:23rpx;background:#fffaf4de;color:#855741;border-color:#fff8ee;box-shadow:0 6rpx 20rpx #aa633518}.aurora-scene .glass-label-one{top:72rpx;right:35rpx}.aurora-scene .glass-label-two{left:35rpx;bottom:65rpx}.aurora-scene .motion-toggle{background:#fffaf4d9;border-color:#e4c6ad;right:32rpx;bottom:30rpx}.hero .headline{font-size:55rpx;font-weight:600;letter-spacing:-1rpx}.hero .headline text+text{color:#9f5b44}.hero .hero-sub{color:#7e695c}.hero .hero-primary{background:linear-gradient(135deg,#eda58c,#d78e73);border-color:#e6a087;color:#4d3024;box-shadow:inset 0 2rpx #ffdbc9,0 8rpx 22rpx #c77c4b1a}.hero .privacy-note{color:#897263}.section-head{margin-top:30rpx}.brand{border-color:#e5d1c1}.brand-icon{background:transparent;box-shadow:none;border-radius:0}.brand-name{color:#392c25}.entry-card{border-radius:22rpx}.entry-art{height:96rpx}.entry-art image{width:52rpx;height:52rpx}.entry-ring{width:96rpx;height:64rpx}.entry-description{font-size:26rpx}
@keyframes aurora-material-drift{0%,100%{transform:translateX(-1%) scaleX(1.01);filter:brightness(1)}50%{transform:translateX(1%) scaleX(1.04);filter:brightness(1.08)}}@keyframes aurora-material-light{0%,100%{opacity:.18}50%{opacity:.6}}
.motion-paused .hero-art,.motion-paused .sunlight{animation-play-state:paused}@media(prefers-reduced-motion:reduce){.aurora-scene .hero-art,.aurora-scene .sunlight{animation:none}}
.knowledge-reference-count{display:block;margin:14rpx 0 8rpx;font-size:26rpx;font-weight:600;line-height:1.8;color:#84563f}
.history-entry{margin:22rpx 0 10rpx;background:#fff4e9;border-color:#e9c7b4}.history-entry>view>text:first-child{font-size:30rpx;font-weight:650;color:#714831}

.entry-main{display:block;width:100%;padding:0;margin:0;background:transparent;color:inherit;text-align:left;line-height:1.5}.entry-main:after,.entry-voice:after{border:0}.entry-voice{display:flex;align-items:center;gap:10rpx;margin:18rpx 0 0;padding:14rpx 0 0;min-height:72rpx;background:transparent;border-top:1rpx solid #eadbce;border-radius:0;color:#965a42;font-size:24rpx;line-height:1.5}.entry-voice image{width:28rpx;height:28rpx}.home-archive-links{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:20rpx}.home-archive-links button{padding:16rpx 18rpx;min-height:80rpx;margin:0;background:transparent;color:#84563f;font-size:25rpx;line-height:1.6}.home-archive-links button:after{border:0}
