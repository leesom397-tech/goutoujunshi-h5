.screen{padding:32rpx 30rpx 24rpx;background:#f7f5ef;font-family:"PingFang SC","Microsoft YaHei",sans-serif;color:#142633}
.screen .brand{display:flex;align-items:center;justify-content:flex-start;gap:16rpx;margin:0 4rpx 26rpx}
.screen .brand-icon{width:72rpx;height:72rpx;border-radius:20rpx;flex:none}
.screen .brand-copy{display:flex;flex-direction:column;gap:6rpx}.screen .brand-name{font-size:30rpx;line-height:1.35;letter-spacing:0;font-weight:700}.screen .brand-aside{font-size:22rpx;line-height:1.4;color:#737b79;letter-spacing:0}
.screen .top-rule{display:none}
.screen .knowledge-hero{position:relative;overflow:hidden;padding:28rpx 28rpx 20rpx;margin:0;border-radius:28rpx;background:linear-gradient(135deg,#203d4c,#142633 75%);box-shadow:0 14rpx 32rpx rgba(20,38,51,.09);color:#fffcf5}
.screen .hero-content{position:relative;z-index:1}.screen .hero-art{position:absolute;right:-30rpx;top:20rpx;width:280rpx;height:280rpx;opacity:.14}
.screen .eyebrow{font-size:21rpx;font-weight:500;line-height:1.5;letter-spacing:1rpx;color:#d7c6a1}
.screen .knowledge-cover{position:relative;display:flex;align-items:center;justify-content:space-between;min-height:160rpx;margin:10rpx 0 0;border:0;padding:0}
.screen .knowledge-cover-copy{flex:1;min-width:0;z-index:1}.screen .knowledge-cover-number{display:flex;align-items:baseline;gap:12rpx;line-height:1}
.screen .knowledge-cover-figure{font-family:Georgia,"Times New Roman",serif;font-size:104rpx;font-weight:400;font-style:normal;line-height:1.02;letter-spacing:-3rpx;color:#ecd4a2}
.screen .knowledge-cover-unit{font-size:27rpx;color:#ecd4a2}.screen .knowledge-cover-caption{display:block;font-size:26rpx;font-weight:600;line-height:1.55;margin-top:10rpx;color:#f8efdf}
.screen .knowledge-cover-art{width:164rpx;height:164rpx;flex:none;opacity:.96;transform:rotate(-5deg);margin:0 -8rpx 0 8rpx}
.screen .knowledge-intro{display:block;padding:0;border:0;margin:14rpx 0 18rpx;font-size:23rpx;line-height:1.6;color:#d4dedf}
.screen .knowledge-toggle{display:flex;align-items:center;justify-content:space-between;min-height:76rpx;height:auto;width:100%;padding:14rpx 18rpx;margin:0;border:1rpx solid rgba(221,208,180,.4);border-radius:12rpx;background:rgba(255,255,255,.055);font-size:23rpx;font-weight:500;line-height:1.5;color:#f5ead5;text-align:left;box-shadow:none}
.screen .knowledge-toggle .knowledge-chevron{font-size:28rpx;font-weight:400}.screen .knowledge-detail{padding:20rpx 0 0;font-size:24rpx;line-height:1.75;color:#e0e6e6}.screen .knowledge-caveat{font-size:22rpx;line-height:1.65;color:#b4c3c7}
.screen .screenshot-choices{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18rpx;margin:24rpx 0 0}
.screen .screenshot-choice{position:relative;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-start;gap:20rpx;min-width:0;width:100%;height:auto;min-height:240rpx;margin:0;padding:24rpx 22rpx;border:1rpx solid #cfbc97;border-radius:22rpx;background:#eee2c8;color:#142633;line-height:1.5;box-shadow:0 4rpx 0 #d1bc94;text-align:left}
.screen .screenshot-choice-profile{background:#dfeae5;border-color:#b5ccbf;box-shadow:0 4rpx 0 #b6cbbd}
.screen .choice-icon{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;margin:0;border:0;border-radius:18rpx;background:rgba(255,255,255,.54);flex:none}.screen .choice-icon image{width:40rpx;height:40rpx}
.screen .choice-copy{display:block;width:100%;min-width:0}.screen .choice-title{display:block;font-size:29rpx;font-weight:700;line-height:1.5;white-space:normal;letter-spacing:0}.screen .choice-detail{display:block;margin-top:7rpx;font-size:22rpx;font-weight:400;line-height:1.55;color:#586860;white-space:normal}
.screen .primary-arrow{position:absolute;right:22rpx;top:29rpx;font-size:30rpx;line-height:1;color:#34473e}
.screen .privacy-note{display:block;margin:18rpx 2rpx 24rpx;font-size:21rpx;line-height:1.5;color:#80847d;text-align:center}
.screen .coach-entry{display:flex;align-items:center;gap:20rpx;width:100%;min-height:128rpx;box-sizing:border-box;margin:0;padding:24rpx;border:1rpx solid #d7d9d2;border-radius:22rpx;background:#fffcf7;color:#142633;text-align:left;line-height:1.5;box-shadow:0 4rpx 12rpx rgba(20,38,51,.025)}
.screen .coach-entry>image{width:52rpx;height:52rpx;flex:none}.screen .coach-entry>view{flex:1;min-width:0}.screen .coach-title{display:block;font-size:29rpx;font-weight:650}.screen .coach-caption{display:block;margin-top:5rpx;font-size:22rpx;color:#717971}.screen .coach-arrow{flex:none;padding:10rpx 14rpx;border-radius:10rpx;background:#eee5d4;font-size:23rpx;font-weight:600;color:#5d4a2d}
.screen .section-next{margin-top:30rpx;padding:0;border:0}.screen .section-next>text{font-size:25rpx;font-weight:650;color:#485650;letter-spacing:0}
.screen .action-flow{margin-top:14rpx}.screen .action-row{display:flex;align-items:center;gap:18rpx;width:100%;height:auto;min-height:126rpx;padding:22rpx;margin:0;border:1rpx solid #deddd4;border-radius:22rpx;background:#fffcf7;box-shadow:none}
.screen .action-art{width:70rpx;height:70rpx;flex:none;border-radius:17rpx}.screen .action-copy{flex:1;min-width:0}.screen .action-title{display:block;font-size:28rpx;font-weight:650;color:#142633}.screen .action-sub{display:block;margin-top:6rpx;font-size:22rpx;color:#737b73;line-height:1.55}.screen .action-arrow{display:flex;align-items:center;justify-content:center;width:45rpx;height:45rpx;border-radius:50%;background:#203d4c;color:#fff;font-size:27rpx;flex:none}
.screen .self-entry{display:flex;align-items:center;gap:12rpx;min-height:82rpx;width:100%;margin:14rpx 0 0;padding:12rpx 18rpx;background:transparent;border:1rpx solid #deddd4;border-radius:15rpx;color:#58645e;font-size:24rpx;line-height:1.5}.screen .self-entry image{width:28rpx;height:28rpx}.screen .self-entry>text:last-child{margin-left:auto}
.screen .bottom-note{display:block;margin:20rpx 0 0;font-size:20rpx;color:#848980;line-height:1.6;text-align:center}
.screen .resume-panel{margin:0 0 24rpx;padding:20rpx;border:1rpx solid #cfbd98;border-radius:20rpx;background:#fffaf0}.screen .resume-title{display:block;font-size:22rpx;color:#806940;margin-bottom:8rpx}.screen .resume-panel button{display:flex;align-items:center;justify-content:space-between;width:100%;margin:0;padding:14rpx 0;text-align:left;background:transparent;border:0;line-height:1.5}.screen .resume-name{display:block;font-size:27rpx;font-weight:600;color:#142633}.screen .resume-state{display:block;font-size:21rpx;color:#6c766f;margin-top:5rpx}.screen .resume-action{font-size:23rpx;color:#826837;flex:none;margin-left:12rpx}
.screen .identity-note{margin:12rpx 0;font-size:23rpx;color:#68766f}.screen .identity-error{padding:18rpx;background:#fbf0e8;border:1rpx solid #cbae9a;border-radius:15rpx;text-align:left}.screen .identity-error text{display:block;font-size:22rpx;line-height:1.5}
.screen button.button-hover{transform:translateY(2rpx);filter:brightness(.97)}
@media(max-width:340px){.screen{padding-left:24rpx;padding-right:24rpx}.screen .screenshot-choice{padding:22rpx 18rpx}.screen .choice-title{font-size:28rpx}.screen .knowledge-cover-art{width:135rpx;height:145rpx}.screen .coach-arrow{padding:8rpx 10rpx}}
