.screen{min-height:100vh;box-sizing:border-box;padding:28rpx 28rpx calc(55rpx + env(safe-area-inset-bottom));background:linear-gradient(150deg,#f9fcff,#f0f8fc 60%,#f8fafc);color:#29475c;font-family:"PingFang SC","Microsoft YaHei",sans-serif}
.hero{position:relative;overflow:hidden;min-height:258rpx;box-sizing:border-box;padding:30rpx 28rpx;border:1rpx solid #fff;border-radius:28rpx;background:#f2f9fd;box-shadow:0 12rpx 30rpx rgba(74,128,151,.05)}.hero-art{position:absolute;inset:0;width:100%;height:100%;opacity:.68}.hero-copy{position:relative;z-index:1}.hero-brand{display:flex;align-items:center;gap:10rpx;font-size:24rpx;color:#176b89}.hero-brand image{width:38rpx;height:38rpx}.title{display:block;margin-top:35rpx;color:#2d5c76;font-size:42rpx;font-weight:650;letter-spacing:-1rpx}.sub{display:block;margin-top:18rpx;color:#176b89;font-size:24rpx;line-height:1.7}
.mode-card,.status-card,.transcript{margin-top:24rpx;padding:26rpx;border:1rpx solid #d1e3ee;border-radius:24rpx;background:rgba(255,255,255,.87);box-shadow:inset 0 1rpx 0 #fff,0 10rpx 28rpx rgba(62,116,142,.045)}.mode-title{display:block;margin-bottom:20rpx;color:#385f77;font-size:26rpx;font-weight:600}.mode-options{display:flex;gap:15rpx}.mode-option{flex:1;min-width:0;margin:0;padding:22rpx 14rpx;border:1rpx solid #d1e1eb;border-radius:18rpx;background:#fafdff;color:#176b89;font-size:25rpx;font-weight:600;line-height:1.55}.mode-option.selected{border-color:#83bad0;background:linear-gradient(135deg,#f2fbff,#e0f1f9);color:#526579;box-shadow:inset 0 1rpx 0 #fff}.mode-option text{display:block;margin-top:7rpx;color:#176b89;font-size:24rpx;font-weight:400}.memory-select{padding:21rpx 23rpx;border:1rpx solid #c8dfeb;border-radius:16rpx;background:#fafdff;color:#3e6c85;font-size:27rpx;font-weight:550}.hint,.privacy{display:block;margin-top:17rpx;color:#176b89;font-size:24rpx;line-height:1.65}.status-card{text-align:center;padding:39rpx 30rpx;background:radial-gradient(ellipse at 50% 0,#e4f5fc,transparent 75%),rgba(255,255,255,.86)}.pulse{display:flex;align-items:center;justify-content:center;width:100rpx;height:100rpx;margin:12rpx auto 0;border:2rpx solid #fff;border-radius:50%;background:linear-gradient(140deg,#fff,#d8eff8);box-shadow:inset 0 2rpx 5rpx #fff,0 12rpx 25rpx rgba(79,142,171,.15),0 0 0 16rpx rgba(211,235,246,.35)}.pulse image{width:52rpx;height:52rpx}.pulse.live{animation:voice-breathe 2.8s ease-in-out infinite}.status{display:block;margin-top:33rpx;color:#346a84;font-size:30rpx;font-weight:600}.line{display:flex;flex-direction:column;gap:10rpx;margin-bottom:25rpx;color:#34596f;font-size:28rpx;line-height:1.7;overflow-wrap:anywhere}.line:last-child{margin-bottom:0}.speaker{color:#176b89;font-size:24rpx;font-weight:650}.start,.end{display:flex;align-items:center;justify-content:center;min-height:94rpx;margin-top:26rpx;padding:20rpx;border-radius:18rpx;color:#fff;font-size:28rpx;font-weight:650;line-height:1.5}.start{background:linear-gradient(135deg,#4497b0,#2d7d98);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.4),0 8rpx 20rpx rgba(54,124,151,.16)}.end{background:#b4705d}.error{display:block;margin-top:22rpx;padding:20rpx;border:1rpx solid #ead4c7;border-radius:16rpx;background:#fff5ed;color:#79572e;font-size:24rpx;line-height:1.6}.consent{display:flex;align-items:flex-start;gap:6rpx;margin-top:24rpx;color:#176b89;font-size:24rpx;line-height:1.65}.consent checkbox{flex:none;transform:scale(.8);transform-origin:top left}.memory-consent{margin-top:18rpx}.billing-note{display:flex;flex-direction:column;gap:9rpx;margin-top:25rpx;padding:22rpx 25rpx;border:1rpx solid #d6e7ef;border-radius:18rpx;background:rgba(240,249,253,.82);color:#176b89;font-size:24rpx;line-height:1.65}.billing-title{color:#176b89;font-size:25rpx;font-weight:600}.fallback{display:flex;align-items:center;justify-content:center;min-height:88rpx;margin-top:16rpx;border:1rpx solid #c8dfea;border-radius:17rpx;background:#fff;color:#526579;font-size:26rpx}.privacy{text-align:center;margin-top:26rpx;font-size:24rpx}button::after{border:0}button:active{opacity:.82}button[disabled]{opacity:.5}
@keyframes voice-breathe{0%,100%{transform:scale(1);box-shadow:inset 0 2rpx 5rpx #fff,0 12rpx 25rpx rgba(79,142,171,.15),0 0 0 16rpx rgba(211,235,246,.35)}50%{transform:scale(1.04);box-shadow:inset 0 2rpx 5rpx #fff,0 16rpx 30rpx rgba(79,142,171,.19),0 0 0 24rpx rgba(211,235,246,.2)}}
@media(prefers-reduced-motion:reduce){.pulse.live{animation:none}}

/* Readable daylight type: distinct headings, body, and supporting text. */
.hero{min-height:285rpx}.hero-brand{font-size:24rpx;color:#36566e}.title{font-size:48rpx;color:#203249;font-weight:650;line-height:1.45}.sub{font-size:26rpx;color:#425a6f;line-height:1.8}.mode-title{font-size:30rpx;color:#203249;line-height:1.6}.mode-option{font-size:28rpx;color:#36566e}.mode-option.selected{color:#155e7a}.mode-option text{font-size:24rpx;color:#526579;line-height:1.7}.memory-select{font-size:28rpx;color:#29485f}.hint,.privacy{font-size:25rpx;color:#526579;line-height:1.8}.status{font-size:35rpx;color:#244f67;font-weight:650}.line{font-size:29rpx;line-height:1.85;color:#203249}.speaker{font-size:24rpx;color:#425a6f;font-weight:550}.consent{font-size:25rpx;line-height:1.85;color:#425a6f}.billing-note{font-size:25rpx;line-height:1.85;color:#425a6f}.billing-title{font-size:28rpx;color:#244f67}.start{background:linear-gradient(135deg,#176f8c,#155d78);color:#fff;font-size:29rpx}.end{background:#9a4e3b;color:#fff;font-size:29rpx}.fallback{font-size:27rpx;color:#155e7a}.error{font-size:25rpx;color:#98472f;line-height:1.8}

/* Final shared phone contrast layer. */
@import "../../styles/phone-contrast.wxss";
