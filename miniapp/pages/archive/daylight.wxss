/* Approved daylight glass design; page-scoped to preserve native interactions. */
.screen{font-family:"PingFang SC","Microsoft YaHei","Noto Sans SC",sans-serif;padding:32rpx 30rpx 180rpx;background:radial-gradient(ellipse at 100% 0%,#e1f1f8 0,transparent 55%),#f6f9fc;color:#203249}
.screen .hero,.person-header{position:relative;overflow:hidden;box-sizing:border-box;padding:42rpx 36rpx;border:1rpx solid #d2e5ef;border-radius:34rpx;background:linear-gradient(125deg,#fff,#e7f3f9);box-shadow:inset 0 2rpx 0 #fff,0 20rpx 55rpx rgba(74,121,151,.07)}
.screen .hero{min-height:340rpx}.screen .hero-copy{position:relative;z-index:1;max-width:580rpx}.archive-scene{position:absolute;right:0;top:0;width:100%;height:100%;opacity:.55;pointer-events:none;animation:daylight-drift 14s ease-in-out infinite alternate}
.screen .hero .title{font-size:43rpx;line-height:1.45;color:#203249;letter-spacing:-1rpx;margin-top:18rpx;font-weight:700}.screen .hero .sub{font-size:24rpx;line-height:1.85;color:#176b89;max-width:440rpx;margin-top:20rpx}.screen .eyebrow,.person-kicker{font-size:24rpx;letter-spacing:2rpx;color:#526579}.screen .eyebrow:before{content:'';display:inline-block;width:8rpx;height:8rpx;margin-right:12rpx;border-radius:50%;background:#409ebc;box-shadow:0 0 0 6rpx rgba(101,186,214,.12);vertical-align:middle}
.screen .panel{padding:32rpx;margin-top:26rpx;border:1rpx solid #d9e6ee;border-radius:28rpx;background:rgba(255,255,255,.86);box-shadow:inset 0 2rpx 0 #fff,0 12rpx 36rpx rgba(61,102,131,.04);backdrop-filter:blur(18px);animation:daylight-enter .35s ease-out both}.screen .heading{color:#263d52;font-size:30rpx;font-weight:650}.screen .muted,.screen .sub{color:#176b89}.screen .muted{font-size:24rpx;line-height:1.8}
.screen .primary,.screen .person-chat,.screen .confirm-all,.screen .create button{background:linear-gradient(135deg,#2585a2,#176f8e);border-color:#237d98;color:#fff;box-shadow:0 8rpx 22rpx rgba(46,125,152,.14)}.screen .primary,.screen .light,.screen .danger{border-radius:18rpx;min-height:86rpx;font-weight:550}.screen .light{background:#f3f9fc;border-color:#ccdfeb;color:#3c6076}.screen .danger{background:#fff3ed;border-color:#eccfc2;color:#a54e39}.screen .error{color:#a54e39}.screen .first-consent{color:#176b89;border-color:#dfe9ef}
.person-header{padding:30rpx}.person-back{position:relative;z-index:1;margin:0 0 28rpx;padding:8rpx 0;min-height:55rpx;border:0;background:transparent;color:#526579}.person-heading{position:relative;z-index:1;align-items:center;gap:16rpx}.person-identity{display:flex;align-items:center;gap:20rpx;min-width:0;flex:1}.person-name{min-width:0;flex:1}.person-title{font-size:37rpx;color:#203249;line-height:1.4;margin-top:8rpx;font-weight:700}.profile-avatar{box-sizing:border-box;width:80rpx;height:92rpx;flex:none;padding:0;border:1rpx solid #c7e1ec;border-radius:22rpx;background:#e5f3f8}.avatar-initial{display:flex;align-items:center;justify-content:center;color:#526579;font-size:40rpx;background:linear-gradient(135deg,#f5fcff,#cce7f1)}.person-chat{border-radius:16rpx;padding:14rpx 18rpx;font-size:24rpx}.detail-navigation{position:relative;z-index:1;margin-top:34rpx;background:rgba(255,255,255,.6);border-color:#d4e7ef;border-radius:18rpx}.detail-navigation button{color:#176b89}.detail-navigation button.active{background:#e0f2f8;color:#166f8d;box-shadow:inset 0 2rpx 0 #fff;border:1rpx solid #c3e2ed}.archive-create{margin-top:24rpx}
.pending-strip{border-color:#d9e7eb;background:#edf8fb;color:#526579;border-radius:18rpx}.screen .fact-card{border-color:#cfe4ed;border-left-color:#8ac9df;background:#f1f9fc;border-radius:18rpx}.screen .fact-value{color:#29445a}.screen .fact-person,.screen .fact-evidence{color:#176b89}.screen .fact-actions button:first-child{background:#217f9d;color:#fff;border-radius:13rpx}.screen .fact-actions button:last-child{background:#e9f2f7;color:#516e84;border-radius:13rpx}.screen .accepted-fact{border-color:#d5e6ed;background:#f2f9fc;color:#365970;border-radius:18rpx}
.screen .archive-overview{padding:26rpx 0;background:transparent;border-color:#dce8ef}.overview-kicker,.subject-kicker{color:#526579}.overview-title{color:#203249}.overview-stats{gap:12rpx}.overview-stats>view{padding:23rpx 19rpx;border:1rpx solid #d0e5ef;border-radius:22rpx;background:linear-gradient(135deg,#e7f5fb,#f6fbfd);min-width:0}.overview-stats>view+view{padding-left:19rpx;border-color:#d0e5ef}.overview-stats>view:nth-child(2){background:linear-gradient(135deg,#eaf5f0,#f7fbf8);border-color:#d2e7dc}.overview-stats>view:nth-child(3){background:linear-gradient(135deg,#fff4e1,#fffbf5);border-color:#ecdec2}.overview-number{font-size:47rpx;color:#2b5873;font-weight:500}.overview-caption{font-size:24rpx;color:#176b89;line-height:1.8}.overview-stats>view:nth-child(3) .overview-caption{color:#79572e}
.screen .rank-panel{border:0;background:transparent;box-shadow:none;padding:0}.rank-tag{border:1rpx solid #c8e5ef;background:#eaf7fb;color:#526579;border-radius:8rpx}.rank-explain,.rank-meta{color:#176b89}.rank-row{border:1rpx solid #d1e4ee;border-radius:23rpx;background:rgba(255,255,255,.87);box-shadow:0 8rpx 24rpx rgba(67,111,139,.045);padding:24rpx 18rpx;grid-template-columns:28rpx 76rpx minmax(0,1fr) 94rpx;gap:12rpx}.rank-row:active{background:#eaf6fb;transform:translateY(-2rpx)}.rank-place{color:#176b89;font-weight:500}.person-avatar{height:87rpx;border-radius:20rpx;background:linear-gradient(135deg,#f4fbff,#cde7f2);border:1rpx solid #c9e1ec;color:#526579}.rank-row:nth-child(2n) .person-avatar{background:linear-gradient(135deg,#fffaf1,#f2e1c4);border-color:#ead9bb;color:#79572e}.rank-name{color:#294359;font-size:29rpx;font-weight:600}.rank-score{color:#176b89}.rank-score.scored{color:#526579;font-weight:500}.rank-detail{background:#e9f6fa;color:#526579;border-color:#c9e4ed;border-radius:12rpx;font-weight:550}.rank-track{background:#e0edf3}.rank-fill{background:linear-gradient(90deg,#469db7,#96cfdf)}.empty-archive-icon{display:block;margin:20rpx auto;width:100rpx;height:100rpx;padding:20rpx;border-radius:25rpx;background:#eaf5fa}.empty>text{display:block;text-align:center;line-height:1.9}
.screen .relationship-brief{background:rgba(255,255,255,.88);border:1rpx solid #d3e6ef;border-top:4rpx solid #9bcedf;color:#203249}.screen .relationship-brief .heading{color:#203249;font-size:30rpx;font-weight:650}.relationship-brief .overview-kicker,.relationship-brief .brief-label{color:#526579}.screen .relationship-brief .brief-stage{border-color:#c7e2ec;background:#edf8fb;color:#526579}.screen .relationship-brief .muted{color:#176b89}.brief-judgment{color:#25465e;font-size:34rpx}.brief-action{color:#3a596e}.brief-change{background:#eff8fb;border-left-color:#8ec8db;color:#41667c;border-radius:0 16rpx 16rpx 0}.screen .relationship-brief .primary{background:#217f9d;color:#fff;border-color:#217f9d}.relationship-brief .primary .button-icon{filter:brightness(0) invert(1)}.screen .relationship-brief .light{background:#f5fafc;border-color:#cbdfe9;color:#427086}.relationship-brief .section-link,.section-link{border-color:#dbe7ed;color:#48697d}.relationship-brief .section-link text:last-child,.section-link text:last-child{color:#526579}.disclosure-button{background:#eff8fb;border-color:#cbdfea;color:#526579;border-radius:16rpx}.reading-evidence{border-color:#97cddd}
.screen .fit-overview,.screen .self-profile-card,.screen .subject-overview,.screen .action-feedback-panel{border-top:3rpx solid #a6d5e5;border-left:1rpx solid #d7e7ef}.fit-score{font-size:56rpx;font-weight:500;color:#526579}.fit-verdict{color:#29485f}.fit-dimension{border-color:#dce9ef}.chart-empty{background:#f0f8fb;color:#176b89;border:1rpx solid #d8e9f0;border-radius:18rpx}.profile-item,.subject-overview .profile-item{border-color:#dde9ef}.profile-label{color:#176b89;font-size:24rpx}.profile-value{color:#36566e;font-size:27rpx}.profile-subtitle,.profile-memory-line,.profile-memory-block,.signal-chart{border-color:#dce8ef;color:#3f677e}.screen .subject-actions button{background:#23819e;border:1rpx solid #23819e;color:#fff;border-radius:14rpx}.screen .subject-actions button+button{background:#f4fafc;border-color:#c9e0eb;color:#526579}.subject-edit-toggle{background:#eef7fb;border:1rpx solid #cbdfe9;color:#526579;border-radius:14rpx}.self-avatar{padding:0;background:#edf6fb}.profile-status,.subject-title{color:#3a6a83}.subject-signal{border-color:#dae8ef;color:#4d6e83}.subject-signal text:last-child{color:#526579}.chart-title{color:#326b85}.signal-label{color:#176b89}.signal-value{color:#526579}.signal-track,.trend-track{background:#e1eef4}.signal-fill,.trend-fill.current{background:linear-gradient(90deg,#3f9eb9,#86c9dc)}.trend-fill{background:#aacfdc}.trend-caption{border-color:#dce9ef}.trend-caption text:first-child{color:#526579}
.screen input,.screen textarea{border-color:#c9dee9;background:#ffffffd9;color:#29465e;border-radius:16rpx;font-family:inherit}.screen .field-label{color:#4d7086}.screen .self-section{color:#526579;border-color:#dde9ef}.input-placeholder,.textarea-placeholder{color:#176b89}.management-entry,.retained{border-color:#dce8ef;color:#176b89}.create input{border-color:#c5dfe9}.profile-empty{background:#f0f8fb;color:#176b89}
.action-kicker{color:#526579}.feedback-card{border-color:#dce9ef}.feedback-status{background:#eaf5fa;color:#176b89}.feedback-status.positive,.feedback-status.alternative{background:#e9f5ef;color:#3b7865}.feedback-status.declined,.feedback-status.uncomfortable{background:#fff0e9;color:#a2563e}.feedback-date,.feedback-history text{color:#176b89}.feedback-action,.feedback-event-action{color:#29485f}.feedback-review{background:#eff8f7;border-color:#a1d3c8;color:#3a6d64}.feedback-note{color:#176b89}.feedback-controls button{background:#237f9d;border-color:#237f9d;border-radius:14rpx}.feedback-controls .feedback-subtle{background:#f4fafc;border-color:#cee1eb;color:#176b89}.feedback-source-toggle{background:#eef8fb;border-color:#cae2ec;color:#526579;border-radius:14rpx}.feedback-source{background:#f1f8fc;border-color:#9bcfe0;color:#486d83}.feedback-source-label{color:#526579}.feedback-editor{background:#f3f9fc;border-color:#cce2ed;border-radius:23rpx}.feedback-options button{background:#fff;border-color:#cce1ec;color:#416b80;border-radius:15rpx}.feedback-options button.selected{background:#237f9d;color:#fff}.feedback-date-row picker{border:1rpx solid #cce2ec;background:#fff;color:#446d81}.feedback-date-row button{background:#e7f3f8;color:#176b89}.feedback-history{border-color:#c9e1eb}.feedback-event-date{color:#176b89}.feedback-event-body{border-color:#98cdde}.timeline-days text{background:#eaf6fb;color:#526579}
@keyframes daylight-enter{from{opacity:0;transform:translateY(12rpx)}to{opacity:1;transform:translateY(0)}}@keyframes daylight-drift{from{transform:scale(1)}to{transform:scale(1.035)}}
@media(max-width:360px){.screen{padding-left:24rpx;padding-right:24rpx}.screen .hero{padding:36rpx 28rpx}.screen .hero .title{font-size:40rpx}.person-header{padding:26rpx}.person-heading{gap:12rpx}.person-title{font-size:33rpx}.person-identity{gap:14rpx}.profile-avatar{width:68rpx;height:80rpx}.person-chat{padding:12rpx;font-size:24rpx}.overview-stats{gap:9rpx}.overview-stats>view,.overview-stats>view+view{padding:21rpx 14rpx}.overview-caption{font-size:24rpx}.rank-row{grid-template-columns:26rpx 66rpx minmax(0,1fr) 90rpx;gap:9rpx}.person-avatar{width:66rpx;height:80rpx}.screen .rank-panel{padding:0}}
@media(prefers-reduced-motion:reduce){.screen .panel,.screen .fact-card,.archive-scene{animation:none;transition:none}}
