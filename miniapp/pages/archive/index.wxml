<view class="screen">
  <busy-indicator wx:if="{{phase === 'loading' || busy || eventDateBusy}}" label="{{phase === 'loading' ? '读取档案' : '保存资料中'}}"/>
  <view wx:if="{{selectedId}}" class="person-header page-scene-detail">
    <image class="archive-scene" src="/assets/page-scenes/{{archiveTab === 'self' ? 'self' : 'archive'}}.png" mode="aspectFit" aria-hidden="true"/>
    <button class="person-back" bindtap="returnToList">返回人物列表</button>
    <view class="person-heading"><view class="person-identity"><image wx:if="{{selectedAvatar}}" class="profile-avatar" src="{{selectedAvatar}}" mode="aspectFill"/><view wx:else class="profile-avatar avatar-initial">{{selectedLabel[0]}}</view><view class="person-name"><text class="person-kicker">人物详情</text><text class="person-title">{{selectedLabel}}</text></view></view><button class="person-chat" bindtap="openSelectedChat"><image src="../../assets/icon-chat.png"></image>问军师</button></view>
    <view class="detail-navigation"><button data-section="overview" class="{{detailSection === 'overview' ? 'active' : ''}}" bindtap="switchDetailSection">关系概览</button><button data-section="profile" class="{{detailSection === 'profile' ? 'active' : ''}}" bindtap="switchDetailSection">人物资料</button><button data-section="trend" class="{{detailSection === 'trend' ? 'active' : ''}}" bindtap="switchDetailSection">互动趋势</button></view>
  </view>
  <view wx:if="{{!selectedId}}" class="hero archive-hero page-scene-archive"><image class="archive-scene" src="/assets/page-scenes/{{archiveTab === 'self' ? 'self' : 'archive'}}.png" mode="aspectFit" aria-hidden="true"/><view class="hero-copy"><text class="eyebrow">{{archiveTab === 'self' ? '关于我' : '关系档案'}}</text><text class="title">{{archiveTab === 'self' ? '我的资料与相处偏好' : '每段关系，接着了解。'}}</text><text class="sub">{{archiveTab === 'self' ? '补充自己的期待，让建议更贴近你。' : '看最近进展，也记住相处中的细节。'}}</text></view></view>
  <view wx:if="{{phase === 'loading'}}" class="panel muted">正在读取档案…</view>
  <view wx:elif="{{phase === 'error'}}" class="panel"><text class="error">{{error}}</text><button class="primary" bindtap="refresh">重试</button></view>
  <block wx:else>
    <button wx:if="{{enabled && !paused && (archiveTab === 'self' || selectedId)}}" class="light" bindtap="toggleAvatar">{{showAvatarPicker ? '收起头像选择' : '选择 / 更换头像 →'}}</button>
    <avatar-picker wx:if="{{showAvatarPicker && enabled && !paused && (archiveTab === 'self' || selectedId)}}" self="{{archiveTab === 'self'}}" subject-id="{{selectedId}}" current="{{archiveTab === 'self' ? selfAvatar : selectedAvatar}}" bind:saved="refresh"/>
    <button wx:if="{{enabled && archiveTab !== 'self' && !selectedId && !paused}}" class="primary archive-create" bindtap="openManualCreate"><image class="button-icon" src="../../assets/icon-people.png"></image>新建人物</button>
    <view wx:if="{{!enabled && archiveTab === 'self'}}" class="panel self-onboarding"><text class="heading">{{selfHasContent ? '重新启用我的资料' : '先从你自己开始'}}</text><text class="muted">{{selfHasContent ? '启用后，已保存的资料会重新用于关系建议。' : '基础信息和相处偏好都可选填，也可以稍后导入自己的资料截图。'}}</text><checkbox-group bindchange="firstConsentChange"><label class="first-consent"><checkbox value="yes" checked="{{firstConsent}}" color="#965a42"/><text>同意启用关系档案，保存我主动填写和确认的资料。可随时暂停或删除。</text></label></checkbox-group><button class="primary" bindtap="enableSelfOnly" disabled="{{busy}}">{{busy ? '正在启用…' : '启用并填写我的资料'}}</button><button wx:if="{{selfHasContent}}" class="light" bindtap="wipe" disabled="{{busy}}">删除全部档案与报告</button></view>
    <view wx:if="{{!enabled && archiveTab !== 'self'}}" class="panel people-onboarding"><text class="heading">{{hasSubjects ? '档案已停止使用' : '先记住一位想了解的人'}}</text><text class="muted">{{hasSubjects ? '已有资料暂时保留，重新启用后可继续使用。' : '用称呼或代号建档，之后可以接着补充。'}}</text>
      <block wx:if="{{!hasSubjects}}"><input class="first-name" value="{{label}}" maxlength="60" placeholder="例如：小林 / 周末认识的人" placeholder-style="color:#756960" bindinput="labelInput"/><checkbox-group bindchange="firstConsentChange"><label class="first-consent"><checkbox value="yes" checked="{{firstConsent}}" color="#965a42"/><text>同意启用关系档案，保存我主动填写和确认的资料。可随时暂停或删除。</text></label></checkbox-group><button class="primary" bindtap="createFirst" disabled="{{busy}}">{{busy ? '正在建立…' : '启用并建立人物档案'}}</button></block>
      <button wx:else class="primary" bindtap="enable" disabled="{{busy}}">重新同意并启用</button>
    </view>
    <view wx:if="{{!enabled && hasSubjects && archiveTab !== 'self'}}" class="panel"><text class="heading">暂存的人物</text><view wx:for="{{subjects}}" wx:key="id" class="retained"><text>{{item.label}}</text><text wx:if="{{item.notes}}" class="muted">{{item.notes}}</text></view><button class="danger" bindtap="wipe" disabled="{{busy}}">删除全部档案与报告</button></view>
    <block wx:if="{{enabled}}">
      <view class="archive-shortcuts"><button bindtap="openPeopleEntry">人物档案</button><button bindtap="openComparisonEntry">人物对照</button><button bindtap="openSelfEntry">快速认识我</button></view>
      <quick-self-profile wx:if="{{archiveTab === 'self' && !paused}}" id="quick-self" value="{{selfProfile}}" owner="{{profileSessionKey}}" disabled="{{paused}}" busy="{{busy}}" bind:save="saveQuickSelf"/>
      <view wx:if="{{paused}}" class="panel archive-paused"><text class="heading">档案已暂停</text><text class="muted">恢复后可继续补充资料，并用于关系建议。</text><button class="primary" bindtap="pause" disabled="{{busy}}">恢复使用档案</button></view>
      <view wx:if="{{eventDateOpen && eventDateSelection === selectedId && eventDateTab === archiveTab}}" id="event-date-editor" class="panel feedback-editor">
        <text class="heading">更正聊天日期</text><text class="muted">{{eventDateQuote}}</text><text class="feedback-date">当前日期：{{eventDateOriginal || '未明确'}}；修改不会覆盖截图原始来源。</text>
        <view class="feedback-date-row"><picker mode="date" value="{{eventDateValue}}" bindchange="eventDateChange" disabled="{{eventDateBusy || paused}}"><view>{{eventDateValue || '选择聊天日期'}}</view></picker><button bindtap="clearEventDate" disabled="{{eventDateBusy || paused}}">日期未知</button></view>
        <button class="primary" bindtap="saveEventDate" disabled="{{eventDateBusy || busy || paused}}">{{eventDateBusy ? '正在保存…' : '保存日期'}}</button><button class="light" bindtap="closeEventDate" disabled="{{eventDateBusy}}">取消</button><text wx:if="{{eventDateError}}" class="error">{{eventDateError}}</text>
      </view>
      <view wx:if="{{selectedId && detailSection === 'overview'}}" id="selected-subject" class="panel relationship-brief">
        <text class="overview-kicker">关系概览</text><text class="heading">这段关系，现在怎么看</text><text class="brief-stage">{{selectedStage || (selectedSignal && selectedSignal.stage) || '关系阶段待了解'}}</text>
        <text wx:if="{{selectedSignal && selectedSignal.summary}}" class="brief-judgment">{{selectedSignal.summary}}</text><text wx:else class="muted">{{selectedCompatibility && selectedCompatibility.fitSummary ? selectedCompatibility.fitSummary : '还没有可用的互动判断，可以先补充最近的聊天。'}}</text>
        <view wx:if="{{selectedRecentChange}}" class="brief-change"><text class="brief-label">{{selectedRecentLabel}} · {{selectedRecentDate}}</text><text>{{selectedRecentChange}}</text></view>
        <text class="brief-label">建议下一步</text><text class="brief-action">{{selectedSignal && selectedSignal.nextStep ? selectedSignal.nextStep : '补充最近的聊天或见面反馈，让判断跟上真实进展。'}}</text>
        <view class="brief-actions"><button class="primary" bindtap="openSelectedChat"><image class="button-icon" src="../../assets/icon-chat.png"></image>继续问军师</button><button class="light" bindtap="openSelectedSocial" disabled="{{paused}}">补充 TA 的资料</button></view>
        <button class="section-link" data-section="trend" bindtap="switchDetailSection"><text>查看互动六维与历史变化</text><text>进入趋势 →</text></button>
      </view>
      <button wx:if="{{hasPendingFacts}}" class="pending-strip" bindtap="togglePendingReview"><text>{{pendingFacts.length}} 条资料待确认</text><text>{{showPendingReview ? '收起' : '核对资料 →'}}</text></button>
      <view wx:if="{{hasPendingFacts && showPendingReview}}" class="panel"><view class="pending-heading"><view><text class="heading">核对并保存资料</text><text class="muted">核对后保存到对应档案。</text></view><button class="confirm-all" bindtap="confirmAll" disabled="{{busy || paused}}">一键确认全部</button></view><view wx:for="{{visiblePendingFacts}}" wx:key="id" class="fact-card"><text class="fact-person">{{item.subjectLabel}} · {{item.source}}</text><text wx:if="{{item.eventTitle}}" class="fact-evidence">{{item.eventTitle}} · {{item.eventDate ? '聊天日期 ' + item.eventDate : '聊天日期待确认'}}</text><button wx:if="{{item.eventTitle}}" class="feedback-source-toggle" data-id="{{item.id}}" bindtap="openEventDate" disabled="{{eventDateBusy || busy || paused}}">更正聊天日期</button><text class="fact-value">{{item.displayValue}}</text><text wx:if="{{item.evidence}}" class="fact-evidence">出处：{{item.evidence}}</text><view class="fact-actions"><button data-id="{{item.id}}" data-decision="accept" bindtap="factDecision" disabled="{{busy || paused}}">确认这条</button><button data-id="{{item.id}}" data-decision="reject" bindtap="factDecision" disabled="{{busy || paused}}">忽略</button></view></view><button wx:if="{{hasMorePending}}" class="light" bindtap="togglePending">{{showAllPending ? "收起其余线索" : "展开全部待确认线索"}}</button></view>
      <view wx:if="{{archiveTab !== 'self' && !selectedId && !comparisonOnly}}" class="archive-overview">
        <view class="overview-heading"><text class="overview-kicker">档案总览</text><text class="overview-title">眼下在了解谁？</text></view>
        <view class="overview-stats"><view><text class="overview-number">{{subjects.length}}</text><text class="overview-caption">人物档案</text></view><view><text class="overview-number">{{rankedCount}}</text><text class="overview-caption">有完整互动线索</text></view><view><text class="overview-number">{{pendingFacts.length}}</text><text class="overview-caption">待核对线索</text></view></view>
      </view>
      <view wx:if="{{archiveTab !== 'self' && !selectedId && !comparisonOnly}}" class="panel rank-panel"><view class="rank-heading"><text class="heading">人物列表</text><text class="rank-tag">互动信号排行</text></view><text class="rank-explain">点击人物继续了解；分数仅供对照已有互动。</text>
         <view wx:for="{{rankedSubjects}}" wx:key="id" class="rank-row" data-id="{{item.id}}" bindtap="openSubjectDetail"><text class="rank-place">{{item.rankLabel}}</text><image wx:if="{{item.avatar}}" class="person-avatar" src="{{item.avatar}}" mode="aspectFill"/><view wx:else class="person-avatar">{{item.avatarText}}</view><view class="rank-person"><text class="rank-name">{{item.label}}</text><text class="rank-meta">{{item.estimated ? '互动估算 · 可继续补充聊天' : item.comparable ? '六维互动参考' : item.signal ? '片段不足，暂不参与排行' : '还没有可用聊天分析'}}</text><view wx:if="{{item.comparable}}" class="rank-track"><view class="rank-fill" style="width:{{item.barWidth}}"></view></view></view><text class="rank-score {{item.comparable ? 'scored' : ''}}">{{item.scoreText}}</text><button class="rank-detail" data-id="{{item.id}}" catchtap="openSubjectDetail">详情 →</button></view>
        <view wx:if="{{!hasSubjects}}" class="muted empty"><image class="empty-archive-icon" src="/assets/icon-people.png"/><text>还没有人物档案。</text><text>先给 TA 一个称呼，再慢慢补充。</text></view>
      </view>
      <view wx:if="{{archiveTab !== 'self' && !selectedId}}" class="panel comparison-panel">
        <view class="comparison-heading"><view><text class="comparison-kicker">同一把尺，慢慢了解</text><text class="heading">人物对照</text></view><button class="comparison-toggle" bindtap="toggleComparison">{{showComparison ? '收起对照' : '开始对照'}}</button></view>
        <text class="comparison-note">选 2–3 位人物，按你的期待逐项看资料与依据。</text>
        <block wx:if="{{showComparison}}">
          <text class="comparison-note">免费查看已有资料。片段互动与完整记录分别标明，资料多少不代表谁更合适。</text>
          <text class="comparison-label">选择人物 · {{comparison.count}} / 3</text>
          <view class="comparison-choices"><button wx:for="{{comparison.choices}}" wx:key="id" class="comparison-choice {{item.selected ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="changeComparison" disabled="{{item.disabled}}" aria-label="{{item.label + (item.selected ? '，已选择' : '，未选择')}}"><text>{{item.selected ? '✓ ' : '+ '}}{{item.label}}</text></button></view>
          <text wx:if="{{comparison.count === 3}}" class="comparison-note">最多同时对照 3 位；取消一位后可以换人。</text>
          <text wx:if="{{!comparison.ready}}" class="comparison-empty">还需选择 {{2 - comparison.count}} 位人物。缺少的资料会显示“未提供”。</text>
          <block wx:else>
            <view class="comparison-preferences"><text class="comparison-label">记得自己的期待</text><view wx:for="{{comparison.preferences}}" wx:key="key" class="comparison-preference"><text>{{item.label}}</text><text>{{item.value}}</text></view></view>
            <button class="comparison-detail-toggle" bindtap="toggleComparisonDetails">{{comparisonDetailed ? '收起基础资料与六项适配依据' : '展开基础资料与六项适配依据'}}</button>
            <text class="comparison-note">左右滑动查看 · 按已选顺序展示，不生成综合排名</text>
            <scroll-view scroll-x class="comparison-scroll" enhanced show-scrollbar="{{true}}"><view class="comparison-grid" style="width:{{comparisonWidth}}">
              <view class="comparison-row comparison-table-head"><view class="comparison-key">对照项目</view><view wx:for="{{comparison.people}}" wx:key="id" class="comparison-cell"><button class="comparison-person" data-id="{{item.id}}" bindtap="openComparisonPerson">{{item.label}} ↗</button><text class="comparison-source">{{item.updated}}</text></view></view>
              <block wx:for="{{comparison.rows}}" wx:for-item="row" wx:key="key"><view wx:if="{{comparisonDetailed || !row.detail}}" class="comparison-row"><view class="comparison-key">{{row.label}}</view><view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="personId" class="comparison-cell {{cell.caution ? 'comparison-caution' : ''}}"><text class="comparison-value">{{cell.text}}</text><text wx:if="{{cell.source}}" class="comparison-source">{{cell.source}}</text><button wx:if="{{cell.reportId}}" class="comparison-report" data-id="{{cell.reportId}}" bindtap="openComparisonSource">查看分析依据 →</button></view></view></block>
            </view></scroll-view>
          </block>
        </block>
      </view>
      <view wx:if="{{archiveTab === 'self'}}" class="panel self-profile-card">
        <view class="profile-card-heading"><image class="profile-avatar self-avatar" src="{{selfAvatar || '../../assets/icon-self.png'}}" mode="aspectFill"></image><view class="profile-card-name"><text class="heading">我的基础资料</text><text class="muted">{{selfKnownCount ? '已填写 ' + selfKnownCount + ' 项，可随时修改' : '从愿意分享的资料开始，全部选填'}}</text></view></view>
        <view class="subject-actions"><button bindtap="toggleSelfEditor" disabled="{{busy || paused}}">{{showSelfEditor ? "收起编辑" : selfHasContent ? "编辑我的资料" : "填写我的资料"}}</button><button bindtap="openSelfScreenshot" disabled="{{busy || paused}}">导入资料截图</button></view>
        <view class="profile-grid"><view wx:for="{{selfBasics}}" wx:key="label" class="profile-item"><text class="profile-label">{{item.label}}</text><text class="profile-value">{{item.value}}</text></view></view>
        <text class="chart-title profile-subtitle">相处偏好</text><view class="profile-grid"><view wx:for="{{selfPreferences}}" wx:key="label" class="profile-item"><text class="profile-label">{{item.label}}</text><text class="profile-value">{{item.value}}</text></view></view>
        <view wx:if="{{hasSelfFacts}}" class="profile-memory-line"><text>已确认资料</text><text>{{selfFacts.length}} 条</text></view>
      </view>
      <button wx:if="{{archiveTab === 'self'}}" class="light" bindtap="editSelfPreferences" disabled="{{busy || paused}}">填写 / 修改相处偏好 →</button>
      <view wx:if="{{archiveTab === 'self' && hasSelfFacts}}" class="panel self-memory"><text class="heading">我的已确认资料</text><text class="muted">保留来源，方便核对和更新。</text><view wx:for="{{visibleSelfFacts}}" wx:key="id" class="accepted-fact"><text>{{item.displayValue}}</text><text class="muted">{{item.source}} · {{item.evidence}}</text><button class="light" data-id="{{item.id}}" bindtap="deleteFact" disabled="{{busy || paused}}">删除这条</button></view><button wx:if="{{hasMoreSelfFacts}}" class="light" bindtap="toggleSelfMemory">{{showSelfMemory ? '收起其余资料' : '查看全部 ' + selfFacts.length + ' 条资料'}}</button></view>
      <view wx:if="{{archiveTab === 'self' && selfMomentsReport && !paused}}" class="panel"><template is="momentsReport" data="{{report:selfMomentsReport,archiveView:true,showDetails:showMomentsDetails,showTimeline:showMomentsTimeline}}"/><button class="light" data-target="self" bindtap="deleteMoments">删除这份朋友圈报告</button></view>
      <block wx:for="{{subjects}}" wx:key="id">
        <view wx:if="{{selectedId === item.id && item.communicationReading && !paused && detailSection === 'overview'}}" class="panel moments-report">
          <view class="moments-heading"><image src="/assets/icon-people.png"/><text>人物相处评价</text></view><text class="moments-evidence">基于已归档材料的推测，可结合新表现继续核对。</text>
          <view wx:for="{{item.communicationReading.hypotheses}}" wx:for-item="finding" wx:for-index="findingIndex" wx:key="title" class="moments-insight"><text class="moments-title">{{finding.title}}</text><text>{{finding.possibility}}</text><text wx:if="{{finding.verify}}" class="moments-support">{{finding.verify}}</text><button class="disclosure-button" data-index="{{findingIndex}}" bindtap="toggleReadingEvidence" aria-expanded="{{readingExpanded[findingIndex]}}">{{readingExpanded[findingIndex] ? '收起依据与其他解释' : '查看依据与其他解释'}}</button><view wx:if="{{readingExpanded[findingIndex]}}" class="reading-evidence"><text class="moments-evidence">依据 · {{finding.evidence}}</text><text class="moments-alternative">另一种可能 · {{finding.alternative}}</text></view></view>
          <template wx:if="{{!item.momentsReport}}" is="communicationApproach" data="{{approach:item.communicationReading.approach}}"/><button class="light" data-id="{{item.id}}" bindtap="deleteReading">删除这份相处评价</button>
        </view>
        <view wx:if="{{selectedId === item.id && item.momentsReport && !paused && detailSection === 'overview'}}" class="panel"><template is="momentsReport" data="{{report:item.momentsReport,archiveView:true,hideFindings:item.communicationReading,showDetails:showMomentsDetails,showTimeline:showMomentsTimeline}}"/><button class="light" data-id="{{item.id}}" bindtap="deleteMoments">删除这份朋友圈报告</button></view>
      </block>
      <view wx:if="{{selectedId && !paused && detailSection === 'overview'}}" class="panel action-feedback-panel">
        <view class="action-heading"><view><text class="action-kicker">跟着真实聊天更新</text><text class="heading">{{automaticUpdate.headline || '新聊天，接着上次分析'}}</text></view><image src="../../assets/icon-chat.png" class="feedback-icon"></image></view>
        <text wx:if="{{feedbackLoading}}" class="muted">正在读取行动记录…</text>
        <view wx:if="{{automaticUpdate.current}}" class="automatic-summary"><text class="brief-label">这次重点 {{automaticUpdate.current.date}}</text><text>{{automaticUpdate.current.summary}}</text><view wx:if="{{automaticUpdate.previous}}"><text class="brief-label">之前的材料 {{automaticUpdate.previous.date}}</text><text>{{automaticUpdate.previous.summary}}</text></view><view wx:for="{{automaticUpdate.changes}}" wx:key="label"><text class="brief-label">{{item.label}}</text><text>{{item.text}}</text></view></view>
        <text class="muted">{{automaticUpdate.note || '补充同一人物的新聊天，会自动对照已有材料。'}}不必重复填写后续。</text><button class="primary" bindtap="openSelectedQuick">补充新聊天</button>
        <button wx:if="{{hasCorrectionCards}}" class="light" bindtap="toggleManualFeedback">{{showManualFeedback?'收起历史记录':'查看或更正已保存记录'}}</button>
        <block wx:if="{{showManualFeedback || feedbackOpen}}">
        <view wx:for="{{correctionCards}}" wx:key="reportId" class="feedback-card">
          <view class="feedback-card-heading"><text class="feedback-status {{item.latest.outcome}}">{{item.outcomeLabel}}</text><text class="feedback-date">{{item.dateLabel ? '建议记录于 ' + item.dateLabel : '历史建议'}}</text></view>
          <text class="feedback-action">{{item.action}}</text>
          <button class="feedback-source-toggle" data-report-id="{{item.reportId}}" bindtap="toggleActionSource" aria-expanded="{{item.sourceExpanded}}">{{item.sourceExpanded ? '收起建议来源 ↑' : '查看当时判断与建议来源 ↓'}}</button>
          <view wx:if="{{item.sourceExpanded}}" class="feedback-source">
            <block wx:if="{{item.sourceAvailable}}"><text class="feedback-source-label">当时的判断</text><text>{{item.sourceSummary}}</text><text class="feedback-date">{{item.sourceEventStart ? '材料日期：' + item.sourceEventStart + (item.sourceEventEnd && item.sourceEventEnd !== item.sourceEventStart ? ' 至 ' + item.sourceEventEnd : '') : '材料发生日期未明确'}}</text></block>
            <text wx:else>原判断摘要已不在当前历史中；这里保留原建议和你的反馈，不补写旧结论。</text>
          </view>
          <view wx:if="{{item.latest}}" class="feedback-review"><text>{{item.latest.review}}</text><text wx:if="{{item.latest.note}}" class="feedback-note">我的反馈：{{item.latest.note}}</text><text class="feedback-date">{{item.latest.eventDate ? '发生于 ' + item.latest.eventDate : '发生日期未填'}} · 反馈记录于 {{item.feedbackDateLabel}}</text></view>
          <view class="feedback-controls"><button data-report-id="{{item.reportId}}" bindtap="openFeedback" disabled="{{feedbackBusy}}">{{item.latest ? '更新结果' : '记录结果'}}</button><button wx:if="{{item.latest}}" class="feedback-subtle" data-report-id="{{item.reportId}}" bindtap="toggleFeedbackHistory">{{historyReportId === item.reportId ? '收起历史' : '反馈历史'}}</button><button wx:if="{{item.latest}}" class="feedback-subtle" data-report-id="{{item.reportId}}" bindtap="deleteFeedback" disabled="{{feedbackBusy}}">删除反馈</button></view>
          <view wx:if="{{historyReportId === item.reportId}}" class="feedback-history"><view wx:for="{{item.revisions}}" wx:for-item="revision" wx:key="id"><text>{{revision.dateLabel}} · {{revision.revisionOf ? '更新反馈' : '首次反馈'}}</text><text>{{revision.review}}</text><text wx:if="{{revision.note}}">{{revision.note}}</text></view></view>
        </view>
        <view wx:if="{{feedbackOpen}}" class="feedback-editor">
          <text class="heading">更正已保存记录</text><text class="muted">{{feedbackAction}}</text>
          <text wx:if="{{!feedbackDetails}}" class="muted">点选即记下，之后可以修改</text>
          <view wx:if="{{!feedbackDetails}}" class="feedback-options"><button data-value="not_done" bindtap="quickFeedbackOutcome" disabled="{{feedbackBusy}}">还没行动</button><button data-value="positive" bindtap="quickFeedbackOutcome" disabled="{{feedbackBusy}}">有进展</button><button data-value="waiting" bindtap="quickFeedbackOutcome" disabled="{{feedbackBusy}}">还在等回应</button><button data-value="uncomfortable" bindtap="quickFeedbackOutcome" disabled="{{feedbackBusy}}">让我不舒服</button></view>
          <button class="light" bindtap="toggleFeedbackDetails" disabled="{{feedbackBusy}}">{{feedbackDetails ? '收起详情' : '其他结果 / 补充详情（选填）'}}</button>
          <block wx:if="{{feedbackDetails}}">
          <view class="feedback-options"><button wx:for="{{feedbackOptions}}" wx:key="value" class="{{feedbackOutcome === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="feedbackOutcomeChange" disabled="{{feedbackBusy}}">{{item.label}}</button></view>
          <textarea value="{{feedbackNote}}" maxlength="500" placeholder="补充一句发生了什么（选填）" bindinput="feedbackNoteInput" disabled="{{feedbackBusy}}"></textarea>
          <view class="feedback-date-row"><picker mode="date" value="{{feedbackEventDate}}" bindchange="feedbackDateChange" disabled="{{feedbackBusy}}"><view>{{feedbackEventDate || '实际发生日期（选填）'}}</view></picker><button wx:if="{{feedbackEventDate}}" bindtap="clearFeedbackDate" disabled="{{feedbackBusy}}">清空</button></view>
          <button class="primary" bindtap="saveFeedback" disabled="{{feedbackBusy}}">{{feedbackBusy ? '正在保存…' : '记下这次结果'}}</button>
          </block><text wx:if="{{feedbackBusy && !feedbackDetails}}" class="muted">正在记下…</text><button class="light" bindtap="closeFeedback" disabled="{{feedbackBusy}}">暂时跳过</button>
        </view>
        </block><text wx:if="{{feedbackError}}" class="error">{{feedbackError}}</text><button wx:if="{{feedbackError && !feedbackOpen}}" class="light" bindtap="retryActionCards">重试读取</button>
      </view>
      <view wx:if="{{selectedId && selectedCompatibility && detailSection === 'overview'}}" class="panel fit-overview"><text class="heading">{{selectedLabel}} · 与你的适配参考</text><text class="fit-score">{{selectedCompatibility.fitScore == null ? "资料待补充" : selectedCompatibility.fitScore + " / 100"}}</text><text class="muted">可计分资料 {{selectedCompatibility.coverage || 0}} / 6 项</text><text class="fit-verdict">{{selectedCompatibility.fitSummary}}</text><canvas wx:if="{{hasFitRadar}}" canvas-id="personFitRadar" style="width:300px;height:270px" width="300" height="270"></canvas><view wx:else class="chart-empty"><text>暂时没有可绘制的适配数据</text><text class="muted">补充年龄、城市和关系期待等资料后，再看六项对照。</text><button class="light" bindtap="openSelectedSocial" disabled="{{paused}}">补充 TA 的资料</button></view><button class="light" bindtap="toggleFitDetails" aria-expanded="{{showFitDetails}}">{{showFitDetails ? '收起六项解读' : '查看六项适配解读'}}</button><block wx:if="{{showFitDetails}}"><view wx:for="{{selectedCompatibility.fit}}" wx:key="dimension" class="fit-dimension"><text class="chart-title">{{item.dimension}} · {{item.status}}</text><text>{{item.conclusion}}</text></view></block></view>
      <view wx:if="{{selectedId && detailSection === 'profile'}}" class="panel subject-overview"><view class="profile-card-heading"><view><text class="subject-kicker">人物档案 · 详细资料</text><text class="subject-title">{{selectedLabel}}</text></view><text class="profile-status">{{hasSelectedBasics || hasSelectedFacts || hasSelectedPendingFacts ? '已有资料' : '待补资料'}}</text></view><text class="muted">已确认资料在这里，缺少的项目可随时补充。</text><view wx:if="{{hasSelectedBasics}}" class="profile-grid subject-grid"><view wx:for="{{selectedBasics}}" wx:key="label" class="profile-item"><text class="profile-label">{{item.label}}</text><text class="profile-value">{{item.value}}</text></view></view><button wx:if="{{hasSelectedFacts}}" class="light" bindtap="togglePersonEvidence">{{showPersonEvidence ? "收起资料依据" : "查看已确认资料与出处"}}</button><view wx:if="{{hasSelectedFacts && showPersonEvidence}}" class="profile-memory-block"><text class="chart-title">已确认资料</text><view wx:for="{{selectedFacts}}" wx:key="id" class="profile-fact"><text>{{item.value}}</text><text class="muted">{{item.source}} · {{item.evidence}}</text></view></view><view class="subject-signal"><text>最近互动参考</text><text>{{selectedSignal && selectedSignal.score != null ? selectedSignal.score + '/100' : '信息不足，暂不评分'}}</text><text wx:if="{{selectedSignal && selectedSignal.estimated}}" class="muted">基于当前可见聊天的估算，补充更多记录后会更新。</text></view><view wx:if="{{hasSelectedChart}}" class="signal-chart"><text class="chart-title">互动信号图表</text><view wx:for="{{selectedChart}}" wx:key="label" class="signal-row"><text class="signal-label">{{item.label}}</text><view class="signal-track"><view class="signal-fill" style="width:{{item.width}}%"></view></view><text class="signal-value">{{item.valueText}}</text></view></view><view wx:if="{{!hasSelectedBasics && !hasSelectedFacts && !hasSelectedPendingFacts && !hasSelectedChart}}" class="profile-empty">还没有足够的资料或互动信号，先从聊天和资料截图中补充。</view><view class="subject-actions"><button bindtap="openSelectedSocial">补充资料图</button><button wx:if="{{selectedSignal && selectedSignal.reportId}}" bindtap="openSelectedReport">看分析依据</button></view><button class="subject-edit-toggle" bindtap="toggleSubjectEditor">{{showSubjectEditor ? '收起编辑' : '编辑这位人物'}} →</button></view>
      <view wx:if="{{selectedId && !paused && detailSection === 'trend' && hasFeedbackEvents}}" class="panel action-feedback-panel">
        <text class="action-kicker">聊天与行动</text><text class="heading">关系进展记录</text>
        <view wx:for="{{visibleFeedbackEvents}}" wx:key="id" class="feedback-event">
          <text class="feedback-event-date">{{item.eventDate || '日期未填'}}{{item.dateKind ? '\n' + item.dateKind : ''}}</text>
          <view class="feedback-event-body"><text class="feedback-status {{item.outcome}}">{{item.title}}</text><text class="feedback-event-action">{{item.action}}</text><text wx:if="{{item.note}}" class="feedback-note">{{item.note}}</text><text class="feedback-date">{{item.source}}{{item.revisionCount > 1 ? ' · 已更新结果' : ''}}</text><button wx:if="{{item.outcome === 'conversation'}}" class="feedback-source-toggle" data-id="{{item.id}}" bindtap="openEventDate" disabled="{{eventDateBusy}}">更正聊天日期</button></view>
        </view>
        <button wx:if="{{hasMoreFeedbackEvents}}" class="light" bindtap="toggleFeedbackEvents">{{showAllFeedbackEvents ? '收起历史进展' : '查看全部进展'}}</button>
      </view>
      <view wx:if="{{selectedId && detailSection === 'trend'}}" class="panel hex-chart-panel"><text class="heading">互动六维</text><canvas wx:if="{{hasInteractionRadar}}" canvas-id="personInteractionRadar" style="width:300px;height:270px" width="300" height="270"></canvas><text wx:if="{{hasInteractionRadar}}" class="muted">缺少记录的维度显示待了解，不按零分计算。</text><view wx:else class="chart-empty"><text>还没有可对照的互动记录</text><text class="muted">带上一段最近的聊天，看看主动、回应和邀约等信号。</text><button class="primary" bindtap="openSelectedChat">找军师聊聊</button></view></view>
      <view wx:if="{{selectedId && hasSelectedTrend && detailSection === 'trend'}}" class="panel trend-chart">
        <text class="heading">{{selectedLabel}} · 互动变化</text><text class="muted">按聊天日期对照，重复内容合并展示。</text>
        <canvas wx:if="{{hasTrendChart}}" canvas-id="relationshipTrend" style="width:300px;height:200px" width="300" height="200"></canvas><text wx:else class="chart-empty">还没有日期和分数都明确的记录，已有材料保留在下方。</text>
        <view wx:for="{{selectedTrend}}" wx:key="reportId" class="trend-caption">
          <text>{{item.dateLabel || item.label}} · {{item.score == null ? "待了解" : item.score + "/100"}}</text>
          <text>{{item.summary || "可结合对应的聊天分析查看依据。"}}</text>
          <text wx:if="{{item.changeSummary}}">{{item.changeSummary}}</text>
          <text wx:if="{{item.dayBreakdownLabel}}">{{item.dayBreakdownLabel}}</text>
          <view wx:if="{{item.eventDayCount > 1}}" class="timeline-days"><text wx:for="{{item.eventDays}}" wx:for-item="day" wx:key="date">{{day.date}} · {{day.messageCount}} 条消息</text></view>
          <text wx:if="{{item.eventDayCount > 31}}">分日明细仅展示前 31 个日期</text>
          <text wx:if="{{item.undatedMessageCount}}">另有 {{item.undatedMessageCount}} 条消息的日期未明确</text>
          <text class="muted">保存于 {{item.recordedDateLabel}}{{item.sourceReportIds.length > 1 ? ' · 重复内容已合并' : ''}}</text>
        </view>
      </view>
       <view wx:if="{{archiveTab === 'self' && showSelfEditor}}" id="self-profile-editor" class="panel self-profile">
        <text class="heading">编辑我的资料</text><text class="muted">全部选填，按你的实际情况填写。</text>
        <text class="self-section">基础信息 · 选填</text>
        <view class="base-grid">
          <view class="base-field"><text class="field-label">年龄或年龄段</text><input value="{{self.ageRange}}" maxlength="100" data-field="ageRange" bindinput="selfInput" placeholder="例如：29 岁"/></view>
          <view class="base-field"><text class="field-label">常住城市</text><input value="{{self.city}}" maxlength="100" data-field="city" bindinput="selfInput" placeholder="例如：杭州"/></view>
          <view class="base-field"><text class="field-label">学历</text><input value="{{self.education}}" maxlength="100" data-field="education" bindinput="selfInput" placeholder="按需填写"/></view>
          <view class="base-field"><text class="field-label">职业或学习状态</text><input value="{{self.occupation}}" maxlength="100" data-field="occupation" bindinput="selfInput" placeholder="按需填写"/></view>
          <view class="base-field"><text class="field-label">当前婚恋状态</text><input value="{{self.relationshipStatus}}" maxlength="100" data-field="relationshipStatus" bindinput="selfInput" placeholder="例如：单身"/></view>
          <view class="base-field"><text class="field-label">婚育想法</text><input value="{{self.childrenPlan}}" maxlength="100" data-field="childrenPlan" bindinput="selfInput" placeholder="按需填写"/></view>
        </view>
        <text class="field-label">生活节奏与习惯</text><input value="{{self.lifestyle}}" maxlength="100" data-field="lifestyle" bindinput="selfInput" placeholder="例如：作息规律、周末喜欢户外"/>
        <text id="self-preferences-editor" class="self-section">相处偏好 · 选填</text>
        <view class="base-grid">
          <view class="base-field"><text class="field-label">希望的年龄范围</text><input value="{{self.preferredAgeRange}}" maxlength="100" data-field="preferredAgeRange" bindinput="selfInput" placeholder="不介意可留空"/></view>
          <view class="base-field"><text class="field-label">异地接受程度</text><input value="{{self.distancePreference}}" maxlength="100" data-field="distancePreference" bindinput="selfInput" placeholder="例如：接受周边城市"/></view>
        </view>
        <text class="field-label">想要怎样的关系</text><textarea value="{{self.preferredRelationship}}" maxlength="800" data-field="preferredRelationship" bindinput="selfInput" placeholder="想填再填，不影响基础资料对照" auto-height></textarea>
        <text class="field-label">最在意的事</text><textarea value="{{self.values}}" maxlength="800" data-field="values" bindinput="selfInput" placeholder="例如：诚实、沟通、生活节奏" auto-height></textarea>
        <text class="field-label">不能接受的事</text><textarea value="{{self.boundaries}}" maxlength="800" data-field="boundaries" bindinput="selfInput" placeholder="例如：隐瞒婚恋状态" auto-height></textarea>
        <text class="field-label">眼下的目标</text><textarea value="{{self.goals}}" maxlength="800" data-field="goals" bindinput="selfInput" placeholder="例如：先了解，再决定是否见面" auto-height></textarea>
        <button class="primary" bindtap="saveSelf" disabled="{{busy || paused}}">保存我的资料</button><text wx:if="{{selfSaved}}" class="muted">已保存，可随时修改。</text>
      </view>
      <view wx:if="{{archiveTab !== 'self' && !selectedId && !paused}}" class="quick-create-panel"><button class="section-link" bindtap="toggleQuickCreate" aria-expanded="{{showQuickCreate}}"><text>只记下一个称呼</text><text>{{showQuickCreate ? '收起' : '快速添加 →'}}</text></button>
        <view wx:if="{{showQuickCreate}}" class="create"><input value="{{label}}" maxlength="60" placeholder="人物称呼或代号" placeholder-style="color:#756960" bindinput="labelInput"/><button bindtap="create" disabled="{{busy}}">建立档案</button></view>
      </view>
      <view wx:if="{{archiveTab === 'self' && showSelfEditor}}" class="panel"><text class="heading">导入我的自我介绍</text><text class="muted">粘贴文字或上传截图，核对后再存入资料。</text><textarea value="{{selfText}}" maxlength="500" bindinput="selfTextInput" placeholder="粘贴自己写过的简介、关系期待或相处边界…" auto-height></textarea><button class="primary" bindtap="importSelfText" disabled="{{busy || paused}}">导入并核对</button><button class="light" bindtap="openSelfScreenshot" disabled="{{busy || paused}}">上传我的资料截图</button></view>
      <view wx:if="{{selectedId && detailSection === 'profile' && showSubjectEditor}}" id="subject-profile-editor" class="panel"><text class="heading">编辑这位人物</text><text class="muted">填写对方明确说过或你已确认的信息。</text><text class="field-label">称呼或代号</text><input value="{{selectedLabel}}" maxlength="60" bindinput="selectedLabelInput" placeholder="例如：小林"/><text class="field-label">认识方式与关系阶段</text><textarea value="{{selectedHowMet}}" maxlength="800" data-field="selectedHowMet" bindinput="subjectInput" placeholder="例如：朋友介绍；刚开始了解" auto-height></textarea><text class="field-label">目前明确的进展</text><textarea value="{{selectedStage}}" maxlength="800" data-field="selectedStage" bindinput="subjectInput" placeholder="例如：见过一次面；尚未确定关系" auto-height></textarea><text class="field-label">TA 明确表达过的期待或价值观</text><textarea value="{{selectedValues}}" maxlength="800" data-field="selectedValues" bindinput="subjectInput" placeholder="写原话或可核对的概述" auto-height></textarea><text class="field-label">TA 明确表达过的边界</text><textarea value="{{selectedBoundaries}}" maxlength="800" data-field="selectedBoundaries" bindinput="subjectInput" placeholder="例如：不接受临时约见；没说过就留空" auto-height></textarea><text class="field-label">我的备注与已确认经历</text><textarea value="{{selectedNotes}}" maxlength="800" bindinput="notesInput" placeholder="例如：我们上周约好周日见面。" auto-height></textarea><button class="primary" bindtap="save" disabled="{{busy || paused}}">保存这位人物</button><button class="light" bindtap="toggleSubjectEditor">收起编辑</button><button class="danger" bindtap="deleteSubject" disabled="{{busy}}">删除这位人物及关联报告</button></view>
      <view wx:if="{{selectedId && detailSection === 'profile' && showSubjectEditor && hasSelectedFacts}}" class="panel"><text class="heading">这位人物的已确认线索</text><view wx:for="{{selectedFacts}}" wx:key="id" class="accepted-fact"><text>{{item.value}}</text><text class="muted">{{item.source}} · {{item.evidence}}</text><button class="light" data-id="{{item.id}}" bindtap="deleteFact">删除这条</button></view></view>
      <button class="management-entry" bindtap="toggleManagement">{{showManagement ? '收起档案管理' : paused ? '档案已暂停 · 管理与恢复 →' : '档案管理与隐私 →'}}</button>
      <view wx:if="{{showManagement}}" class="panel"><text class="heading">档案管理</text><button class="light" bindtap="pause" disabled="{{busy}}">{{paused ? '恢复档案' : '暂停档案'}}</button><button class="light" bindtap="revoke" disabled="{{busy}}">撤回同意，暂保留已有资料</button><button class="danger" bindtap="wipe" disabled="{{busy}}">删除全部档案与报告</button></view>
    </block>
    <text wx:if="{{error}}" class="error">{{error}}</text>
  </block>
  <main-navigation wx:if="{{!selectedId}}" selected="{{archiveTab === 'self' ? 'me' : 'people'}}"/>
</view>
<import src="../../components/moments-report.wxml"/>
