/* Keep the short detail action on one readable line inside the score column. */
.rank-detail{justify-self:stretch;margin:0;padding:14rpx 4rpx;white-space:nowrap;word-break:keep-all;font-size:24rpx;min-height:72rpx;line-height:1.7}


/* Keep the comparison item readable while its people columns scroll horizontally. */
.comparison-key{position:-webkit-sticky;position:sticky;left:0;z-index:2;background:#edf5fa;box-shadow:6rpx 0 10rpx rgba(46,86,109,.06)}
.comparison-table-head .comparison-key{z-index:3;background:#e5f1f8}

