.library-screen{min-height:100vh;padding:32rpx 28rpx 210rpx;background:#fffaf4;color:#3c342f;box-sizing:border-box;font-family:"PingFang SC","Microsoft YaHei",sans-serif;line-height:1.7}.heading{padding:20rpx 8rpx 30rpx}.eyebrow,.subtitle,.title{display:block}.eyebrow{font-size:23rpx;color:#a06048;letter-spacing:2rpx}.title{font-size:44rpx;font-weight:650;line-height:1.4;margin:12rpx 0}.subtitle{font-size:26rpx;color:#816e62;overflow-wrap:anywhere}.panel{padding:28rpx;background:#fff;border:1rpx solid #eadbce;border-radius:22rpx;margin:18rpx 0}.panel>text{display:block;line-height:1.8}.section-title{font-size:32rpx;font-weight:650;margin-bottom:12rpx}.primary,.secondary,.text-button{font-size:26rpx;line-height:1.6;border-radius:16rpx;min-height:80rpx;padding:18rpx 24rpx}.primary{background:#b96d52;color:#fff;font-weight:650}.secondary{background:#fff;border:1rpx solid #ddc6b7;color:#91563f}.text-button{background:transparent;color:#8e6753;margin:0;padding:18rpx 12rpx}.panel .primary,.panel .secondary{margin-top:22rpx}.library-card{display:flex;align-items:center;gap:20rpx;text-align:left;padding:30rpx 26rpx;margin:16rpx 0;border-radius:22rpx;border:1rpx solid #eadbce;background:#fff;color:#3c342f;line-height:1.6}.library-card>view{flex:1;min-width:0}.library-card text{display:block}.library-name{font-size:34rpx;font-weight:650}.library-kind{margin-top:8rpx;color:#9c624b;font-size:27rpx}.small{display:block;color:#88776c;font-size:23rpx;line-height:1.7}.open-arrow{font-size:34rpx;color:#a76950}.library-toolbar,.selection-tools,.pagination{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.selection-tools{margin:25rpx 0 10rpx}.selection-tools .secondary{margin:0}.media-note{padding:20rpx 22rpx;background:#f6eee6;border-radius:16rpx;font-size:24rpx;color:#7d685c}.page-note{margin:14rpx 4rpx}.messages{margin-top:16rpx}.message{padding:20rpx 22rpx;margin:16rpx 0 16rpx 0;background:#fff;border:2rpx solid #eadbce;border-radius:20rpx}.message.from-self{margin-left:24rpx;background:#fbf1e8}.message.selected{border-color:#b96d52;box-shadow:0 0 0 2rpx #b96d5214}.message-top{display:flex;justify-content:space-between;gap:16rpx;font-size:23rpx;color:#8d7566;line-height:1.5;margin-bottom:12rpx}.message-top text:first-child{font-weight:650;max-width:40%;overflow-wrap:anywhere}.message-body{display:block;position:relative;margin:0;padding:4rpx 40rpx 4rpx 0;background:transparent;text-align:left;font-size:29rpx;color:#3c342f;line-height:1.8}.message-body[disabled]{opacity:1;color:#5d5047;background:transparent}.original-text{white-space:pre-wrap;overflow-wrap:anywhere}.check-mark{position:absolute;right:0;top:6rpx;color:#b96d52;font-size:28rpx}.type-label{display:block;font-size:23rpx;font-weight:600;color:#9b654e;margin-bottom:4rpx}.image-button{display:flex;align-items:center;gap:12rpx;background:#f7eee5;color:#86533d;font-size:25rpx;line-height:1.6;text-align:left;margin:16rpx 0 8rpx;padding:16rpx;border-radius:12rpx}.image-button image{width:30rpx;height:30rpx}.pagination{margin:26rpx 0}.pagination>text{color:#88776c}.pagination .secondary{flex:1}.guide{margin-top:30rpx;border:1rpx solid #e8d6c6;border-radius:20rpx;overflow:hidden}.guide-toggle{display:flex;align-items:center;gap:15rpx;background:#fbf0e5;padding:24rpx;text-align:left;font-size:26rpx;color:#74513e;line-height:1.6}.guide-toggle view{flex:1}.guide-toggle text{display:block}.guide-toggle view text:first-child{font-weight:650}.guide-toggle view text+text{font-size:23rpx;color:#927963;margin-top:6rpx}.guide-steps{padding:10rpx 24rpx 26rpx;font-size:25rpx}.guide-steps>text{display:block;margin:18rpx 0}.guide-key{font-weight:650;color:#9c5c41}.error,.notice{padding:22rpx;margin:18rpx 0;border:1rpx solid #dfbaa5;border-radius:16rpx;background:#fff4e9;color:#9b4b34;font-size:26rpx}.error text,.notice text{display:block}.error button{font-size:25rpx;background:transparent;color:#9b4b34;text-align:left;padding:10rpx 0;margin:0;line-height:1.6}.report-links{display:flex;align-items:center;gap:12rpx;overflow-x:auto;white-space:nowrap;padding:18rpx 0}.report-links>text{font-size:24rpx;color:#8b6f5d}.report-links button{flex:none;background:#f9eadd;color:#8f5a43;padding:12rpx 18rpx;border-radius:12rpx;font-size:24rpx;line-height:1.6;margin:0}.analysis-dock{position:fixed;bottom:0;left:0;right:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fffcf8f2;border-top:1rpx solid #e3ccba;display:flex;align-items:center;gap:20rpx;z-index:30;box-shadow:0 -8rpx 32rpx #89603c0a}.analysis-dock>view{flex:1;min-width:0}.analysis-dock>view text{display:block;font-size:29rpx;font-weight:600}.analysis-dock>view text+text{font-size:23rpx;font-weight:400;color:#8d7462}.analysis-dock .primary{margin:0;min-width:220rpx}.primary[disabled],.secondary[disabled],.text-button[disabled]{opacity:.5}

.entry-choices{display:flex;flex-direction:column;gap:18rpx;margin-bottom:24rpx}.entry-choices button{width:100%;text-align:left;padding:24rpx 28rpx;margin:0}.entry-choices button text{display:block;font-size:24rpx;font-weight:400;margin-top:8rpx;opacity:.85}.scope-summary{margin-top:25rpx}.scope-summary>text+text{font-size:26rpx;color:#816e62}
