.account-screen{min-height:100vh;box-sizing:border-box;padding:40rpx 34rpx 20rpx;background:radial-gradient(ellipse at 100% 0,#e5f3fa,transparent 48%),#f6f9fc;color:#203249;font-family:"PingFang SC","Microsoft YaHei",sans-serif}
.account-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:35rpx}.account-heading>view{flex:1}.account-heading>image{width:84rpx;height:84rpx}.eyebrow{display:block;font-size:24rpx;letter-spacing:2rpx;color:#176b89;line-height:1.5}.heading{display:block;margin:18rpx 0;font-size:44rpx;font-weight:650;line-height:1.3}.heading.small{font-size:33rpx;margin:0 0 13rpx}.account-intro{font-size:24rpx;line-height:1.8;color:#176b89}
.account-screen .profile-entry{display:flex;align-items:center;gap:22rpx;width:100%;box-sizing:border-box;margin:0;padding:28rpx;border:1rpx solid #bdd8e581;border-radius:23rpx;background:linear-gradient(145deg,#ffffffed,#edf7fbbe);box-shadow:inset 0 2rpx #fff,0 14rpx 35rpx #42748d0c;text-align:left;line-height:1.5;color:#315e78}.profile-entry image{width:49rpx;height:49rpx;flex:none}.profile-entry>view{flex:1}.profile-title{display:block;font-size:29rpx;font-weight:650}.profile-caption{display:block;margin-top:8rpx;font-size:24rpx;color:#176b89}
.section-title{display:flex;justify-content:space-between;gap:20rpx;font-size:31rpx;font-weight:600;margin:36rpx 0 17rpx;color:#31566f}.section-title text{font-weight:400;font-size:24rpx;color:#176b89}.balance-panel{position:relative;overflow:hidden;display:flex;justify-content:space-between;align-items:flex-end;padding:34rpx;border:1rpx solid #b4d4e381;border-radius:25rpx;background:linear-gradient(135deg,#e5f4fa,#ffffffdf);box-shadow:inset 0 2rpx #fff,0 12rpx 28rpx #42748d0b;color:#526579}.balance-panel .caption{color:#176b89}.balance{display:block;font-size:89rpx;font-weight:550;line-height:1.2}.balance-aside{font-size:24rpx;line-height:2;text-align:right;color:#176b89}.balance-aside text{display:block}.hold-explain{display:block;margin:16rpx 3rpx 0;color:#176b89;font-size:24rpx;line-height:1.8}
.details,.price-panel,.admin-panel,.contact-panel{margin-top:28rpx;padding:26rpx;border:1rpx solid #c5dbe671;border-radius:24rpx;background:#ffffffd9;box-shadow:inset 0 2rpx #fff,0 12rpx 32rpx #3f748b08}.details>text{display:block}.caption{display:block;font-size:24rpx;color:#176b89;line-height:1.8;margin:12rpx 0}.user-id{font-size:24rpx;word-break:break-all;color:#3e6c85}.price-panel .section-title{margin-top:0}.price-row{display:flex;justify-content:space-between;gap:16rpx;padding:18rpx 0;border-bottom:1rpx solid #d4e2ea80;font-size:24rpx;line-height:1.6}.price-row text:last-child{flex:none;color:#526579;font-weight:600}
button{box-sizing:border-box;min-height:84rpx;font-size:26rpx;margin:20rpx 0;border-radius:16rpx;line-height:1.6;padding:20rpx}.outline{background:#ffffffc2;border:1rpx solid #bdd6e2;color:#176b89;box-shadow:inset 0 2rpx #fff}.primary{background:linear-gradient(135deg,#4296ae,#267d95);border:1rpx solid #3489a3;color:#fff;box-shadow:inset 0 2rpx #ffffff66,0 9rpx 20rpx #4287a31a}.entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid #d1e2eb;font-size:26rpx;color:#43687f}.entry>view{max-width:78%}.amount{font-weight:600}.positive,.success{color:#2d6b60}.empty{display:block;color:#176b89;padding:30rpx 0;font-size:25rpx}
.notice{background:#edf7fb;border:1rpx solid #c4dfea;color:#176b89;padding:22rpx;font-size:24rpx;margin-top:24rpx;border-radius:18rpx;line-height:1.7}.error{background:#fff2ec;border:1rpx solid #ecc3b2;border-radius:18rpx;color:#a1583d;padding:22rpx;margin:20rpx 0;font-size:25rpx;line-height:1.7}.admin-error{display:block}.admin-panel{margin-top:38rpx}.admin-panel input{height:84rpx;border:1rpx solid #bcd4e3;padding:0 20rpx;font-size:26rpx;border-radius:13rpx;background:#f6fafddd;color:#315871}.admin-panel label{display:flex;align-items:center;padding:18rpx 0;font-size:27rpx;color:#176b89}.date-picker{padding:23rpx 0;border-bottom:1rpx solid #d1e2eb;font-size:26rpx;color:#176b89}.target-balance{display:block;font-size:30rpx;font-weight:600;color:#526579}.success{display:block;font-size:25rpx;padding:18rpx 0}.contact-heading{display:flex;align-items:flex-start;gap:19rpx}.contact-heading>image{width:42rpx;height:42rpx;margin-top:4rpx}.contact-heading>view{flex:1}.contact-heading .section-title{margin:0}.contact-wechat{display:block;color:#426f88;font-size:29rpx;font-weight:550;margin:12rpx 0}

/* Readable daylight type: distinct headings, body, and supporting text. */
.eyebrow{font-size:24rpx;color:#176b89;letter-spacing:1rpx}.heading{font-size:48rpx;font-weight:650;line-height:1.45}.heading.small{font-size:34rpx}.account-intro{font-size:27rpx;color:#425a6f;line-height:1.85}.profile-title{font-size:32rpx;color:#244f67}.profile-caption{font-size:25rpx;color:#526579;line-height:1.8}.section-title{font-size:33rpx;color:#203249;font-weight:650;line-height:1.6}.section-title text{font-size:24rpx;color:#526579}.balance{font-size:89rpx;color:#155e7a}.balance-panel .caption,.balance-aside{font-size:25rpx;color:#425a6f;line-height:1.8}.hold-explain,.caption{font-size:25rpx;color:#526579;line-height:1.85}.user-id{font-size:25rpx;line-height:1.8;color:#36566e}.price-row{font-size:27rpx;color:#29485f;line-height:1.7}.price-row text:last-child{color:#155e7a;font-weight:600}.entry{font-size:27rpx;line-height:1.7;color:#36566e}.positive,.success{color:#2d6b60}.primary{background:linear-gradient(135deg,#176f8c,#155d78);color:#fff;font-size:28rpx}.outline{color:#244f67;font-size:27rpx}.notice{font-size:26rpx;color:#36566e;line-height:1.8}.empty,.error{font-size:26rpx;line-height:1.8}.error{color:#98472f}.admin-panel input{font-size:28rpx;color:#203249}.admin-panel label,.date-picker{font-size:27rpx;color:#36566e}.contact-wechat{font-size:31rpx;color:#244f67;font-weight:600}.target-balance{font-size:32rpx;color:#155e7a}

/* Final shared phone contrast layer. */
@import "../../styles/phone-contrast.wxss";
