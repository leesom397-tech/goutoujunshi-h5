.chat-screen{min-height:100vh;box-sizing:border-box;padding:28rpx 28rpx calc(170rpx + env(safe-area-inset-bottom));background:linear-gradient(155deg,#f9fcff,#f2f8fc 58%,#f7fafc);color:#243c50;font-family:"PingFang SC","Microsoft YaHei",sans-serif}
.hero{position:relative;overflow:hidden;min-height:258rpx;padding:30rpx 26rpx;box-sizing:border-box;border:1rpx solid #fff;border-radius:28rpx;background:#f2f9fd;box-shadow:inset 0 1rpx 0 #fff,0 14rpx 32rpx rgba(72,125,151,.06)}
.hero-art{position:absolute;right:-40rpx;top:0;width:100%;height:100%;opacity:.76}.hero-copy{position:relative;z-index:1}.hero-brand{display:flex;align-items:center;gap:10rpx;font-size:24rpx;color:#176b89}.hero-brand image{width:38rpx;height:38rpx}.title{display:block;margin-top:23rpx;font-size:40rpx;font-weight:650;line-height:1.45;letter-spacing:-1rpx}.title-accent{display:block;color:#526579}.sub{display:block;margin-top:12rpx;font-size:24rpx;line-height:1.7;color:#176b89}
.panel,.composer,.followup-context{padding:26rpx;border:1rpx solid #d4e4ee;border-radius:24rpx;background:rgba(255,255,255,.86);box-shadow:inset 0 1rpx 0 #fff,0 10rpx 28rpx rgba(63,112,138,.045)}.panel{margin-top:24rpx}.conversation-toolbar{display:flex;flex-direction:column;gap:16rpx;margin:24rpx 0}.conversation-person{display:flex;align-items:center;gap:14rpx;min-height:92rpx;box-sizing:border-box;padding:20rpx 24rpx;border:1rpx solid #d4e4ee;border-radius:20rpx;background:rgba(255,255,255,.87);color:#355870;font-size:25rpx}.person-caption{font-size:24rpx;color:#176b89}.conversation-person text:last-child{margin-left:auto;color:#176b89}
.live-entry{display:flex;align-items:center;gap:20rpx;width:100%;margin:0;padding:23rpx 26rpx;border:1rpx solid #b8dce9;border-radius:22rpx;background:linear-gradient(130deg,#fff,#e6f3fa);color:#2a6c87;text-align:left;font-size:29rpx;font-weight:600;line-height:1.5;box-shadow:inset 0 1rpx 0 #fff,0 6rpx 18rpx rgba(63,112,138,.055)}.live-entry image{width:52rpx;height:52rpx}.live-entry>view{flex:1}.live-caption{display:block;margin-top:4rpx;color:#176b89;font-size:24rpx;font-weight:400}.live-arrow{font-size:29rpx;color:#176b89}.live-entry::after{border:0}
.conversation{min-height:0}.welcome,.bubble{position:relative;padding:26rpx;margin:24rpx 0;border:1rpx solid #dce9f1;border-radius:24rpx;background:rgba(255,255,255,.9);font-size:28rpx;line-height:1.7;overflow-wrap:anywhere}.welcome{overflow:hidden;margin-right:12rpx;padding-right:118rpx;min-height:124rpx;background:#f7fcff}.welcome>text{position:relative;z-index:1}.welcome-art{position:absolute;right:-58rpx;bottom:-32rpx;width:230rpx;height:190rpx;opacity:.45}.speaker-label{display:block;margin-bottom:10rpx;color:#176b89;font-size:24rpx;font-weight:650}.bubble-user{margin-left:58rpx;background:linear-gradient(140deg,#e4f2f9,#d9eef7);border-color:#c4e0ee;color:#2e536b;border-bottom-right-radius:8rpx}.bubble-assistant{margin-right:16rpx;border-bottom-left-radius:8rpx}.bubble-text{white-space:pre-wrap}.conversation-reply{margin-top:20rpx;padding:20rpx;border:1rpx solid #cfe2eb;border-left:4rpx solid #8dc2d6;border-radius:14rpx;background:#f2f9fc;font-size:26rpx}.reply-direction{display:block;margin-bottom:9rpx;color:#176b89;font-size:24rpx;font-weight:600}.copy-conversation-reply{min-height:76rpx;margin:18rpx 0 0;padding:15rpx;border:1rpx solid #bddbe8;border-radius:13rpx;background:#fff;color:#526579;font-size:24rpx;line-height:1.7}
.composer{margin-top:24rpx}.composer-heading{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-bottom:17rpx;font-size:27rpx;font-weight:650}.draft-note{font-size:24rpx;font-weight:400;color:#176b89}.composer textarea{box-sizing:border-box;width:100%;min-height:132rpx;padding:21rpx;border:1rpx solid #c9dfea;border-radius:16rpx;background:#fafdff;color:#244b61;font-size:28rpx;line-height:1.65}.consent{display:flex;align-items:flex-start;gap:5rpx;margin:22rpx 0;color:#176b89;font-size:24rpx;line-height:1.65}.consent checkbox{flex:none;transform:scale(.8);transform-origin:top left}.compose-actions{display:flex;gap:14rpx}.compose-actions button{display:flex;flex:1;align-items:center;justify-content:center;min-height:88rpx;box-sizing:border-box;margin:0;padding:16rpx 10rpx;border-radius:16rpx;font-size:25rpx;font-weight:600;line-height:1.5}.primary{display:flex;align-items:center;justify-content:center;min-height:88rpx;border:1rpx solid #3989a4;border-radius:16rpx;background:linear-gradient(135deg,#4497b0,#2c7b97);color:#fff;font-size:27rpx;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.4),0 7rpx 16rpx rgba(52,125,153,.14)}.voice-hold{border:1rpx solid #bed9e7;background:#edf7fc;color:#526579}.cost-note{display:block;margin-top:16rpx;color:#176b89;font-size:24rpx;line-height:1.65}.clear-draft{display:flex;align-items:center;justify-content:center;min-height:76rpx;margin:10rpx 0 0;padding:10rpx;background:transparent;color:#176b89;font-size:24rpx}.clear-draft::after{border:0}.error{display:block;margin-top:18rpx;padding:18rpx 20rpx;border:1rpx solid #ead5c8;border-radius:14rpx;background:#fff6ef;color:#79572e;font-size:24rpx;line-height:1.65}
.followup-context{margin:22rpx 0;background:#f0f8fc}.followup-context-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.followup-context-head>view{min-width:0}.followup-kicker{display:block;color:#176b89;font-size:24rpx}.followup-title{display:block;margin-top:8rpx;color:#355f78;font-size:29rpx;font-weight:600}.followup-context-head button{flex:none;margin:0;padding:0 18rpx;min-height:76rpx;line-height:76rpx;border:1rpx solid #c9dfeb;border-radius:14rpx;background:#fff;color:#176b89;font-size:24rpx}.followup-caption{display:block;margin-top:16rpx;color:#176b89;font-size:24rpx;line-height:1.6}.followup-summary{display:block;white-space:pre-wrap;margin-top:18rpx;color:#476b80;font-size:26rpx;line-height:1.75}
button[disabled]{opacity:.5}button::after{border:0}.primary:active,.voice-hold:active,.live-entry:active,.copy-conversation-reply:active{opacity:.82;transform:translateY(1rpx)}

/* Readable daylight type: distinct headings, body, and supporting text. */
.hero{min-height:295rpx}.hero-copy{max-width:100%}.hero-brand{font-size:24rpx;color:#36566e}.title{font-size:48rpx;font-weight:650;line-height:1.45;color:#203249}.title-accent{color:#176b89}.sub{font-size:26rpx;color:#425a6f;line-height:1.8}
.conversation-person{font-size:28rpx;color:#29485f;line-height:1.6}.person-caption,.live-caption{font-size:24rpx;color:#526579;line-height:1.75}.live-entry{font-size:30rpx;color:#244f67}.speaker-label,.reply-direction{font-size:24rpx;color:#425a6f;font-weight:550}.welcome,.bubble{font-size:29rpx;line-height:1.85;color:#203249}.bubble-user{color:#24475e}.conversation-reply{font-size:28rpx;line-height:1.85}.copy-conversation-reply{font-size:26rpx;color:#155e7a}.composer-heading{font-size:30rpx;flex-wrap:wrap;line-height:1.6}.draft-note{font-size:24rpx;color:#526579}.composer textarea{font-size:29rpx;line-height:1.8;color:#203249}.consent{font-size:25rpx;color:#425a6f;line-height:1.85}.cost-note,.followup-caption{font-size:25rpx;color:#526579;line-height:1.8}.clear-draft{font-size:25rpx;color:#425a6f}.compose-actions button{font-size:27rpx}.primary{background:linear-gradient(135deg,#176f8c,#155d78);color:#fff}.voice-hold{color:#244f67}.followup-kicker{font-size:24rpx;color:#176b89}.followup-title{font-size:31rpx;color:#203249}.followup-summary{font-size:27rpx;line-height:1.85;color:#36566e}.followup-context-head button{font-size:25rpx;color:#155e7a}.error{font-size:25rpx;color:#98472f;line-height:1.8}

/* Final shared phone contrast layer. */
@import "../../styles/phone-contrast.wxss";
