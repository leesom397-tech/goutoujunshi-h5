<view class="screen history-screen">
  <view class="history-heading"><text class="eyebrow">随时接着看</text><text class="title">历史报告</text><text class="description">报告持续保存，直到你主动删除。网页与小程序关联同一账户后可互相查看。</text></view>
  <view class="search-row"><input value="{{query}}" bindinput="editQuery" bindconfirm="search" confirm-type="search" maxlength="80" placeholder="搜人物称呼或报告内容" aria-label="搜索历史报告"/><button bindtap="search" disabled="{{loading}}">搜索</button></view>
  <view wx:if="{{activeQuery}}" class="query-state"><text>搜索：{{activeQuery}}</text><button bindtap="clearSearch" disabled="{{loading}}">查看全部</button></view>
  <view wx:if="{{loading}}" class="loading"><busy-indicator label="正在取回报告"/></view>
  <view wx:elif="{{error}}" class="state-card"><text>{{error}}</text><button bindtap="retry">重新读取</button></view>
  <block wx:else>
    <view class="list-heading"><text>共 {{total}} 份报告</text><text>从最近一次开始</text></view>
    <view wx:if="{{!webLinked}}" class="link-note"><text>还没看到网页报告？先关联你的网页账户。</text><button bindtap="openAccount">去账户关联 →</button></view>
    <view wx:if="{{!reports.length}}" class="state-card"><text class="empty-title">{{activeQuery ? '没有找到相关报告' : '还没有保存的报告'}}</text><text>{{activeQuery ? '试试人物称呼，或清空搜索查看全部。' : '完成一次分析后，就可以在这里继续阅读。'}}</text><button wx:if="{{!activeQuery}}" bindtap="startAnalysis">开始关系透视 →</button></view>
    <button wx:for="{{reports}}" wx:key="id" class="report-card" data-id="{{item.id}}" bindtap="openReport"><view class="report-meta"><text class="kind kind-{{item.kind}}">{{item.kindLabel}}</text><text>{{item.dateLabel}}</text></view><text class="report-title">{{item.summary}}</text><view class="report-footer"><text>{{item.label}}</text><text>继续阅读 →</text></view></button>
    <view wx:if="{{pages > 1}}" class="pagination"><button bindtap="previous" disabled="{{page <= 1}}">上一页</button><text>{{page}} / {{pages}}</text><button bindtap="next" disabled="{{page >= pages}}">下一页</button></view>
  </block>
</view>
