page{background:#fffaf4;color:#3f342e}.history-screen{padding:34rpx 28rpx 70rpx}.history-heading{padding:12rpx 2rpx 26rpx}.history-heading text{display:block}.eyebrow{font-size:24rpx;color:#9a6046}.title{font-size:42rpx;font-weight:650;line-height:1.6}.description{margin-top:10rpx;font-size:26rpx;line-height:1.75;color:#806b5e}.search-row{display:flex;gap:14rpx;align-items:center}.search-row input{flex:1;min-width:0;background:#fff;border:1rpx solid #e9d8ca;border-radius:16rpx;padding:22rpx;font-size:27rpx}.search-row button,.state-card button{margin:0;padding:18rpx 26rpx;border-radius:16rpx;background:#ab664e;color:#fff;font-size:27rpx;line-height:1.7}.query-state,.list-heading{display:flex;justify-content:space-between;align-items:center;gap:18rpx;margin:24rpx 0;color:#806b5e;font-size:24rpx}.query-state button,.link-note button{margin:0;background:transparent;color:#9b583f;font-size:25rpx;padding:10rpx}.link-note{padding:20rpx;border:1rpx solid #efdac6;border-radius:16rpx;background:#fff4e8;font-size:26rpx}.loading{padding:50rpx 0}.state-card{margin-top:24rpx;padding:36rpx;background:#fff;border:1rpx solid #e9d8ca;border-radius:20rpx;font-size:27rpx;color:#806b5e}.state-card text{display:block;margin-bottom:20rpx}.empty-title{font-weight:600;color:#49382e}.state-card button{margin-top:22rpx}.report-card{display:block;width:100%;box-sizing:border-box;margin:18rpx 0;padding:28rpx;background:#fff;border:1rpx solid #e8d8ca;border-radius:22rpx;text-align:left;line-height:1.7;box-shadow:0 8rpx 25rpx #b7825610}.report-meta,.report-footer{display:flex;gap:16rpx;justify-content:space-between;align-items:center;color:#8a7465;font-size:24rpx}.kind{padding:5rpx 14rpx;background:#fbede3;border-radius:10rpx;color:#995b42}.kind-moments{background:#edf5ef;color:#547b66}.kind-social{background:#f5f0e4;color:#8e7441}.report-title{display:block;margin:20rpx 0 22rpx;font-size:30rpx;font-weight:600;color:#3f342e;overflow-wrap:break-word;white-space:normal}.report-footer{border-top:1rpx solid #f0e5db;padding-top:18rpx}.report-footer text:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.report-footer text:last-child{flex-shrink:0;color:#9b583f}.pagination{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:28rpx;font-size:26rpx;color:#806b5e}.pagination button{margin:0;font-size:26rpx;background:#fff;border:1rpx solid #e8d8ca;color:#84573f;border-radius:14rpx;padding:16rpx 26rpx;line-height:1.7}
