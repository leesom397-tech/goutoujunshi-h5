.analysis-status{margin:24rpx 0;padding:30rpx;background:#fffcf7;border:1rpx solid #d6d1c7;border-top:5rpx solid #276d5b;border-radius:16rpx;font-family:"PingFang SC","Microsoft YaHei",sans-serif}
.analysis-status-heading{display:flex;gap:20rpx;align-items:center}.analysis-status-heading image{width:48rpx;height:48rpx;flex:none}.analysis-status-kicker{display:block;font-size:24rpx;color:#79572e;letter-spacing:2rpx}.analysis-status-title{display:block;margin-top:8rpx;font-size:30rpx;font-weight:750;line-height:1.4;color:#142633}
.analysis-status-note{display:block;margin-top:22rpx;font-size:26rpx;line-height:1.7;color:#52645b}.analysis-status-error{display:block;margin-top:18rpx;font-size:24rpx;line-height:1.6;color:#934f43}.analysis-status button{margin-top:24rpx;background:#276d5b;color:#fff;font-size:26rpx;border-radius:10rpx}.analysis-status button::after{border:0}
.analysis-stages{display:flex;align-items:center;justify-content:space-between;gap:8rpx;margin:26rpx 0 0;padding:18rpx 0;border-top:1rpx solid #e0e5de;border-bottom:1rpx solid #e0e5de}.analysis-stages>view{display:flex;align-items:center;gap:9rpx;font-size:24rpx;color:#526579;line-height:1.5}.stage-dot{width:13rpx;height:13rpx;flex:none;border:2rpx solid #aab4ae;border-radius:50%}.analysis-stages .current{font-weight:700;color:#142633}.current .stage-dot{background:#b59a68;border-color:#b59a68}.analysis-stages .done{color:#276d5b}.done .stage-dot{background:#276d5b;border-color:#276d5b}.stage-connector{font-size:24rpx;color:#526579}.analysis-status .analysis-cancel{min-height:84rpx;background:#f2f0eb;color:#52645b;border:1rpx solid #c9d1cb}.analysis-status-note{font-size:25rpx;line-height:1.6}.analysis-status button{min-height:88rpx;line-height:1.5;display:flex;align-items:center;justify-content:center;padding:20rpx}

/* Readable daylight type: distinct headings, body, and supporting text. */
.analysis-status{background:#f2f9fd;border-color:#c7dfe9;border-top-color:#448da7;border-radius:22rpx}.analysis-status-kicker{font-size:24rpx;color:#176b89;letter-spacing:1rpx}.analysis-status-title{font-size:33rpx;color:#203249;font-weight:650;line-height:1.5}.analysis-status-note{font-size:27rpx;color:#425a6f;line-height:1.8}.analysis-status-error{font-size:25rpx;color:#98472f;line-height:1.8}.analysis-stages{border-color:#d0e3ed;flex-wrap:wrap;row-gap:16rpx}.analysis-stages>view{font-size:24rpx;color:#526579}.analysis-stages .current{font-size:25rpx;color:#244f67;font-weight:650}.analysis-stages .done{color:#155e7a}.current .stage-dot,.done .stage-dot{background:#176b89;border-color:#176b89}.stage-connector{font-size:24rpx;color:#526579}.analysis-status button{font-size:28rpx;background:linear-gradient(135deg,#176f8c,#155d78);color:#fff}.analysis-status .analysis-cancel{font-size:26rpx;background:#fff;color:#36566e;border-color:#c7dfe9}
