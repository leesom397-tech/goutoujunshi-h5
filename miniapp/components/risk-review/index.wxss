.risk-review{background:#fffdf9;color:#362d27;padding:28rpx;border:1rpx solid #e5d5c6;border-radius:24rpx;margin:25rpx 0}.heading{display:flex;align-items:center;gap:14rpx;font-size:34rpx;font-weight:750}.heading image{width:36rpx;height:36rpx}.summary,.empty{display:block;font-size:28rpx;line-height:1.7;color:#716355;margin-top:16rpx}.signal{margin-top:24rpx;padding:24rpx;background:#fffbef;border:1rpx solid #ead9a8;border-left:6rpx solid #bb8c39;border-radius:18rpx}.signal.safety{background:#fff3ee;border-color:#e7b6a6;border-left-color:#a44e3a}.signal-heading{display:flex;align-items:flex-start;gap:14rpx}.icon{display:flex;align-items:center;justify-content:center;flex:none;width:39rpx;height:39rpx;border-radius:50%;background:#ede0ba;color:#74551c;font-weight:750}.safety .icon{background:#efd0c5;color:#8f3e2c}.kind,.title,.label,.evidence,.reading,.alternative{display:block}.kind{font-size:26rpx;color:#896c36}.safety .kind{color:#9d4c38}.title{font-size:31rpx;font-weight:700;line-height:1.6}.label{font-size:26rpx;font-weight:650;margin:18rpx 0 8rpx}.evidence,.reading,.action{font-size:29rpx;line-height:1.7}.evidence{padding:14rpx;background:#fff9;border-radius:12rpx}.reading{margin-top:18rpx}.alternative{font-size:27rpx;line-height:1.7;color:#7c6a5b;margin-top:14rpx}.action{margin-top:20rpx;border-top:1rpx solid #dfc9aa;padding-top:5rpx}
