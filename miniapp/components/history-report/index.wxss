.history{color:#302c29;font-size:30rpx;line-height:1.8}.history text{display:block}.hero{padding:40rpx 30rpx;border-radius:24rpx;background:linear-gradient(110deg,#fffaf5 20%,#fffaf5cc),url('/assets/aurora-fluted-light.jpg') right center/cover}.eyebrow,.muted{font-size:25rpx;color:#806d60}.title{font-size:42rpx;font-weight:650;line-height:1.5;margin:14rpx 0}.tabs,.subtabs{display:flex;gap:10rpx;margin:24rpx 0}.tabs button,.subtabs button{flex:1;margin:0;padding:16rpx 4rpx;font-size:27rpx;line-height:1.5;background:#f7eee7;color:#755847;border-radius:14rpx}.tabs .active,.subtabs .active{background:#ae6c51;color:white}.panel{padding:28rpx 0;border-bottom:1rpx solid #ead8ca}.heading{font-size:34rpx;font-weight:650;margin-bottom:14rpx}.finding{padding:20rpx 0;border-bottom:1rpx solid #eee2d7}.quote{border-left:4rpx solid #c38b71;padding:8rpx 20rpx;margin:14rpx 0;background:#faf1e8}.disclosure{padding:10rpx 0;color:#9c6049;background:transparent;font-size:26rpx;text-align:left;margin:0}.score{font-size:68rpx;color:#9c6049;font-weight:650}.row{display:flex;justify-content:space-between;gap:16rpx}.track{display:flex;height:14rpx;background:#eee4db;border-radius:8rpx;overflow:hidden;margin:10rpx 0}.self{background:#c18b72;height:100%}.other{background:#608577;height:100%}.chart{margin:18rpx 0}.month{margin:16rpx 0}.action{background:#fff3e9;padding:24rpx;border-radius:18rpx;margin:18rpx 0}.primary{background:#ad6c51;color:white;border-radius:16rpx;font-size:30rpx;padding:18rpx;margin-top:24rpx;line-height:1.5}.note{font-size:26rpx;color:#78685c;margin:14rpx 0}.history button::after{border:0}
