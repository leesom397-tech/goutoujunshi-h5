<template name="evidence"><view wx:for="{{findings}}" wx:key="id"><view wx:for="{{item.evidence}}" wx:for-item="source" wx:key="sourceId" class="quote"><text class="muted">{{source.who}} · {{source.kindLabel}} · {{source.at}}</text><text selectable>{{source.quote}}</text><button wx:if="{{source.libraryId}}" class="disclosure" data-library="{{source.libraryId}}" data-source="{{source.sourceId}}" bindtap="source">回到原始资料 →</button></view></view></template>
<template name="quotes"><view wx:for="{{quotes}}" wx:for-item="source" wx:key="sourceId" class="quote"><text class="muted">{{source.who}} · {{source.kindLabel}} · {{source.at}}</text><text selectable>{{source.quote}}</text><button wx:if="{{source.libraryId}}" class="disclosure" data-library="{{source.libraryId}}" data-source="{{source.sourceId}}" bindtap="source">回到原始资料 →</button></view></template>
<view wx:if="{{value}}" class="history">
 <view class="hero"><text class="eyebrow">{{value.momentsOnly ? value.other : '你与 '+value.other}} · {{value.scope.label}}</text><text class="title">{{value.summary}}</text><text>{{value.trend}}</text><text class="muted">{{value.scope.note}}</text><text class="muted">{{value.generatedTime ? '生成于 '+value.generatedTime : '这份旧报告未记录生成时间'}}</text><view wx:for="{{value.sources}}" wx:key="libraryId" class="source-count"><text class="muted">{{item.kind==='moments'?'朋友圈资料':'聊天记录'}} {{item.total}} 条 · 可读文字 {{item.textRead}} 条</text></view></view>
 <view wx:if="{{value.actionOverview}}" class="action overview-action"><text class="heading">{{value.momentsOnly?'从动态出发，可以怎么聊':'跟这个人相处，先做这一步'}}</text><text>{{value.actionOverview.action}}</text><text wx:if="{{value.actionOverview.why}}" class="note">{{value.actionOverview.why}}</text><view wx:if="{{value.actionOverview.reply}}" class="quote"><text class="muted">这一步可以这样说</text><text selectable>{{value.actionOverview.reply}}</text><button class="disclosure" data-text="{{value.actionOverview.reply}}" bindtap="copy">复制这句话</button></view><text wx:if="{{value.actionOverview.observeFor}}" class="note">观察：{{value.actionOverview.observeFor}}</text><text wx:if="{{value.actionOverview.stopWhen}}" class="note">重新判断的条件：{{value.actionOverview.stopWhen}}</text><button class="disclosure" data-key="firstAction" bindtap="toggle">{{expanded.firstAction?'收起依据':'核对这条建议的原话'}}</button><template wx:if="{{expanded.firstAction}}" is="quotes" data="{{quotes:value.actionOverview.evidence}}"/></view>
 <view wx:if="{{value.replies.length}}" class="panel saved-replies"><text class="heading">现在怎么回 · 选一句复制</text><view class="reply-filters"><button class="{{replyFilter===-1?'active':''}}" data-index="-1" bindtap="chooseReply">全部方案</button><button wx:for="{{value.replies}}" wx:key="text" class="{{replyFilter===index?'active':''}}" data-index="{{index}}" bindtap="chooseReply">{{item.style}}</button></view><view wx:for="{{value.replies}}" wx:key="text" hidden="{{replyFilter!==-1&&replyFilter!==index}}" class="reply-option"><text class="muted">{{index+1}} · {{item.style}}</text><text selectable class="reply-text">{{item.text}}</text><text wx:if="{{item.reason}}" class="note">{{item.reason}}</text><button class="copy-button" data-text="{{item.text}}" bindtap="copy">{{copiedText===item.text?'已复制':'复制这句'}}</button><button wx:if="{{item.evidence.length}}" class="disclosure" data-key="reply{{index}}" bindtap="toggle">查看依据</button><template wx:if="{{expanded['reply'+index]}}" is="quotes" data="{{quotes:item.evidence}}"/></view><text wx:if="{{copyError}}" class="note">{{copyError}}</text></view>
 <view wx:if="{{value.hasMoments&&!value.momentsOnly}}" class="moments-overview"><text class="heading">{{value.other}} 的朋友圈</text><text>{{value.momentsSummary||'已保存的动态、图片线索与人物解读'}}</text><text wx:if="{{value.momentsTotal!==null}}" class="muted">{{value.momentsTotal}} 条已保存动态</text><button class="disclosure" data-detail="moments" bindtap="detail">查看动态统计、图片与推测 →</button></view>
 <view class="tabs"><button class="{{tab==='now'?'active':''}}" data-tab="now" bindtap="tab">看清现状</button><button class="{{tab==='change'?'active':''}}" data-tab="change" bindtap="tab">看见变化</button><button class="{{tab==='next'?'active':''}}" data-tab="next" bindtap="tab">下一步</button></view>
 <block wx:if="{{tab==='now'}}">
  <view class="subtabs"><button class="{{detail==='interaction'?'active':''}}" data-detail="interaction" bindtap="detail">互动</button><button class="{{detail==='profile'?'active':''}}" data-detail="profile" bindtap="detail">人物</button><button class="{{detail==='moments'?'active':''}}" data-detail="moments" bindtap="detail">朋友圈</button><button wx:if="{{value.recent}}" class="{{detail==='recent'?'active':''}}" data-detail="recent" bindtap="detail">最近逐句</button></view>
  <block wx:if="{{detail==='interaction'}}">
   <view wx:if="{{value.score!==null||value.signals.length}}" class="panel"><text class="heading">{{value.other}} 对你的好感与互动信号</text><text wx:if="{{value.score!==null}}" class="score">{{value.score}} / 100</text><text wx:else class="note">{{value.scoreReason||'现有资料不足以给出总分。'}}</text><text class="muted">依据互动证据，不是喜欢你的概率。</text><view wx:for="{{value.dimensions}}" wx:key="key" class="chart"><view class="row"><text>{{item.label}}</text><text>{{item.value===null?'待验证':item.value}}</text></view><view wx:if="{{item.value!==null}}" class="track"><view class="other" style="width:{{item.value}}%"/></view><text class="note">{{item.reason}}</text></view></view>
   <view wx:for="{{value.signals}}" wx:key="signal" class="finding"><text class="muted">{{item.directionLabel}} · {{value.other}} → 你</text><text class="heading">{{item.signal}}</text><text>{{item.meaning}}</text><text wx:if="{{item.alternative}}" class="note">其他解释：{{item.alternative}}</text><button class="disclosure" data-key="signal{{index}}" bindtap="toggle">{{expanded['signal'+index]?'收起':'查看原话依据'}}</button><template wx:if="{{expanded['signal'+index]}}" is="quotes" data="{{quotes:item.evidence}}"/></view>
   <view class="panel"><text class="heading">为什么这样判断</text><text>{{value.explanation}}</text><view wx:for="{{value.findings}}" wx:key="id" class="finding"><text class="muted">{{item.who}}</text><text>{{item.claim}}</text><button class="disclosure" data-key="finding{{index}}" bindtap="toggle">{{expanded['finding'+index]?'收起依据':'原话与其他可能'}}</button><block wx:if="{{expanded['finding'+index]}}"><text class="note">{{item.alternative}}</text><view wx:for="{{item.evidence}}" wx:for-item="source" wx:key="sourceId" class="quote"><text class="muted">{{source.who}} · {{source.kindLabel}} · {{source.at}}</text><text selectable>{{source.quote}}</text><button wx:if="{{source.libraryId}}" class="disclosure" data-library="{{source.libraryId}}" data-source="{{source.sourceId}}" bindtap="source">回到原始资料 →</button></view></block></view></view>
   <view wx:if="{{value.riskSummary||value.risks.length}}" class="panel"><text class="heading">需要核实的风险</text><text>{{value.riskSummary}}</text><view wx:for="{{value.risks}}" wx:key="id" class="finding"><text class="heading">{{item.title}}</text><text>{{item.meaning}}</text><text class="note">{{item.resolution.reading}}</text><text>{{item.verify.action}}</text><text selectable>{{item.verify.question}}</text><button class="disclosure" data-key="risk{{index}}" bindtap="toggle">查看依据与其他解释</button><block wx:if="{{expanded['risk'+index]}}"><text class="note">{{item.alternative}}</text><template is="quotes" data="{{quotes:item.evidence}}"/></block></view></view>
   <risk-review wx:if="{{!value.risks.length}}" value="{{value.riskReview}}"/>
  </block>
  <block wx:elif="{{detail==='profile'}}"><view wx:for="{{value.profiles}}" wx:key="dimension" class="finding"><text class="muted">{{item.who}}</text><text class="heading">{{item.dimension}}</text><text>{{item.reading}}</text><text class="note">{{item.alternative}}</text><button class="disclosure" data-key="profile{{index}}" bindtap="toggle">查看依据</button><template wx:if="{{expanded['profile'+index]}}" is="quotes" data="{{quotes:item.evidence}}"/></view><personal-connection value="{{value.personalConnection}}"/></block>
  <block wx:elif="{{detail==='recent'}}"><text class="heading">最近原话 · 意图与情绪</text><text class="note">{{value.recent.windowLabel}}</text><text class="muted">权重表示这句话的解释倾向，不是好感概率。整体判断仍基于全部已导入资料。</text><view wx:for="{{value.recent.lines}}" wx:key="id" class="recent-line"><text class="muted">{{item.who}} · {{item.at}}</text><text selectable class="quote">{{item.text}}</text><signal-tags title="语气与情绪" tags="{{item.emotionTags}}"/><signal-tags title="可能的意思" tags="{{item.intentTags}}" note="{{item.note}}"/><button wx:if="{{item.libraryId}}" class="disclosure" data-library="{{item.libraryId}}" data-source="{{item.sourceId}}" bindtap="source">回到这句原话 →</button></view></block>
  <block wx:else>
   <text class="heading">{{value.other}} 的朋友圈与图片</text><text>{{value.momentsSummary||'这份报告尚未保存朋友圈的独立分析。'}}</text>
   <view wx:if="{{value.momentsStatistics}}" class="panel moments-statistics"><text class="heading">这批动态的真实分布</text><text wx:if="{{value.momentsStatistics.startDate&&value.momentsStatistics.endDate}}" class="muted">{{value.momentsStatistics.startDate}} — {{value.momentsStatistics.endDate}}</text><view class="stat-grid"><view><text class="stat-number">{{value.momentsStatistics.total}}</text><text>已保存动态</text></view><view><text class="stat-number">{{value.momentsStatistics.withText===null?'未记录':value.momentsStatistics.withText}}</text><text>有可读配文</text></view><view><text class="stat-number">{{value.momentsStatistics.previewsAvailable===null?'未记录':value.momentsStatistics.previewsAvailable}}</text><text>已同步预览</text></view><view><text class="stat-number">{{value.momentsStatistics.pinnedCount===null?'未记录':value.momentsStatistics.pinnedCount}}</text><text>明确置顶</text></view></view><text class="note">预览画面不等于原照片数量；封面与签名不计入动态。</text><view wx:for="{{value.momentsStatistics.months}}" wx:key="month" class="month"><button class="month-button" data-key="month{{index}}" bindtap="toggle"><view class="row"><text>{{item.month}}</text><text>{{item.count}} 条</text></view><view class="track"><view class="other" style="width:{{item.width}}%"/></view></button><view wx:if="{{expanded['month'+index]}}"><button wx:for="{{item.sourceRefs}}" wx:for-item="ref" wx:key="sourceId" class="disclosure" data-library="{{ref.libraryId}}" data-source="{{ref.sourceId}}" bindtap="source">查看这个月的原始动态 →</button></view></view><text wx:if="{{!value.momentsStatistics.months.length}}" class="note">没有明确的完整日期，暂不绘制发布趋势。</text><text wx:if="{{value.momentsStatistics.undated}}" class="note">{{value.momentsStatistics.undated}} 条日期不完整，未计入月份。</text><button class="disclosure" data-key="statScope" bindtap="toggle">统计范围</button><text wx:if="{{expanded.statScope}}" class="note">{{value.momentsStatistics.scope}}</text></view>
   <view wx:elif="{{value.legacyStatistics}}" class="panel"><text class="heading">原报告中的截图统计</text><text class="note">仅代表原截图里的可见动态，不代表全部历史。</text><view wx:for="{{value.legacyGroups}}" wx:for-item="group" wx:key="title"><text class="heading">{{group.title}}</text><view wx:for="{{group.rows}}" wx:key="label" class="chart"><view class="row"><text>{{item.label}}</text><text>{{item.count}} 条</text></view><view wx:if="{{item.width!==null}}" class="track"><view class="other" style="width:{{item.width}}%"/></view></view></view><text class="note">{{value.legacyStatistics.scope}}</text></view>
   <text wx:else class="note">这份旧报告未保存完整动态统计；下面保留已有解读和依据。</text>
   <view wx:for="{{value.moments}}" wx:key="id" class="finding"><view class="inference"><text class="muted">由材料推测</text><text>{{item.claim}}</text></view><template is="quotes" data="{{quotes:item.evidence}}"/><view wx:if="{{item.alternative}}" class="alternative"><text class="muted">另一种解释</text><text>{{item.alternative}}</text></view></view>
   <view wx:if="{{value.crossSource}}" class="panel"><text class="heading">放回聊天一起看</text><text>{{value.crossSource}}</text><template is="quotes" data="{{quotes:value.crossEvidence}}"/></view>
   <view wx:if="{{value.visuals.length}}" class="panel"><text class="heading">图片里实际看到了什么</text><text class="note">保留已同步画面的观察，和人物推测分开看。</text><view wx:for="{{value.visuals}}" wx:key="mediaId" class="visual-observation"><text class="muted">{{item.kindLabel}} · {{item.at}}</text><text>{{item.observation}}</text><button class="disclosure" data-library="{{item.libraryId}}" data-source="{{item.sourceId}}" bindtap="source">查看图片来源 →</button></view></view>
   <view wx:if="{{value.profileMaterials.length}}" class="panel"><text class="heading">封面与个性签名</text><view wx:for="{{value.profileMaterials}}" wx:key="sourceId" class="quote"><text class="muted">{{item.kindLabel}}</text><text>{{item.materialRole==='profile-signature'?item.text:item.observation||'封面来源已保留，尚未完成画面解读。'}}</text><button class="disclosure" data-library="{{item.libraryId}}" data-source="{{item.sourceId}}" bindtap="source">查看原始资料 →</button></view></view>
   <text wx:for="{{value.momentsUnknowns}}" wx:key="*this" class="note">仍需核实：{{item}}</text>
  </block>
 </block>
 <block wx:elif="{{tab==='change'}}">
  <view wx:if="{{value.activity}}" class="panel"><text class="heading">全部聊天的真实互动</text><view class="row"><text>你 {{value.activity.self}} 条</text><text>{{value.other}} {{value.activity.other}} 条</text></view><text class="muted">{{value.activity.startDate}} — {{value.activity.endDate}} · 活跃 {{value.activity.activeDays}} 天</text><text class="muted">浅色为你，绿色为 {{value.other}} · 每月消息数</text><view><view wx:for="{{value.activity.months}}" wx:key="date" class="month"><view class="row"><text>{{item.date}}</text><text>{{item.self}} / {{item.other}}</text></view><view class="track"><view class="self" style="width:{{item.selfWidth}}%"/><view class="other" style="width:{{item.otherWidth}}%"/></view></view></view><text class="note">主动开场：你 {{value.activity.starts.self}} 次，{{value.other}} {{value.activity.starts.other}} 次</text><text class="note">未转写语音 {{value.activity.unreadVoices}} 条，其内容不计入语义判断。</text></view>
  <view wx:for="{{value.changes}}" wx:key="title" class="finding"><text class="muted">{{item.who}}</text><text class="heading">{{item.title}}</text><view class="quote"><text>{{item.before.at}} · {{item.before.reading}}</text><text>{{item.after.at}} · {{item.after.reading}}</text></view><text>{{item.meaning}}</text><text class="note">{{item.alternative}}</text><button class="disclosure" data-key="change{{index}}" bindtap="toggle">核对前后原话</button><template wx:if="{{expanded['change'+index]}}" is="quotes" data="{{quotes:item.evidence}}"/></view>
  <view wx:for="{{value.timeline}}" wx:key="at" class="quote"><text class="muted">{{item.at}}</text><text>{{item.note}}</text></view><text wx:if="{{!value.changes.length&&!value.timeline.length}}" class="note">这份报告没有足够的前后对照证据，暂不判断升温或降温。</text>
 </block>
 <block wx:else><view class="action"><text class="heading">你接下来可以这样做</text><text>{{value.action}}</text><text class="note">{{value.observe}}</text><text class="note">{{value.stop}}</text></view><view wx:for="{{value.steps}}" wx:key="title" class="finding"><text class="heading">{{index+1}} · {{item.title}}</text><text>{{item.action}}</text><text class="note">{{item.why}}</text><view wx:if="{{item.reply}}" class="quote"><text selectable>{{item.reply}}</text><button class="disclosure" data-text="{{item.reply}}" bindtap="copy">复制这句话</button></view><text wx:if="{{item.observeFor}}">观察：{{item.observeFor}}</text><text wx:if="{{item.advanceWhen}}">继续的条件：{{item.advanceWhen}}</text><text wx:if="{{item.stopWhen}}">停下的条件：{{item.stopWhen}}</text><button class="disclosure" data-key="step{{index}}" bindtap="toggle">查看这条建议的依据</button><template wx:if="{{expanded['step'+index]}}" is="quotes" data="{{quotes:item.evidence}}"/></view></block>
 <button class="primary" bindtap="ask">基于全部资料继续问成子</button><button class="disclosure" data-key="coverage" bindtap="toggle">材料覆盖与尚未确认的信息</button><view wx:if="{{expanded.coverage}}"><text class="note">{{value.mediaNote}}</text><text class="note">{{value.coverage.limitation}}</text><text wx:for="{{value.unknowns}}" wx:key="*this" class="note">{{item}}</text></view>
</view>
