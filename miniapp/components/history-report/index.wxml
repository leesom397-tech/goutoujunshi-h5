<template name="evidence"><view wx:for="{{findings}}" wx:key="id"><view wx:for="{{item.evidence}}" wx:for-item="source" wx:key="sourceId" class="quote"><text class="muted">{{source.who}} · {{source.kindLabel}} · {{source.at}}</text><text selectable>{{source.quote}}</text><button wx:if="{{source.libraryId}}" class="disclosure" data-library="{{source.libraryId}}" data-source="{{source.sourceId}}" bindtap="source">回到原始资料 →</button></view></view></template>
<template name="quotes"><view wx:for="{{quotes}}" wx:for-item="source" wx:key="sourceId" class="quote"><text class="muted">{{source.who}} · {{source.kindLabel}} · {{source.at}}</text><text selectable>{{source.quote}}</text><button wx:if="{{source.libraryId}}" class="disclosure" data-library="{{source.libraryId}}" data-source="{{source.sourceId}}" bindtap="source">回到原始资料 →</button></view></template>
<view wx:if="{{value}}" class="history">
 <view class="hero"><text class="eyebrow">你与 {{value.other}} · 完整关系报告</text><text class="title">{{value.summary}}</text><text>{{value.trend}}</text><text class="muted">已导入 {{value.coverage.totalImported}} 条 · 已核对 {{value.coverage.analyzedText}} 条可读文字</text></view>
 <view class="tabs"><button class="{{tab==='now'?'active':''}}" data-tab="now" bindtap="tab">看清现状</button><button class="{{tab==='change'?'active':''}}" data-tab="change" bindtap="tab">看见变化</button><button class="{{tab==='next'?'active':''}}" data-tab="next" bindtap="tab">下一步</button></view>
 <block wx:if="{{tab==='now'}}">
  <view class="subtabs"><button class="{{detail==='interaction'?'active':''}}" data-detail="interaction" bindtap="detail">互动</button><button class="{{detail==='profile'?'active':''}}" data-detail="profile" bindtap="detail">人物</button><button class="{{detail==='moments'?'active':''}}" data-detail="moments" bindtap="detail">朋友圈</button></view>
  <block wx:if="{{detail==='interaction'}}">
   <view wx:if="{{value.score!==null||value.signals.length}}" class="panel"><text class="heading">{{value.other}} 对你的好感与互动信号</text><text wx:if="{{value.score!==null}}" class="score">{{value.score}} / 100</text><text wx:else class="note">{{value.scoreReason||'现有资料不足以给出总分。'}}</text><text class="muted">依据互动证据，不是喜欢你的概率。</text><view wx:for="{{value.dimensions}}" wx:key="key" class="chart"><view class="row"><text>{{item.label}}</text><text>{{item.value===null?'待验证':item.value}}</text></view><view wx:if="{{item.value!==null}}" class="track"><view class="other" style="width:{{item.value}}%"/></view><text class="note">{{item.reason}}</text></view></view>
   <view wx:for="{{value.signals}}" wx:key="signal" class="finding"><text class="muted">{{item.directionLabel}} · {{value.other}} → 你</text><text class="heading">{{item.signal}}</text><text>{{item.meaning}}</text><text wx:if="{{item.alternative}}" class="note">其他解释：{{item.alternative}}</text><button class="disclosure" data-key="signal{{index}}" bindtap="toggle">{{expanded['signal'+index]?'收起':'查看原话依据'}}</button><template wx:if="{{expanded['signal'+index]}}" is="quotes" data="{{quotes:item.evidence}}"/></view>
   <view class="panel"><text class="heading">为什么这样判断</text><text>{{value.explanation}}</text><view wx:for="{{value.findings}}" wx:key="id" class="finding"><text class="muted">{{item.who}}</text><text>{{item.claim}}</text><button class="disclosure" data-key="finding{{index}}" bindtap="toggle">{{expanded['finding'+index]?'收起依据':'原话与其他可能'}}</button><block wx:if="{{expanded['finding'+index]}}"><text class="note">{{item.alternative}}</text><view wx:for="{{item.evidence}}" wx:for-item="source" wx:key="sourceId" class="quote"><text class="muted">{{source.who}} · {{source.kindLabel}} · {{source.at}}</text><text selectable>{{source.quote}}</text><button wx:if="{{source.libraryId}}" class="disclosure" data-library="{{source.libraryId}}" data-source="{{source.sourceId}}" bindtap="source">回到原始资料 →</button></view></block></view></view>
   <view wx:if="{{value.riskSummary||value.risks.length}}" class="panel"><text class="heading">需要核实的风险</text><text>{{value.riskSummary}}</text><view wx:for="{{value.risks}}" wx:key="id" class="finding"><text class="heading">{{item.title}}</text><text>{{item.meaning}}</text><text class="note">{{item.resolution.reading}}</text><text>{{item.verify.action}}</text><text selectable>{{item.verify.question}}</text><button class="disclosure" data-key="risk{{index}}" bindtap="toggle">查看依据与其他解释</button><block wx:if="{{expanded['risk'+index]}}"><text class="note">{{item.alternative}}</text><template is="quotes" data="{{quotes:item.evidence}}"/></block></view></view>
   <risk-review wx:if="{{!value.risks.length}}" value="{{value.riskReview}}"/>
  </block>
  <block wx:elif="{{detail==='profile'}}"><view wx:for="{{value.profiles}}" wx:key="dimension" class="finding"><text class="muted">{{item.who}}</text><text class="heading">{{item.dimension}}</text><text>{{item.reading}}</text><text class="note">{{item.alternative}}</text><button class="disclosure" data-key="profile{{index}}" bindtap="toggle">查看依据</button><template wx:if="{{expanded['profile'+index]}}" is="quotes" data="{{quotes:item.evidence}}"/></view><personal-connection value="{{value.personalConnection}}"/></block>
  <block wx:else><text class="heading">{{value.other}} 的朋友圈</text><text>{{value.momentsSummary||'这份报告尚未保存朋友圈的独立分析。'}}</text><text class="note">{{value.crossSource}}</text><view wx:for="{{value.moments}}" wx:key="id" class="finding"><text>{{item.claim}}</text><text class="note">{{item.alternative}}</text><view wx:for="{{item.evidence}}" wx:for-item="source" wx:key="sourceId" class="quote"><text class="muted">{{source.who}} · {{source.at}}</text><text selectable>{{source.quote}}</text></view></view><view wx:for="{{value.profileMaterials}}" wx:key="sourceId" class="quote"><text class="muted">{{item.materialRole==='profile-signature'?'个性签名':'封面线索'}}</text><text>{{item.text}}</text></view></block>
 </block>
 <block wx:elif="{{tab==='change'}}">
  <view wx:if="{{value.activity}}" class="panel"><text class="heading">全部聊天的真实互动</text><view class="row"><text>你 {{value.activity.self}} 条</text><text>{{value.other}} {{value.activity.other}} 条</text></view><text class="muted">{{value.activity.startDate}} — {{value.activity.endDate}} · 活跃 {{value.activity.activeDays}} 天</text><text class="muted">浅色为你，绿色为 {{value.other}} · 每月消息数</text><scroll-view scroll-y style="max-height:500rpx"><view wx:for="{{value.activity.months}}" wx:key="date" class="month"><view class="row"><text>{{item.date}}</text><text>{{item.self}} / {{item.other}}</text></view><view class="track"><view class="self" style="width:{{item.selfWidth}}%"/><view class="other" style="width:{{item.otherWidth}}%"/></view></view></scroll-view><text class="note">主动开场：你 {{value.activity.starts.self}} 次，{{value.other}} {{value.activity.starts.other}} 次</text><text class="note">未转写语音 {{value.activity.unreadVoices}} 条，其内容不计入语义判断。</text></view>
  <view wx:for="{{value.changes}}" wx:key="title" class="finding"><text class="muted">{{item.who}}</text><text class="heading">{{item.title}}</text><view class="quote"><text>{{item.before.at}} · {{item.before.reading}}</text><text>{{item.after.at}} · {{item.after.reading}}</text></view><text>{{item.meaning}}</text><text class="note">{{item.alternative}}</text><button class="disclosure" data-key="change{{index}}" bindtap="toggle">核对前后原话</button><template wx:if="{{expanded['change'+index]}}" is="quotes" data="{{quotes:item.evidence}}"/></view>
  <view wx:for="{{value.timeline}}" wx:key="at" class="quote"><text class="muted">{{item.at}}</text><text>{{item.note}}</text></view><text wx:if="{{!value.changes.length&&!value.timeline.length}}" class="note">这份报告没有足够的前后对照证据，暂不判断升温或降温。</text>
 </block>
 <block wx:else><view class="action"><text class="heading">你接下来可以这样做</text><text>{{value.action}}</text><text class="note">{{value.observe}}</text><text class="note">{{value.stop}}</text></view><view wx:for="{{value.steps}}" wx:key="title" class="finding"><text class="heading">{{index+1}} · {{item.title}}</text><text>{{item.action}}</text><text class="note">{{item.why}}</text><view wx:if="{{item.reply}}" class="quote"><text selectable>{{item.reply}}</text><button class="disclosure" data-text="{{item.reply}}" bindtap="copy">复制这句话</button></view><text wx:if="{{item.observeFor}}">观察：{{item.observeFor}}</text><text wx:if="{{item.advanceWhen}}">继续的条件：{{item.advanceWhen}}</text><text wx:if="{{item.stopWhen}}">停下的条件：{{item.stopWhen}}</text><button class="disclosure" data-key="step{{index}}" bindtap="toggle">查看这条建议的依据</button><template wx:if="{{expanded['step'+index]}}" is="quotes" data="{{quotes:item.evidence}}"/></view></block>
 <button class="primary" bindtap="ask">基于全部资料继续问成子</button><button class="disclosure" data-key="coverage" bindtap="toggle">材料覆盖与尚未确认的信息</button><view wx:if="{{expanded.coverage}}"><text class="note">{{value.mediaNote}}</text><text class="note">{{value.coverage.limitation}}</text><text wx:for="{{value.unknowns}}" wx:key="*this" class="note">{{item}}</text></view>
</view>
