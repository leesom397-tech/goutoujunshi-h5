.quick-self{padding:30rpx;background:#fffaf5;border:1rpx solid #ead9cb;border-radius:24rpx;color:#302821;margin-top:24rpx}.eyebrow,.title,.muted,.label,.note{display:block}.eyebrow{color:#986448;font-size:25rpx}.title{font-size:36rpx;font-weight:750;margin:12rpx 0}.muted{font-size:27rpx;line-height:1.6;color:#75665b;margin:12rpx 0}.group{margin-top:25rpx}.label{font-size:29rpx;font-weight:650;margin-bottom:12rpx}.tags{display:flex;flex-wrap:wrap;gap:14rpx}.tag{font-size:28rpx;padding:12rpx 22rpx;line-height:1.6;margin:0;background:#fff;color:#6d5444;border:1rpx solid #dfc9b9;border-radius:18rpx}.tag::after,.primary::after{border:0}.tag.selected{background:#f5dfcf;color:#793f2c;border-color:#b9694d}textarea{box-sizing:border-box;width:100%;padding:22rpx;border:1rpx solid #dfcfc2;border-radius:16rpx;background:#fff;font-size:29rpx;line-height:1.7;min-height:180rpx;margin-top:22rpx}.primary{margin-top:24rpx;background:#ae624a;color:#fff;font-size:29rpx;padding:18rpx;line-height:1.6;border-radius:16rpx}.note{font-size:28rpx;line-height:1.6;margin-top:24rpx;color:#76513d}.preview{border-top:1rpx solid #e7d3c4;margin-top:24rpx;padding-top:20rpx}.field{margin-bottom:25rpx}.field textarea{min-height:85rpx;margin-top:8rpx}
