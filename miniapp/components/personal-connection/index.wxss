:host{display:block;min-width:0}.connection{box-sizing:border-box;margin:28rpx 0;padding:30rpx 26rpx;border:1rpx solid #cbded3;border-top:6rpx solid #337d72;border-radius:24rpx;background:#f7faf5;color:#302821;font-family:"PingFang SC","Microsoft YaHei",sans-serif;overflow-wrap:break-word}.eyebrow{display:flex;align-items:center;gap:12rpx;color:#337d72;font-size:28rpx;font-weight:650}.eyebrow image{width:32rpx;height:32rpx}.title{display:block;font-size:38rpx;line-height:1.5;font-weight:700;margin:18rpx 0}.summary{display:block;color:#596457;font-size:30rpx;line-height:1.8}.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin:26rpx 0}.chips text{padding:12rpx 18rpx;border:1rpx solid #b8d0c0;border-radius:12rpx;background:#edf5e9;color:#315e4f;font-size:28rpx}.personal-item{margin-top:22rpx;padding:26rpx 22rpx;border:1rpx solid #dce3d6;border-radius:18rpx;background:#fffefa}.item-heading{display:flex;align-items:flex-start;gap:12rpx;flex-wrap:wrap}.item-title{font-size:32rpx;line-height:1.6;font-weight:650}.badge{padding:5rpx 10rpx;border-radius:7rpx;background:#edf4e9;color:#4e7460;font-size:25rpx;line-height:1.6}.reading{display:block;font-size:30rpx;line-height:1.85;margin:15rpx 0}.sources{margin-top:24rpx;padding-top:8rpx;border-top:1rpx solid #e2e6da}.source{margin-top:18rpx;padding-left:17rpx;border-left:3rpx solid #acc8b4}.source.other{border-color:#d1ac89}.who{display:block;color:#465c4f;font-size:27rpx;font-weight:650;line-height:1.8}.source.other .who{color:#835a3b}.source-label{font-size:25rpx;color:#766b5e;font-weight:400}.quote{display:block;color:#655b4e;font-size:28rpx;line-height:1.85;margin-top:6rpx}.action{display:flex;flex-direction:column;gap:8rpx;margin-top:24rpx;padding:20rpx;border-radius:13rpx;background:#eef4e9;color:#365544;font-size:30rpx;line-height:1.8}.action-label{font-size:27rpx;font-weight:650}.alternative{display:block;margin-top:20rpx;color:#796c58;font-size:27rpx;line-height:1.85}.group{border-top:1rpx solid #dce4d5;margin-top:30rpx;padding-top:26rpx}.group-title{display:block;font-size:33rpx;font-weight:650;line-height:1.6}.group-note{display:block;margin-top:8rpx;font-size:27rpx;color:#746c5e}.topic .badge,.difference .badge{background:#f7eedc;color:#8b672c}.difference{border-color:#e6d7b9;background:#fffaf1}.empty{margin-top:20rpx}
