.signals{font-family:"PingFang SC","Microsoft YaHei",sans-serif;margin-top:18rpx}.heading{display:flex;align-items:center;gap:10rpx;color:#203249;font-size:24rpx;font-weight:650}.heading image{width:26rpx;height:26rpx}.weight-label{margin-left:auto;font-size:24rpx;color:#176b89;font-weight:400}.signal{padding:12rpx 16rpx;margin-top:10rpx;border-radius:10rpx;background:#fff7e8;color:#79572e}.signal-label{display:flex;justify-content:space-between;gap:16rpx;font-size:24rpx}.track{height:8rpx;margin-top:10rpx;background:#e9e0ce;border-radius:8rpx;overflow:hidden}.bar{height:100%;background:#b78a48}.positive{background:#e9f5f9;color:#526579}.positive .bar{background:#347f99}.caution{background:#f8ece8;color:#a54c3f}.caution .bar{background:#a54c3f}.details{width:100%;margin:14rpx 0 0;text-align:left;background:#e9f5f9;color:#376b82;padding:15rpx 18rpx;min-height:80rpx;font-size:24rpx;line-height:1.8;border:1rpx solid #bfd8e4;border-radius:10rpx}.details::after{border:0}.note{display:block;margin-top:14rpx;line-height:1.7;font-size:24rpx;color:#176b89}


/* Readable daylight type: distinct headings, body, and supporting text. */
.heading{font-size:26rpx;line-height:1.6;color:#29485f;font-weight:600;flex-wrap:wrap}.weight-label{font-size:24rpx;color:#526579}.signal-label{font-size:26rpx;line-height:1.75}.signal{color:#79572e}.positive{color:#155e7a}.caution{color:#98472f}.details{font-size:26rpx;line-height:1.7;color:#244f67}.note{font-size:25rpx;color:#526579;line-height:1.8}

/* Final shared phone contrast layer. */
@import "../../styles/phone-contrast.wxss";
