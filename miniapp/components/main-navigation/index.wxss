.navigation-space{height:calc(120rpx + env(safe-area-inset-bottom))}
.main-navigation{position:fixed;z-index:100;bottom:0;left:0;right:0;display:flex;justify-content:space-around;gap:8rpx;padding:14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));border-top:1rpx solid #b4d1de9c;background:#fafdfff2;backdrop-filter:blur(24px);box-shadow:0 -8rpx 32rpx #5679900c;font-family:"PingFang SC","Microsoft YaHei",sans-serif}
.nav-item{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9rpx;flex:1;min-width:0;min-height:82rpx;margin:0;padding:10rpx 5rpx;box-sizing:border-box;border:0;border-radius:16rpx;background:transparent;color:#176b89;font-size:23rpx;line-height:1.3;font-weight:500}.nav-item::after{border:0}.nav-item image{width:36rpx;height:36rpx;flex:none;opacity:.66}.nav-item.active{background:#dceff68c;color:#25728e}.nav-item.active image{opacity:1}.nav-item.active::before{content:"";position:absolute;top:-16rpx;width:30rpx;height:4rpx;border-radius:4rpx;background:#64b7d0;box-shadow:0 0 10rpx #7dd9eb66}.nav-item.button-hover{background:#e5f2f9;opacity:.85}

/* Readable daylight type: distinct headings, body, and supporting text. */
.nav-item{font-size:24rpx;line-height:1.4;color:#425a6f;font-weight:500;gap:8rpx;min-height:88rpx}.nav-item.active{color:#155e7a;font-weight:650}.nav-item image{opacity:.9}

/* Final shared phone contrast layer. */
@import "../../styles/phone-contrast.wxss";
