page{background:#f7f3ec;color:#3c342f;font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}
button::after{border:0}button,input,textarea{font-family:inherit}button[disabled]{opacity:.48}
.photo-clues{margin:24rpx 0;padding:26rpx;background:#f0f8fc;border:1rpx solid #c7dde8;border-left:5rpx solid #6baec5;border-radius:18rpx;color:#203249}
.photo-clues-heading{display:flex;align-items:center;gap:12rpx;font-size:30rpx;font-weight:600}.photo-clues-heading image{width:32rpx;height:32rpx}.photo-clue{padding:20rpx 0;border-bottom:1rpx solid #d6e5ed}.photo-clue:last-child{border-bottom:0;padding-bottom:0}.photo-clue text{display:block;margin:10rpx 0;font-size:26rpx;line-height:1.7}.photo-clue .photo-clue-location{font-size:24rpx;color:#176b89}.photo-clue-observation{color:#526579}.photo-clue-inference{color:#79572e;font-weight:600}.photo-clue-alternative{color:#176b89}
.screen button.disclosure-button,.screen button.reply-more,.screen button.hypothesis-evidence-toggle,.screen button.feedback-source-toggle{min-height:88rpx;box-sizing:border-box;padding:18rpx 22rpx;border:1rpx solid #bfd6e3;border-radius:16rpx;background:#ffffffcc;color:#376a83;font-size:25rpx;font-weight:600;line-height:1.6;box-shadow:inset 0 2rpx #fff}
.screen button.button-hover{opacity:.82;transform:translateY(2rpx)}.screen button[disabled]{opacity:.48;transform:none;box-shadow:none}.screen .detail-navigation button,.screen .archive-tabs button{min-height:88rpx;border:1rpx solid #c4dbe7;border-radius:16rpx;background:#ffffffad;color:#176b89}.screen .detail-navigation button.active,.screen .archive-tabs button.active{border-color:#90c4d6;background:#dfF1f8;color:#286c87}

/* Readable daylight type: distinct headings, body, and supporting text. */
page{font-size:28rpx;line-height:1.75;color:#203249}
.screen,.chat-screen,.account-screen{font-size:28rpx;line-height:1.75}
.input-placeholder,.textarea-placeholder{color:#526579}
.screen button.disclosure-button,.screen button.reply-more,.screen button.hypothesis-evidence-toggle,.screen button.feedback-source-toggle{font-size:26rpx;line-height:1.65;color:#244f67;font-weight:550}
.screen .detail-navigation button,.screen .archive-tabs button{color:#425a6f;font-size:26rpx;line-height:1.6}
.screen .detail-navigation button.active,.screen .archive-tabs button.active{color:#155e7a;font-weight:650}
.photo-clue .photo-clue-location{font-size:24rpx;color:#526579}.photo-clue-observation{font-weight:550;color:#244d65}.photo-clue-inference{color:#79572e}.photo-clue-alternative{color:#526579}

/* Disabled controls remain legible while retaining a clearly inactive surface. */
.screen button[disabled],.account-screen button[disabled],.chat-screen button[disabled]{opacity:1;background:#e7edf2;color:#526579;border-color:#cdd8e1;box-shadow:none;transform:none;font-weight:500}

/* Final shared phone contrast layer. */
@import "./styles/phone-contrast.wxss";
@import "./styles/page-scenes.wxss";
