/* Transparent exports of the web SVGs. Header artwork never covers controls. */
.screen .hero.page-scene-hero{padding-right:190rpx}
.screen .hero .glass-stamp.page-scene-stamp{right:0;top:25rpx;width:178rpx;height:150rpx;border:0;border-radius:0;background:transparent;box-shadow:none;transform:none;overflow:visible}
.screen .page-scene-stamp .glass-stamp-art{width:100%;height:100%;opacity:1}
.screen .page-scene-stamp .glass-stamp-symbol,.screen .page-scene-stamp text{display:none}
.screen .page-scene-conversation .page-scene-image{left:auto;right:12rpx;top:50rpx;width:180rpx;height:142rpx;opacity:1;animation:none;transform:none}
.screen .page-scene-conversation .hero-copy{box-sizing:border-box;padding-right:148rpx;min-width:0}
.screen .page-scene-conversation .hero-brand{flex-wrap:wrap}
.screen .page-scene-conversation .title{font-size:40rpx}
.screen .page-scene-archive .archive-scene{left:auto;right:14rpx;top:52rpx;width:190rpx;height:154rpx;opacity:1;animation:none;transform:none}
.screen .page-scene-archive .hero-copy{box-sizing:border-box;padding-right:150rpx;min-width:0}
.screen .page-scene-detail .archive-scene{display:none}
.screen .page-scene-person-new .new-person-scene{left:auto;right:18rpx;top:73rpx;width:184rpx;height:155rpx;opacity:1;animation:none;transform:none}
.screen .page-scene-person-new .new-person-copy{box-sizing:border-box;padding-right:150rpx;min-width:0}
.account-screen .account-heading>.account-page-scene{width:177rpx;height:135rpx;flex-shrink:0;transform:none}
.account-screen .account-heading>view{min-width:0}
@media(max-width:350px){.screen .hero.page-scene-hero{padding-right:175rpx}.screen .hero .glass-stamp.page-scene-stamp{width:163rpx;height:138rpx}.screen .page-scene-conversation .hero-brand{font-size:22rpx}.screen .page-scene-person-new .title{font-size:43rpx}}
