DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Optional: Jev-specific classification. Qwen cannot use this key.
JEV_API_KEY=
JEV_MODEL=jev-latest
# Optional: voice cloned for qwen3.5-omni-flash-realtime in the Beijing region.
QWEN_REALTIME_VOICE=
# Optional: short speaking-style guidance for realtime conversations.
QWEN_REALTIME_STYLE=
# 微信客服后台：微信客服 > 通过 API 管理
WECHAT_CORP_ID=
WECHAT_KF_SECRET=
WECHAT_CALLBACK_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_KF_ID=
# 从微信客服后台取得的会话链接（仅供页面打开，不是密钥）
WECHAT_KF_URL=
# 微信小程序原生截图入口：仅服务器端配置，绝不写入 miniapp/ 客户端。
MINIAPP_APPID=
MINIAPP_APPSECRET=
